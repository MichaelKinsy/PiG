+// pi-durable/storage/sqlite for the PiG core under PiHarness. PiHarness opens its store with
+// `SqliteStorage.open(new DurableObjectSqliteDatabase(ctx.storage, { prefix }))` and builds its table-name Prefixer from
+// `SQLITE_MIGRATIONS`. The PiG core runs synchronous SQL (ABI section 3), so its store runs on the same adapter's
+// synchronous handle (`syncStorage()`, the bench fork of agents/harness/pi in bench/targets.ts): the same Prefixer, the
+// same `ctx.storage`, so PiG's tables are pi_-prefixed exactly as Pi's are.
+// @ts-expect-error resolved by the bench build to the PiG checkout's facade sources
+import { SqlStorage, type StorageProfile } from "pig-facade/storage.ts"
+// @ts-expect-error resolved by the bench build to the PiG checkout's host sources
+import { doStore } from "pig-host/store-do.ts"
+// @ts-expect-error resolved by the bench build to the Pi checkout's sources
+import { SQLITE_MIGRATIONS as PI_MIGRATIONS } from "pi-source/storage/sqlite/migrations.ts"
+
+// The PiG core writes Pi's schema (row identity) and one table of its own; the Prefixer prefixes every name listed here.
+export const SQLITE_MIGRATIONS = [...PI_MIGRATIONS, { version: -1, statements: ["CREATE TABLE IF NOT EXISTS pig_sidecar"] }]
+
+type SyncHandle = { syncStorage(): DurableObjectStorage }
+
+class PiHarnessStorage extends SqlStorage {
+  readonly profile: StorageProfile = "cloudflare-do"
+  constructor(private readonly db: SyncHandle) { super() }
+  protected async openStore() { return { ...doStore(this.db.syncStorage()), close() {} } }
+}
+
+export const SqliteStorage = { open: async (db: SyncHandle) => new PiHarnessStorage(db) }
