+// Pi under the Cloudflare Agents SDK's PiHarness (agents/harness/pi, beta): pi-head's agent, scripted model, and tool,
+// opened by PiHarness over its own Durable Object SQLite adapter (tables prefixed pi_) and driven through its Lifecycle
+// (one wake job per session, a 30 s heartbeat alarm while tasks run). A turn is PiHarness's submit and wait, then the
+// root conversation's waitForIdle, as pi-head's turn. The piharness-pig target is this file on the PiG core.
+import { DurableObject } from "cloudflare:workers"
+import { PiHarness } from "agents/harness/pi"
+import { Lifecycle } from "agents/lifecycle"
+import { BACKGROUND_CONTEXT as context } from "@earendil-works/chord/context"
+import { Type } from "@earendil-works/pi-ai"
+import { createModels } from "@earendil-works/pi-ai/models"
+import { fauxAssistantMessage, fauxProvider, fauxToolCall, type FauxResponseFactory } from "@earendil-works/pi-ai/providers/faux"
+import { createRegistry, defineExtension, defineTool, Harness, ROOT_CONVERSATION_ID, section, type Conversation } from "@earendil-works/pi-durable"
+import { fingerprint, next, payload, type Message, type Turn } from "./plan.ts"
+import { probeSql, take } from "./probe.ts"
+import { serve, tables, type Bench } from "./serve.ts"
+
+declare const BENCH_PROBE: boolean
+
+const SYSTEM = "You are a benchmark agent. Call lookup as instructed, then answer briefly."
+
+const faux = fauxProvider({ models: [{ id: "scripted-1", contextWindow: 1e9 }], tokenSize: { min: 1e9, max: 1e9 } })
+const models = createModels()
+models.setProvider(faux.provider)
+
+type Block = { type: string; text?: string; arguments?: { n?: number } }
+let seen: Message[] = []
+
+const respond: FauxResponseFactory = transcript => {
+  faux.appendResponses([respond])
+  seen = transcript.messages.filter(m => ["user", "assistant", "toolResult"].includes(m.role)).map(m => {
+    const blocks: Block[] = typeof m.content === "string" ? [{ type: "text", text: m.content }] : m.content as Block[]
+    const text = blocks.filter(b => b.type === "text").map(b => b.text).join("")
+    const calls = blocks.filter(b => b.type === "toolCall").map(b => b.arguments!.n!)
+    return { role: m.role === "toolResult" ? "tool" as const : m.role as "user" | "assistant", text, ...(calls.length ? { calls } : {}) }
+  })
+  const step = next(seen)
+  return "call" in step
+    ? fauxAssistantMessage(fauxToolCall("lookup", { n: step.call }, { id: `call-${step.call}` }), { stopReason: "toolUse" })
+    : fauxAssistantMessage(step.answer)
+}
+faux.setResponses([respond])
+
+const lookup = defineTool({
+  name: "lookup",
+  description: "Look up record number n",
+  parameters: Type.Object({ n: Type.Number() }),
+  execute: async ({ n }) => ({ content: [{ type: "text", text: payload(n) }] }),
+})
+
+const registry = createRegistry()
+registry.install(defineExtension({ name: "bench", tools: [lookup], sections: [section("preamble", () => SYSTEM, { tag: false })] }))
+
+export class PiDO extends DurableObject implements Bench {
+  private root?: Conversation
+  readonly harness = new PiHarness({
+    harness: ({ storage, context }) => Harness.open(storage, { models, registry, settings: { compaction: { enabled: false } } }, context),
+    defaults: { model: faux.getModel() },
+  })
+  // RPC bypasses the Lifecycle's fetch and alarm entry points, so every method starts it (one shared startup).
+  readonly lifecycle = Lifecycle.install(this).use(this.harness)
+
+  constructor(ctx: DurableObjectState, env: unknown) {
+    super(ctx, env)
+    if (BENCH_PROBE) probeSql(ctx.storage.sql)
+  }
+
+  async probe() { return take() }
+
+  private async open() {
+    await this.lifecycle.start()
+    if (this.root) return this.root
+    const root = await (await this.harness.pi()).conversation(ROOT_CONVERSATION_ID, context)
+    if (!root) throw new Error("PiHarness opened no root conversation")
+    return this.root = root
+  }
+
+  async wake() { await this.open() }
+
+  async turn({ id, text }: Turn) {
+    const root = await this.open()
+    await this.harness.submit(text, { operationId: id })
+    const settled = await this.harness.wait(id)
+    if (settled.status !== "done") throw new Error(JSON.stringify(settled))
+    await root.waitForIdle(context)
+  }
+
+  async seed(turns: Turn[]) {
+    for (const turn of turns) await this.turn(turn)
+    return fingerprint(seen)
+  }
+
+  // Refuses a store that ran outside the adapter's prefix: every table but the SDK's own (cf_) must be a pi_ table.
+  async stats() {
+    const sql = this.ctx.storage.sql
+    const found = tables(sql)
+    const bare = Object.keys(found).filter(name => !name.startsWith("pi_") && !name.startsWith("cf_"))
+    if (bare.length) throw new Error(`PiHarness store has tables outside the pi_ prefix: ${bare.join(", ")}`)
+    return { bytes: sql.databaseSize, tables: found }
+  }
+}
+
+export default serve<{ PI: DurableObjectNamespace<PiDO> }>((env, object) => env.PI.getByName(object))
