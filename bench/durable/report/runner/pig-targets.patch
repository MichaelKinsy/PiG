@@ -0,0 +1,11 @@
+// PiG Durable targets: durable-bench's pi-head target, unchanged, on the production PiG Durable core. The build aliases
+// @earendil-works/pi-durable to the core's pi-durable-compatible facade (durable/core/host/cf/src/facade) and supplies the
+// compiled core as ./pig-core.wasm (TinyGo or Go build); everything else, the scripted model included, is pi-head.ts.
+import { useCore } from "@earendil-works/pi-durable"
+// @ts-expect-error the bundle supplies the compiled core module
+import core from "./pig-core.wasm"
+
+useCore(core)
+
+export * from "./pi-head.ts"
+export { default } from "./pi-head.ts"
