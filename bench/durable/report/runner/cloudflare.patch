+// The wrangler release that ships the workerd of the pinned miniflare (4.20260730.0).
+const WRANGLER = "wrangler@4.116.0"
+const COMPATIBILITY = { compatibility_date: "2026-07-30", compatibility_flags: ["nodejs_compat"] }
+const BATCH = 50
+// Cold: an object idle longer than this has been evicted (V2: at least 150 s).
+const IDLE_MS = Number(process.env.IDLE_MS ?? 150_000)
+const FLOOR_SAMPLES = 5
+
