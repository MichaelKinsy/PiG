+    rules: [{ type: "CompiledWasm", globs: ["**/*.wasm"], fallthrough: false }],
+    durable_objects: { bindings: Object.entries(TARGETS[name].objects).map(([binding, class_name]) => ({ name: binding, class_name })) },
