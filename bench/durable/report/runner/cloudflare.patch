+    const at = new Date().toISOString()
+    if (PROBE) appendFileSync("results/cloudflare-probe.jsonl", JSON.stringify({ kind: "probe", host: "cloudflare", mode: PROBE, target: name, version: TARGETS[name].version, turns: size, sample, object, open: strip(open), turn: turns.map(strip), at }) + "\n")
+    else appendFileSync("results/cloudflare.jsonl", JSON.stringify({ target: name, version: TARGETS[name].version, turns: size, sample, object, floor, open: open.ms, turn: turns.map((t: { ms: number }) => t.ms), ...stats, at }) + "\n")
+  }
+} else throw new Error("cloud: deploy <target> | run <target> <url> [sizes...]")
+
+type TailEvent = { eventTimestamp?: number; cpuTime?: number; event?: { request?: { url?: string } }; executionModel?: string; entrypoint?: string }
+
+/** `wrangler tail --format json` prints one JSON value per event, possibly over several lines. */
+function parseAll(text: string): TailEvent[] {
+  const out: TailEvent[] = []
+  let depth = 0, start = -1, inString = false, escaped = false
+  for (let i = 0; i < text.length; i++) {
+    const c = text[i]
+    if (inString) { if (escaped) escaped = false; else if (c === "\\") escaped = true; else if (c === "\"") inString = false; continue }
+    if (c === "\"") inString = true
+    else if (c === "{") { if (depth++ === 0) start = i }
+    else if (c === "}" && --depth === 0) out.push(JSON.parse(text.slice(start, i + 1)))
+  }
+  return out
+}
+
+/** CPU ms per request id `r`: the Worker invocation for /wake or /turn plus the Durable Object invocations up to the next Worker invocation. */
+function attribute(events: TailEvent[]): Map<number, number> {
+  const sorted = events.filter(e => typeof e.eventTimestamp === "number").sort((a, b) => a.eventTimestamp! - b.eventTimestamp!)
+  const result = new Map<number, number>()
+  let current: number | undefined
+  for (const e of sorted) {
+    const url = e.event?.request?.url
+    if (url !== undefined && e.executionModel !== "durableObject") {
+      const u = new URL(url)
+      current = u.pathname === "/wake" || u.pathname === "/turn" ? Number(u.searchParams.get("r")) : undefined
+      if (current !== undefined) result.set(current, e.cpuTime ?? NaN)
+    } else if (current !== undefined && e.executionModel === "durableObject") result.set(current, result.get(current)! + (e.cpuTime ?? NaN))
+  }
+  for (const [r, ms] of result) if (!Number.isFinite(ms)) result.delete(r)
+  return result
