+const [command, arg, ...rest] = process.argv.slice(2)
+const name = target(arg)
+if (PROBE && name !== "pi-head" && !TARGETS[name].core) throw new Error("probe: pi-head or a PiG target")
+const worker = `durable-bench-${name}${PROBE ? `-probe-${PROBE}` : ""}`
+mkdirSync("results", { recursive: true })
+
+const sha256 = (file: string) => createHash("sha256").update(readFileSync(file)).digest("hex")
+const NPX = ["--yes", WRANGLER]
+
+if (command === "deploy") {
+  const bundle = await bundleFor(name)
+  const dir = join("dist", "cf", worker)
