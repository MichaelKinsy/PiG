+// The floor: durable-bench's request path (Worker fetch, JSON body, Durable Object call, SQLite-backed object) with no
+// agent behind it. A target's latency net of this floor is what its agent costs.
+import { DurableObject } from "cloudflare:workers"
+import type { Turn } from "./plan.ts"
+import { serve, tables, type Bench } from "./serve.ts"
+
+export class PiDO extends DurableObject implements Bench {
+  async wake() {}
+
+  async turn(_turn: Turn) {}
+
+  async seed(_turns: Turn[]) {
+    return ""
+  }
+
+  async stats() {
+    const sql = this.ctx.storage.sql
+    return { bytes: sql.databaseSize, tables: tables(sql) }
+  }
+}
+
+export default serve<{ PI: DurableObjectNamespace<PiDO> }>((env, object) => env.PI.getByName(object))
