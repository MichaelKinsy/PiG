+// Where-it-runs probe: per request inside the Durable Object, for pi-head and the PiG targets. Run with BENCH_PROBE=count
+// (crossing counts, SQLite rows, CPU, memory) or BENCH_PROBE=time (adds the time spent inside the core's exports; wall
+// time per crossing is a Miniflare measurement, because Cloudflare freezes timers during a request). Appends one line per
+// sample to results/probe.jsonl; results/results.jsonl (the latency runs) is untouched.
+//   BENCH_PROBE=count bun bench/probe.ts <target> [sizes...]
+import { execFileSync } from "node:child_process"
+import { appendFileSync, mkdirSync, readdirSync, readFileSync, rmSync } from "node:fs"
+import { MEASURED_TOOLS, turn } from "../src/plan.ts"
+import { call, MEASURED_TURNS, PROBE, prepare, SIZES, stage, start, target, TARGETS } from "./targets.ts"
+
+if (!PROBE) throw new Error("set BENCH_PROBE=count or BENCH_PROBE=time")
+const name = target(process.argv[2])
+if (name !== "pi-head" && !TARGETS[name].core) throw new Error("probe: pi-head or a PiG target")
+const sizes = process.argv.length > 3 ? process.argv.slice(3).map(Number) : SIZES
+const samples = Number(process.env.SAMPLES ?? 3)
+
+// workerd processes under this one; their threads' schedstat field 1 is the nanoseconds they ran on a CPU.
+function workerd(): number[] {
+  const rows = execFileSync("ps", ["-A", "-o", "pid=,ppid=,comm="], { encoding: "utf8" }).trim().split("\n").map(line => line.trim().split(/\s+/))
+  const tree = new Set([process.pid])
+  for (let grew = true; grew;) {
+    grew = false
+    for (const [pid, ppid] of rows) if (tree.has(Number(ppid)) && !tree.has(Number(pid))) { tree.add(Number(pid)); grew = true }
+  }
+  return rows.filter(([pid, , comm]) => tree.has(Number(pid)) && comm === "workerd").map(([pid]) => Number(pid))
+}
+const cpuNs = (pids: number[]) => pids.reduce((sum, pid) => sum + readdirSync(`/proc/${pid}/task`).reduce((s, task) => {
+  try { return s + Number(readFileSync(`/proc/${pid}/task/${task}/schedstat`, "utf8").split(" ")[0]) } catch { return s }
+}, 0), 0)
+
+type Heap = { usedSize: number; totalSize: number; backingStorageSize: number }
+async function inspector(url: URL) {
+  const list = await (await fetch(`http://${url.host}/json`)).json() as { title: string; webSocketDebuggerUrl: string }[]
+  const user = list.find(t => t.title.startsWith("workerd: worker core:user:"))
+  if (!user) throw new Error(`probe: no user worker among ${list.map(t => t.title).join(", ")}`)
+  const ws = new WebSocket(user.webSocketDebuggerUrl)
+  await new Promise((ok, fail) => { ws.onopen = ok; ws.onerror = fail })
+  let id = 0
+  const send = <T>(method: string) => new Promise<T>(ok => {
+    const want = ++id
+    ws.onmessage = event => { const m = JSON.parse(String(event.data)); if (m.id === want) ok(m.result) }
+    ws.send(JSON.stringify({ id: want, method }))
+  })
+  const heap = () => send<Heap>("Runtime.getHeapUsage")
+  // A full collection, so the reading after it is what the isolate retains (not garbage it has yet to collect).
+  // workerd answers HeapProfiler.takeHeapSnapshot (it collects garbage first) but not collectGarbage; the chunks are dropped.
+  const gc = () => send<unknown>("HeapProfiler.takeHeapSnapshot")
+  return { heap, gc, close: () => ws.close() }
+}
+
+await prepare(name)
+mkdirSync("results", { recursive: true })
+for (const size of sizes) {
+  for (let sample = 0; sample < samples; sample++) {
+    const dir = stage(name, size)
+    const mf = await start(name, dir, { inspector: true })
+    const pids = workerd()
+    const insp = await inspector(new URL(String(await mf.getInspectorURL())))
+    const request = async (path: string, body?: unknown) => {
+      const c0 = cpuNs(pids), t0 = performance.now()
+      await call(mf, path, body)
+      const ms = performance.now() - t0, cpuMs = (cpuNs(pids) - c0) / 1e6
+      const probe = await call<Record<string, number>>(mf, "/probe")
+      const heap = await insp.heap()
+      return { ms, cpuMs, ...probe, heapUsed: heap.usedSize, heapTotal: heap.totalSize, backing: heap.backingStorageSize }
+    }
+    const open = await request("/wake")
+    const turns = []
+    for (let i = 0; i < MEASURED_TURNS; i++) turns.push(await request("/turn", turn(`m${i}`, MEASURED_TOOLS)))
+    // Retained memory, once after the last turn so no request pays for the forced collection.
+    await insp.gc()
+    const after = await insp.heap()
+    const wasmBytes = (await call<Record<string, number>>(mf, "/probe")).wasmBytes
+    const retained = { heapUsed: after.usedSize, heapTotal: after.totalSize, backing: after.backingStorageSize, wasmBytes }
+    insp.close()
+    await mf.dispose()
+    rmSync(dir, { recursive: true, force: true })
+    const line = { kind: "probe", mode: PROBE, target: name, version: TARGETS[name].version, turns: size, sample, open, turn: turns, retained, at: new Date().toISOString() }
+    appendFileSync("results/probe.jsonl", JSON.stringify(line) + "\n")
+    process.stderr.write(`probe ${PROBE} ${name} ${size} #${sample}\n`)
+  }
+}
