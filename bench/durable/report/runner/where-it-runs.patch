+// Where-it-runs probe (the report's "where TinyGo runs" slide): counts what one request costs inside the Durable Object.
+// Every JS<->Wasm boundary crossing (export calls into the core, import calls out of it) is counted; with
+// BENCH_PROBE_TIME set at bundle time, the time spent inside export calls is summed too (performance.now advances inside a
+// request in Miniflare only, at 1 ms resolution, so the sum over a turn's calls is an unbiased estimate; on Cloudflare it is
+// frozen, so time is a Miniflare measurement). hopSteps counts step calls delivering ABI event 18 (hopped): the crossings
+// the hop-chain model adds. SQLite rows read and written
+// are the cursors' counters, the Durable Object's billed storage metric. take() returns the counts since the last take().
+declare const BENCH_PROBE_TIME: boolean
+
+type Counts = { crossings: number; exportCalls: number; importCalls: number; hopSteps: number; coreMs: number; instantiateMs: number; rowsRead: number; rowsWritten: number }
+const zero = (): Counts => ({ crossings: 0, exportCalls: 0, importCalls: 0, hopSteps: 0, coreMs: 0, instantiateMs: 0, rowsRead: 0, rowsWritten: 0 })
+let counts = zero()
+const memories: WebAssembly.Memory[] = []
+let cursors: { rowsRead: number; rowsWritten: number }[] = []
+const timed = typeof BENCH_PROBE_TIME !== "undefined" && BENCH_PROBE_TIME
+let depth = 0
+const HOPPED = 18 // ABI event kind hopped
+
+function wrapImports(imports: WebAssembly.Imports | undefined): WebAssembly.Imports | undefined {
+  if (!imports) return imports
+  return Object.fromEntries(Object.entries(imports).map(([module, fields]) => [module, Object.fromEntries(Object.entries(fields).map(([name, value]) =>
+    [name, typeof value === "function" ? (...args: unknown[]) => { counts.importCalls++; counts.crossings++; return (value as Function)(...args) } : value]))]))
+}
+
+function wrapExports(exports: WebAssembly.Exports): WebAssembly.Exports {
+  const out: Record<string, unknown> = {}
+  for (const [name, value] of Object.entries(exports)) {
+    if (value instanceof WebAssembly.Memory) memories.push(value)
+    out[name] = typeof value !== "function" ? value : (...args: unknown[]) => {
+      counts.exportCalls++
+      counts.crossings++
+      if (name === "step" && args[1] === HOPPED) counts.hopSteps++
+      if (!timed || depth++ > 0) { try { return (value as Function)(...args) } finally { if (timed) depth-- } }
+      const t0 = performance.now()
+      try { return (value as Function)(...args) } finally { counts.coreMs += performance.now() - t0; depth-- }
+    }
+  }
+  return Object.freeze(out) as WebAssembly.Exports
+}
+
+/** Install the Wasm wrapper. Call before the core is instantiated. */
+export function probeWasm() {
+  const Real = WebAssembly.Instance
+  const Instance = function (this: unknown, module: WebAssembly.Module, imports?: WebAssembly.Imports) {
+    const t0 = performance.now()
+    const instance = new Real(module, wrapImports(imports))
+    counts.instantiateMs += performance.now() - t0
+    return { exports: wrapExports(instance.exports) }
+  } as unknown as typeof WebAssembly.Instance
+  Object.defineProperty(WebAssembly, "Instance", { value: Instance, configurable: true, writable: true })
+}
+
+/** Count rows read and written of every statement run through sql. */
+export function probeSql(sql: SqlStorage) {
+  const exec = sql.exec.bind(sql)
+  sql.exec = ((query: string, ...bindings: unknown[]) => {
+    // Statements are consumed before the next one runs, so earlier cursors' counters are final: fold them now.
+    fold()
+    const cursor = exec(query, ...bindings)
+    cursors.push(cursor)
+    return cursor
+  }) as typeof sql.exec
+}
+
+/** The counts since the last take, with the current Wasm linear memory size. */
+function fold() {
+  for (const cursor of cursors) { counts.rowsRead += cursor.rowsRead; counts.rowsWritten += cursor.rowsWritten }
+  cursors = []
+}
+
+export function take() {
+  fold()
+  const out = { ...counts, wasmBytes: memories.reduce((sum, memory) => sum + memory.buffer.byteLength, 0), timed }
+  counts = zero()
+  return out
+}
