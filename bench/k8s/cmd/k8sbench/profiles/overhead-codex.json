{
	"name": "overhead-codex",
	"rule": "overhead-codex",
	"about": "bench/evals' overhead bench (pigbench overhead): what the harness itself costs, against pigbench's local mock model that answers at once. A size is N tool rounds; -turns 8 is the local bench's print-tools. One sample runs each scenario as a fresh process: version, print, print-tools. open and turn[] are print-tools': spawn to the first model request, and the N gaps between a reply's end and the next request (the harness's added time per turn, its tool run included); openCpu/turnCpu[] their CPU, peakRss print-tools' peak RSS. PiG built from the commit against Codex CLI at the version bench/evals/arms.lock pins, configured through its own config.toml to the mock (pigbench.harness). Codex has no Pi RPC mode, and its TUI does not reliably send the scripted prompt to the mock, so the profile leaves out rpc and pty. Needs an agent bundle with the arm (k8sbench bundle -agents -arms codex) or an image built with ARMS=codex.",
	"fingerprints": {
		"8": "4103640c1f34f797"
	},
	"targets": [
		{
			"name": "pig",
			"role": "pig",
			"seed": [
				"{root}/python/bin/python3.12",
				"{root}/pigbench.py",
				"k8s",
				"overhead-seed",
				"--rounds",
				"{turns}",
				"--scenarios",
				"version,print,print-tools",
				"--dir",
				"{dir}"
			],
			"seedMeta": "{dir}/overhead-{turns}.json",
			"sample": [
				"{root}/python/bin/python3.12",
				"{root}/pigbench.py",
				"k8s",
				"overhead-sample",
				"--target",
				"pig",
				"--family",
				"pig",
				"--binary",
				"{root}/bin/pig",
				"--rounds",
				"{turns}",
				"--scenarios",
				"version,print,print-tools",
				"--dir",
				"{dir}",
				"--sample",
				"{sample}"
			]
		},
		{
			"name": "codex",
			"role": "reference",
			"seed": [
				"{root}/python/bin/python3.12",
				"{root}/pigbench.py",
				"k8s",
				"overhead-seed",
				"--rounds",
				"{turns}",
				"--scenarios",
				"version,print,print-tools",
				"--dir",
				"{dir}"
			],
			"seedMeta": "{dir}/overhead-{turns}.json",
			"sample": [
				"{root}/python/bin/python3.12",
				"{root}/pigbench.py",
				"k8s",
				"overhead-sample",
				"--target",
				"codex",
				"--family",
				"codex",
				"--binary",
				"{root}/arms/codex/node_modules/@openai/codex/bin/codex.js",
				"--rounds",
				"{turns}",
				"--scenarios",
				"version,print,print-tools",
				"--dir",
				"{dir}",
				"--sample",
				"{sample}"
			]
		}
	],
	"metrics": [
