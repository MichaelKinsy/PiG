   return url.startsWith("https://") ? url : undefined;
 };
 
+// `ref` is printed inside a shell command, so only PiG's own GitHub release reference grammar passes:
+// github:<owner>/<repo>[/<piglet>]@<semver>. The signer is the key id PiG prints, ed25519: plus 32 hex digits.
+// One owner, repository or Piglet name: the characters PiG accepts (validGitHubPart in coding/piglet/release/pull.go), never `.` or `..`.
+const GITHUB_PART = /^(?!\.\.?$)[A-Za-z0-9._-]+$/;
+const SEMVER = /^(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)(?:-[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?(?:\+[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?$/;
+const RELEASE_REF = /^github:([^/@:\s]+)\/([^/@:\s]+)(?:\/([^/@:\s]+))?@([^@\s]+)$/;
+const SIGNER = /^ed25519:[0-9a-f]{32}$/;
+
+/** `pig.binaries` of a published package.json -> { ref, signer }, or undefined unless both are well formed. */
+export function pigletBinaries(manifest) {
+  const binaries = manifest?.pig?.binaries;
+  if (typeof binaries?.ref !== "string" || typeof binaries?.signer !== "string" || !SIGNER.test(binaries.signer)) return undefined;
+  const match = RELEASE_REF.exec(binaries.ref);
+  if (!match || !SEMVER.test(match[4]) || ![match[1], match[2], match[3] ?? "x"].every((part) => GITHUB_PART.test(part))) return undefined;
+  return { ref: binaries.ref, signer: binaries.signer };
+}
+
+/** Where the registry serves the package.json of one published version. */
+export const manifestURL = (name, version) => `https://registry.npmjs.org/${name.replace("/", "%2F")}/${encodeURIComponent(version)}`;
+
+/**
+ * Adds `binaries` to each Piglet entry whose published package.json records a signed Binary release.
+ * `fetchManifestImpl(name, version)` resolves to the parsed package.json or rejects; a rejection keeps the saved value.
+ */
+export async function addPigletBinaries(entries, { fetchManifestImpl, saved = [], throttleMs = 0, sleep = realSleep, warnings = [] }) {
+  const previous = new Map(saved.map((entry) => [`${entry.name}@${entry.version}`, entry.binaries]));
+  const out = [];
+  for (const [index, entry] of entries.entries()) {
+    if (index > 0 && throttleMs) await sleep(throttleMs);
+    let binaries;
+    try {
+      binaries = pigletBinaries(await fetchManifestImpl(entry.name, entry.version));
+    } catch (error) {
+      binaries = previous.get(`${entry.name}@${entry.version}`);
+      warnings.push(`piglet ${entry.name}@${entry.version}: package.json not read (${error.message})${binaries ? "; keeping the saved Binary release" : ""}`);
+    }
+    out.push(binaries ? { ...entry, binaries } : entry);
+  }
+  return out;
+}
