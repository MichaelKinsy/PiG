  "glossary": {
    "source": "docs/project/CONTEXT.md",
    "site": "glossary.md",
    "bundle": "glossary.md",
    "where": {
      "Pi": [
        "The upstream project. Docs for Pi behavior that PiG keeps cite it.",
        "[Overview](/docs/latest/)"
      ],
      "PiG": [
        "The `pig` executable and every page of this documentation.",
        "[How PiG works](/docs/latest/how-pig-works)"
      ],
      "Stock PiG": [
        "The plain `pig` binary you install. It activates no Piglet by itself.",
        "[PiG concepts](/docs/latest/concepts)"
      ],
      "Resource": [
        "`pig piglet show` lists the Resources a Piglet selects. Packages carry them.",
        "[PiG concepts](/docs/latest/concepts)"
      ],
      "Package": [
        "`pig install` and `pig list`.",
        "[Packages](/docs/latest/packages)"
      ],
      "Plugin": [
        "A package for other agent harnesses that PiG can read.",
        "[Packages](/docs/latest/packages)"
      ],
      "Piglet": [
        "`pig piglet` commands and the `--piglet` flag.",
        "[Piglets](/docs/latest/piglets)"
      ],
      "Piglet release": [
        "The record a Piglet build writes. `pig piglet verify` checks it.",
        "[Piglet lifecycle](/docs/latest/piglet-lifecycle)"
      ],
      "Piglet Binary": [
        "`pig piglet build --format binary` writes one.",
        "[Piglet Binaries](/docs/latest/piglet-binaries)"
      ],
      "PiG Standard": [
        "The curated Piglet that ships in `piglets/standard/`. You select it.",
        "[Piglets](/docs/latest/piglets)"
      ],
      "Pig Porter": [
        "A maintainer workbench in `piglets/porter/`. You do not need it to use PiG.",
        "[Pig Porter README](https://github.com/MichaelKinsy/PiG/blob/main/piglets/porter/README.md)"
      ],
      "Divergence": [
        "The \"Differs from Pi\" boxes and the numbered D entries.",
        "[Divergences](https://github.com/MichaelKinsy/PiG/blob/main/docs/parity/DIVERGENCES.md)"
      ],
      "Evidence": [
        "The quality and release records of the repository. A user does not need it.",
        "[Repository quality](https://github.com/MichaelKinsy/PiG/blob/main/docs/project/repository-quality.md)"
      ],
      "Transcript": [
        "The context PiG sends to a model, in the Session file and in the Go SDK.",
        "[Message types](/docs/latest/message-types)"
      ],
      "Provider": [
        "The model service behind a model name.",
        "[Custom providers](/docs/latest/custom-provider)"
      ],
      "Event Stream": [
        "The ordered events a Provider returns. This is not the JSON mode event stream, which is the CLI output.",
        "[JSON event stream mode](/docs/latest/json)"
      ],
      "Model Runtime": [
        "The one model path that the TUI, print, JSON and RPC modes share.",
        "[How PiG works](/docs/latest/how-pig-works)"
      ],
      "Main Screen": [
        "The terminal area that shows the conversation. Scrollback stays intact.",
        "[TUI components](/docs/latest/tui)"
      ],
      "Extension Host": [
        "The process model behind extensions: isolated, packed, or fused.",
        "[Extensions](/docs/latest/extensions)"
      ],
      "Piglet Image": [
        "Planned. `pig piglet build --format image` fails today.",
        "[Piglet lifecycle](/docs/latest/piglet-lifecycle)"
      ]
    }
