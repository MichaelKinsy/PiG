# Pi 1.1.0 publishes pi-coding-agent without npm-shrinkwrap.json. Install its
# dependencies inside the package, as a global npm install of Pi does, so the
# published Pi workspace packages stay at node_modules/@earendil-works/pi-coding-agent/node_modules.
install-strategy=shallow
# This package's own peer dependencies are for the project that installs it. Here npm leaves them out of the tree,
# which stays the published install of Pi that the pin tooling freezes; scripts/pin-bundle.test.mjs requires the
# lock to hold every required peer of the tree's own packages, which this setting also keeps npm from adding.
legacy-peer-deps=true
