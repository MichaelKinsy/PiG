;;;; pi-tui's utils.ts text half: SGR/OSC 8 tracking, word wrap, truncate, slice. A line-by-line port of Pi's functions (Python SDK: tui/_text.py).

(in-package #:pig)

(defparameter +tui-cursor-marker+ (coerce (list +tui-esc+ #\_ #\p #\i #\: #\c (code-char 7)) 'string)
  "The zero-width marker a component places where the hardware cursor belongs (pi-tui's CURSOR_MARKER).")

(defun tui-cat (&rest parts) (apply #'concatenate 'string parts))

(defun tui-spaces (n) (make-string (max 0 n) :initial-element #\Space))

;;; ------------------------------------------------------------------ OSC 8 links

(defun tui-osc8-match (code)
  "Whether CODE is a whole OSC 8 sequence (ESC ] 8 ; params ; url, then BEL or ST); and its url, NIL when empty."
  (let ((n (length code)))
    (when (and (> n 4) (string= code (tui-esc "]8;") :end1 4))
      (let ((sep (position #\; code :start 4)))
        (when sep
          (let ((stop (position-if (lambda (c) (or (char= c +tui-esc+) (= (char-code c) 7))) code :start (1+ sep))))
            (when (and stop (or (and (= (char-code (char code stop)) 7) (= stop (1- n)))
                                (and (char= (char code stop) +tui-esc+) (= stop (- n 2)) (char= (char code (1+ stop)) #\\))))
              (values t (and (< (1+ sep) stop) (subseq code (1+ sep) stop))))))))))

(defun tui-get-osc8-link-at-column (line column)
  "The OSC 8 hyperlink target covering the visible COLUMN of LINE, or NIL (pi-tui's getOsc8LinkAtColumn)."
  (let ((line (tui-simple line)) (active nil) (current 0) (i 0))
    (loop while (< i (length line))
          do (let ((len (tui-ansi-length line i)))
               (if (plusp len)
                   (progn (multiple-value-bind (matched url) (tui-osc8-match (subseq line i (+ i len)))
                            (when matched (setf active url)))
                          (incf i len))
                   (let ((end (tui-text-end line i)))
                     (do-tui-graphemes (s e line i end)
                       (let ((width (if (and (= (- e s) 1) (char= (char line s) #\Tab)) 3 (tui-grapheme-width line s e))))
                         (when (and (<= current column) (< column (+ current width)))
                           (return-from tui-get-osc8-link-at-column active))
                         (incf current width)))
                     (setf i end)))))
    nil))

(defun tui-parse-osc8 (code)
  "The OSC 8 meaning of CODE: :NOT (not a link sequence), NIL (a close) or a list (params url terminator)."
  (if (not (and (>= (length code) 4) (string= code (tui-esc "]8;") :end1 4)))
      :not
      (let* ((bel (= (char-code (char code (1- (length code)))) 7))
             (terminator (if bel (string (code-char 7)) (tui-esc "\\")))
             (body (subseq code 4 (max 4 (- (length code) (if bel 1 2)))))
             (sep (position #\; body)))
        (cond ((null sep) :not)
              ((= (1+ sep) (length body)) nil)
              (t (list (subseq body 0 sep) (subseq body (1+ sep)) terminator))))))

(defun tui-active-osc8-close (prefix)
  (if (not (search (tui-esc "]8;") prefix))
      ""
      (let ((active nil) (i 0) (n (length prefix)))
        (loop while (< i n)
              do (let ((len (tui-ansi-length prefix i)))
                   (if (plusp len)
                       (let ((link (tui-parse-osc8 (subseq prefix i (+ i len)))))
                         (unless (eq link :not) (setf active link))
                         (incf i len))
                       (incf i))))
        (if active (tui-cat (tui-esc "]8;;") (third active)) ""))))

;;; ------------------------------------------------------------------ SGR state

(defstruct (tui-tracker (:conc-name tt-))
  bold dim italic underline blink inverse hidden strikethrough fg bg hyperlink)

(defun tt-reset (tracker)
  (setf (tt-bold tracker) nil (tt-dim tracker) nil (tt-italic tracker) nil (tt-underline tracker) nil
        (tt-blink tracker) nil (tt-inverse tracker) nil (tt-hidden tracker) nil (tt-strikethrough tracker) nil
        (tt-fg tracker) nil (tt-bg tracker) nil))

(defun tui-js-int (text)
  "Number.parseInt(text, 10) of a digit string; NIL is NaN."
  (and (plusp (length text)) (every (lambda (c) (char<= #\0 c #\9)) text) (parse-integer text)))

(defun tui-split (text char)
  (loop with start = 0
        for pos = (position char text :start start)
        collect (subseq text start pos)
        while pos do (setf start (1+ pos))))

(defun tui-sgr-params (code)
  "The parameter text of the SGR sequence CODE (the digits and semicolons of its leftmost ESC [ ... m), or NIL."
  (when (and (plusp (length code)) (char= (char code (1- (length code))) #\m))
    (loop for j from 0 below (1- (length code))
          do (when (and (char= (char code j) +tui-esc+) (< (1+ j) (length code)) (char= (char code (1+ j)) #\[)
                        (loop for k from (+ j 2) below (1- (length code))
                              always (or (char<= #\0 (char code k) #\9) (char= (char code k) #\;))))
               (return (subseq code (+ j 2) (1- (length code))))))))

(defun tt-process (tracker code)
  (let ((link (tui-parse-osc8 code)))
    (unless (eq link :not)
      (setf (tt-hyperlink tracker) link)
      (return-from tt-process)))
  (let ((params (tui-sgr-params code)))
    (when (null params) (return-from tt-process))
    (when (member params '("" "0") :test #'string=)
      (tt-reset tracker)
      (return-from tt-process))
    (let* ((parts (coerce (tui-split params #\;) 'simple-vector)) (n (length parts)) (i 0))
      (loop while (< i n)
            do (let ((c (tui-js-int (svref parts i))) (step 1))
                 (flet ((color (text) (if (eql c 38) (setf (tt-fg tracker) text) (setf (tt-bg tracker) text))))
                   (cond ((and (member c '(38 48)) (< (+ i 2) n) (string= (svref parts (1+ i)) "5"))
                          (color (format nil "~A;~A;~A" (svref parts i) (svref parts (1+ i)) (svref parts (+ i 2))))
                          (setf step 3))
                         ((and (member c '(38 48)) (< (+ i 4) n) (string= (svref parts (1+ i)) "2"))
                          (color (format nil "~{~A~^;~}" (coerce (subseq parts i (+ i 5)) 'list)))
                          (setf step 5))
                         (t (case c
                              (0 (tt-reset tracker))
                              (1 (setf (tt-bold tracker) t))
                              (2 (setf (tt-dim tracker) t))
                              (3 (setf (tt-italic tracker) t))
                              (4 (setf (tt-underline tracker) t))
                              (5 (setf (tt-blink tracker) t))
                              (7 (setf (tt-inverse tracker) t))
                              (8 (setf (tt-hidden tracker) t))
                              (9 (setf (tt-strikethrough tracker) t))
                              (21 (setf (tt-bold tracker) nil))
                              (22 (setf (tt-bold tracker) nil (tt-dim tracker) nil))
                              (23 (setf (tt-italic tracker) nil))
                              (24 (setf (tt-underline tracker) nil))
                              (25 (setf (tt-blink tracker) nil))
                              (27 (setf (tt-inverse tracker) nil))
                              (28 (setf (tt-hidden tracker) nil))
                              (29 (setf (tt-strikethrough tracker) nil))
                              (39 (setf (tt-fg tracker) nil))
                              (49 (setf (tt-bg tracker) nil))
                              (t (when c
                                   (cond ((or (<= 30 c 37) (<= 90 c 97)) (setf (tt-fg tracker) (princ-to-string c)))
                                         ((or (<= 40 c 47) (<= 100 c 107)) (setf (tt-bg tracker) (princ-to-string c))))))))))
                 (incf i step))))))

(defun tt-active-codes (tracker)
  (let ((codes (remove nil (list (and (tt-bold tracker) "1") (and (tt-dim tracker) "2") (and (tt-italic tracker) "3")
                                 (and (tt-underline tracker) "4") (and (tt-blink tracker) "5") (and (tt-inverse tracker) "7")
                                 (and (tt-hidden tracker) "8") (and (tt-strikethrough tracker) "9")
                                 (and (plusp (length (tt-fg tracker))) (tt-fg tracker))
                                 (and (plusp (length (tt-bg tracker))) (tt-bg tracker)))))
        (link (tt-hyperlink tracker)))
    (tui-cat (if codes (tui-esc (format nil "[~{~A~^;~}m" codes)) "")
             (if link (tui-cat (tui-esc "]8;") (first link) ";" (second link) (third link)) ""))))

(defun tt-active-background (tracker)
  (if (plusp (length (tt-bg tracker))) (tui-esc (format nil "[~Am" (tt-bg tracker))) ""))

(defun tt-line-end-reset (tracker)
  (tui-cat (if (tt-underline tracker) (tui-esc "[24m") "")
           (if (tt-hyperlink tracker) (tui-cat (tui-esc "]8;;") (third (tt-hyperlink tracker))) "")))

(defun tui-update-tracker (text tracker)
  (let ((i (position +tui-esc+ text)))
    (loop while i
          do (let ((len (tui-ansi-length text i)))
               (if (plusp len)
                   (progn (tt-process tracker (subseq text i (+ i len))) (incf i len))
                   (incf i))
               (setf i (position +tui-esc+ text :start i))))))

(defun tui-get-active-background-ansi (text)
  "The background SGR sequence active at the end of TEXT (pi-tui's getActiveBackgroundAnsi)."
  (let ((tracker (make-tui-tracker)))
    (tui-update-tracker (tui-simple text) tracker)
    (tt-active-background tracker)))

;;; ------------------------------------------------------------------ wrapping

(defun tui-cjk-break-p (text start end)
  (loop for k from start below end thereis (logtest (tui-prop-at text k) +tui-cjk+)))

(defun tui-split-into-tokens (text)
  (let ((tokens '()) (current "") (pending "") (kind nil) (i 0) (n (length text)))
    (loop while (< i n)
          do (let ((len (tui-ansi-length text i)))
               (if (plusp len)
                   (setf pending (tui-cat pending (subseq text i (+ i len))) i (+ i len))
                   (let* ((end (or (loop for e = (position +tui-esc+ text :start (1+ i)) then (position +tui-esc+ text :start (1+ e))
                                         while e when (plusp (tui-ansi-length text e)) return e)
                                   n))
                          (chunk (subseq text i end)) (ascii (tui-printable-ascii-p chunk)))
                     (flet ((segment (segment)
                              (let ((space (string= segment " ")))
                                (cond ((and (not ascii) (not space) (tui-cjk-break-p segment 0 (length segment)))
                                       (when (plusp (length current)) (push current tokens) (setf current "" kind nil))
                                       (push (tui-cat pending segment) tokens)
                                       (setf pending ""))
                                      (t (let ((seg-kind (if space :space :word)))
                                           (when (and (plusp (length current)) (not (eq kind seg-kind)))
                                             (push current tokens) (setf current "" kind nil))
                                           (when (plusp (length pending)) (setf current (tui-cat current pending) pending ""))
                                           (setf kind seg-kind current (tui-cat current segment))))))))
                       (if ascii
                           (loop for c across chunk do (segment (string c)))
                           (let ((chunk (tui-simple chunk)))
                             (do-tui-graphemes (s e chunk) (segment (subseq chunk s e))))))
                     (setf i end)))))
    (when (plusp (length pending))
      (cond ((plusp (length current)) (setf current (tui-cat current pending)))
            (tokens (setf (car tokens) (tui-cat (car tokens) pending)))
            (t (setf current pending))))
    (when (plusp (length current)) (push current tokens))
    (nreverse tokens)))

(defun tui-break-long-word (word width tracker)
  (let ((lines '()) (current (tt-active-codes tracker)) (current-width 0) (segments '()) (i 0) (n (length word)))
    (loop while (< i n)
          do (let ((len (tui-ansi-length word i)))
               (if (plusp len)
                   (progn (push (cons t (subseq word i (+ i len))) segments) (incf i len))
                   (let ((end (tui-text-end word i)))
                     (do-tui-graphemes (s e word i end) (push (cons nil (subseq word s e)) segments))
                     (setf i end)))))
    (dolist (segment (nreverse segments))
      (destructuring-bind (ansi . value) segment
        (cond (ansi (setf current (tui-cat current value)) (tt-process tracker value))
              ((zerop (length value)))
              (t (let ((w (tui-visible-width value)))
                   (when (> (+ current-width w) width)
                     (setf current (tui-cat current (tt-line-end-reset tracker)))
                     (push current lines)
                     (setf current (tt-active-codes tracker) current-width 0))
                   (setf current (tui-cat current value))
                   (incf current-width w))))))
    (when (plusp (length current)) (push current lines))
    (or (nreverse lines) (list ""))))

(defun tui-wrap-single-line (line width)
  (cond
    ((zerop (length line)) (list ""))
    ((<= (tui-visible-width line) width) (list line))
    (t
     (let ((wrapped '()) (tracker (make-tui-tracker)) (current "") (current-len 0))
       (dolist (token (tui-split-into-tokens line))
         (let* ((token-len (tui-visible-width token))
                (whitespace (zerop (length (tui-trim-start (tui-trim-end token))))))
           (cond
             ((and (> token-len width) (not whitespace))
              (when (plusp (length current))
                (push (tui-cat current (tt-line-end-reset tracker)) wrapped)
                (setf current "" current-len 0))
              (let ((broken (tui-break-long-word token width tracker)))
                (dolist (piece (butlast broken)) (push piece wrapped))
                (setf current (car (last broken)) current-len (tui-visible-width current))))
             (t
              (if (and (> (+ current-len token-len) width) (> current-len 0))
                  (progn (push (tui-cat (tui-trim-end current) (tt-line-end-reset tracker)) wrapped)
                         (if whitespace
                             (setf current (tt-active-codes tracker) current-len 0)
                             (setf current (tui-cat (tt-active-codes tracker) token) current-len token-len)))
                  (setf current (tui-cat current token) current-len (+ current-len token-len)))
              (tui-update-tracker token tracker)))))
       (when (plusp (length current)) (push current wrapped))
       (if wrapped (mapcar #'tui-trim-end (nreverse wrapped)) (list ""))))))

(defun tui-split-lines (text)
  "TEXT split at CRLF, CR and LF."
  (let ((lines '()) (start 0) (i 0) (n (length text)))
    (loop while (< i n)
          do (let ((c (char text i)))
               (cond ((char= c #\Return)
                      (push (subseq text start i) lines)
                      (when (and (< (1+ i) n) (char= (char text (1+ i)) #\Newline)) (incf i))
                      (setf start (1+ i)))
                     ((char= c #\Newline) (push (subseq text start i) lines) (setf start (1+ i)))))
             (incf i))
    (push (subseq text start) lines)
    (nreverse lines)))

(defun tui-wrap-text-with-ansi (text width)
  "TEXT word-wrapped to WIDTH columns as a vector of lines, carrying SGR styling and OSC 8 links across lines (pi-tui's wrapTextWithAnsi)."
  (let ((text (tui-simple text)))
    (if (zerop (length text))
        (vector "")
        (let ((result '()) (tracker (make-tui-tracker)))
          (dolist (input (tui-split-lines text))
            (let ((prefix (if result (tt-active-codes tracker) "")))
              (dolist (line (tui-wrap-single-line (tui-simple (tui-cat prefix input)) width)) (push line result)))
            (tui-update-tracker input tracker))
          (coerce (or (nreverse result) (list "")) 'simple-vector)))))

;;; ------------------------------------------------------------------ truncating and slicing

(defun tui-truncate-fragment (text max-width)
  "The longest prefix of TEXT within MAX-WIDTH columns, and its width."
  (cond
    ((or (<= max-width 0) (zerop (length text))) (values "" 0))
    ((tui-printable-ascii-p text) (let ((clipped (subseq text 0 (min max-width (length text))))) (values clipped (length clipped))))
    (t
     (let ((text (tui-simple text)) (out (make-string-output-stream)) (width 0) (pending ""))
       (if (not (or (find +tui-esc+ text) (find #\Tab text)))
           (do-tui-graphemes (s e text)
             (let ((w (tui-grapheme-width text s e)))
               (when (> (+ width w) max-width) (return))
               (write-string text out :start s :end e)
               (incf width w)))
           (let ((i 0) (n (length text)))
             (loop while (< i n)
                   do (let ((len (tui-ansi-length text i)))
                        (cond ((plusp len) (setf pending (tui-cat pending (subseq text i (+ i len))) i (+ i len)))
                              ((char= (char text i) #\Tab)
                               (when (> (+ width 3) max-width) (return))
                               (write-string pending out) (setf pending "")
                               (write-char #\Tab out) (incf width 3) (incf i))
                              (t (let ((end i))
                                   (loop while (and (< end n) (char/= (char text end) #\Tab) (zerop (tui-ansi-length text end))) do (incf end))
                                   (do-tui-graphemes (s e text i end)
                                     (let ((w (tui-grapheme-width text s e)))
                                       (when (> (+ width w) max-width)
                                         (return-from tui-truncate-fragment (values (get-output-stream-string out) width)))
                                       (write-string pending out) (setf pending "")
                                       (write-string text out :start s :end e)
                                       (incf width w)))
                                   (setf i end))))))))
       (values (get-output-stream-string out) width)))))

(defun tui-finalize-truncated (prefix prefix-width ellipsis ellipsis-width max-width pad)
  (let* ((reset (tui-esc "[0m")) (close (tui-active-osc8-close prefix)) (visible (+ prefix-width ellipsis-width))
         (result (if (plusp (length ellipsis)) (tui-cat prefix close reset ellipsis reset) (tui-cat prefix close reset))))
    (if pad (tui-cat result (tui-spaces (- max-width visible))) result)))

(defun tui-truncate-to-width (text max-width &optional (ellipsis "...") pad)
  "TEXT cut to at most MAX-WIDTH columns with ELLIPSIS appended when it was cut (pi-tui's truncateToWidth)."
  (let ((text (tui-simple text)) (ellipsis (tui-simple ellipsis)))
    (when (<= max-width 0) (return-from tui-truncate-to-width ""))
    (when (zerop (length text)) (return-from tui-truncate-to-width (if pad (tui-spaces max-width) "")))
    (let ((ellipsis-width (tui-visible-width ellipsis)))
      (when (>= ellipsis-width max-width)
        (let ((text-width (tui-visible-width text)))
          (when (<= text-width max-width)
            (return-from tui-truncate-to-width (if pad (tui-cat text (tui-spaces (- max-width text-width))) text)))
          (multiple-value-bind (clipped clipped-width) (tui-truncate-fragment ellipsis max-width)
            (return-from tui-truncate-to-width
              (if (zerop clipped-width)
                  (if pad (tui-spaces max-width) "")
                  (tui-finalize-truncated "" 0 clipped clipped-width max-width pad))))))
      (when (tui-printable-ascii-p text)
        (return-from tui-truncate-to-width
          (if (<= (length text) max-width)
              (if pad (tui-cat text (tui-spaces (- max-width (length text)))) text)
              (let ((target (- max-width ellipsis-width)))
                (tui-finalize-truncated (subseq text 0 target) target ellipsis ellipsis-width max-width pad)))))
      (let ((target (- max-width ellipsis-width)) (out (make-string-output-stream)) (pending "") (visible 0) (kept 0)
            (contiguous t) (overflowed nil) (exhausted nil))
        (flet ((take (s e width)
                 ;; One grapheme (or tab, when S is NIL) of WIDTH columns: kept while the prefix is unbroken and fits the target.
                 (if (and contiguous (<= (+ kept width) target))
                     (progn (write-string pending out) (setf pending "")
                            (if s (write-string text out :start s :end e) (write-char #\Tab out))
                            (incf kept width))
                     (setf contiguous nil pending ""))
                 (incf visible width)
                 (when (> visible max-width) (setf overflowed t))))
          (if (not (or (find +tui-esc+ text) (find #\Tab text)))
              (progn (do-tui-graphemes (s e text) (take s e (tui-grapheme-width text s e)) (when overflowed (return)))
                     (setf exhausted (not overflowed)))
              (let ((i 0) (n (length text)))
                (loop while (< i n)
                      do (let ((len (tui-ansi-length text i)))
                           (cond ((plusp len) (setf pending (tui-cat pending (subseq text i (+ i len))) i (+ i len)))
                                 ((char= (char text i) #\Tab)
                                  (take nil nil 3)
                                  (when overflowed (return))
                                  (incf i))
                                 (t (let ((end i))
                                      (loop while (and (< end n) (char/= (char text end) #\Tab) (zerop (tui-ansi-length text end))) do (incf end))
                                      (do-tui-graphemes (s e text i end) (take s e (tui-grapheme-width text s e)) (when overflowed (return)))
                                      (when overflowed (return))
                                      (setf i end))))))
                (setf exhausted (>= i n)))))
        (if (and (not overflowed) exhausted)
            (if pad (tui-cat text (tui-spaces (- max-width visible))) text)
            (tui-finalize-truncated (get-output-stream-string out) kept ellipsis ellipsis-width max-width pad))))))

(defun tui-slice-with-width (line start-col length &optional strict)
  "The text of the visible columns [START-COL, START-COL + LENGTH) of LINE and its width (pi-tui's sliceWithWidth)."
  (if (<= length 0)
      (values "" 0)
      (let* ((line (tui-simple line)) (end-col (+ start-col length)) (out (make-string-output-stream)) (result-width 0)
             (current 0) (i 0) (pending "") (n (length line)))
        (loop while (< i n)
              do (let ((code-len (tui-ansi-length line i)))
                   (if (plusp code-len)
                       (let ((code (subseq line i (+ i code-len))))
                         (cond ((and (<= start-col current) (< current end-col)) (write-string pending out) (write-string code out) (setf pending ""))
                               ((< current start-col) (setf pending (tui-cat pending code))))
                         (incf i code-len))
                       (let ((text-end (tui-text-end line i)))
                         (do-tui-graphemes (s e line i text-end)
                           (let* ((w (tui-grapheme-width line s e)) (in-range (and (<= start-col current) (< current end-col)))
                                  (fits (or (not strict) (<= (+ current w) end-col))))
                             (when (and in-range fits)
                               (write-string pending out) (setf pending "")
                               (write-string line out :start s :end e)
                               (incf result-width w))
                             (incf current w)
                             (when (>= current end-col) (return))))
                         (setf i text-end)
                         (when (>= current end-col) (return))))))
        (values (get-output-stream-string out) result-width))))

(defun tui-slice-by-column (line start-col length &optional strict)
  "The visible columns [START-COL, START-COL + LENGTH) of LINE with ANSI codes preserved (pi-tui's sliceByColumn)."
  (values (tui-slice-with-width line start-col length strict)))

(defun tui-extract-segments (line before-end after-start after-len &optional strict-after)
  "Values: the text before BEFORE-END, its width, the text of AFTER-LEN columns from AFTER-START and its width (pi-tui's extractSegments)."
  (let* ((line (tui-simple line)) (before (make-string-output-stream)) (before-width 0) (after (make-string-output-stream)) (after-width 0)
         (current 0) (i 0) (pending-before "") (after-started nil) (after-end (+ after-start after-len)) (tracker (make-tui-tracker)) (n (length line)))
    (flet ((done-p () (if (<= after-len 0) (>= current before-end) (>= current after-end))))
      (loop while (< i n)
            do (let ((code-len (tui-ansi-length line i)))
                 (if (plusp code-len)
                     (let ((code (subseq line i (+ i code-len))))
                       (tt-process tracker code)
                       (cond ((< current before-end) (setf pending-before (tui-cat pending-before code)))
                             ((and (<= after-start current) (< current after-end)
                                   (or after-started (and (> (length code) 1) (char= (char code 1) #\_))))
                              (write-string code after)))
                       (incf i code-len))
                     (let ((text-end (tui-text-end line i)) (finished nil))
                       (do-tui-graphemes (s e line i text-end)
                         (let ((w (tui-grapheme-width line s e)))
                           (cond ((and (< current before-end) (<= (+ current w) before-end))
                                  (write-string pending-before before) (setf pending-before "")
                                  (write-string line before :start s :end e)
                                  (incf before-width w))
                                 ((and (<= after-start current) (< current after-end))
                                  (when (or (not strict-after) (<= (+ current w) after-end))
                                    (unless after-started (write-string (tt-active-codes tracker) after) (setf after-started t))
                                    (write-string line after :start s :end e)
                                    (incf after-width w))))
                           (incf current w)
                           (when (done-p) (setf finished t) (return))))
                       (setf i text-end)
                       (when (or finished (done-p)) (return)))))))
    (values (get-output-stream-string before) before-width (get-output-stream-string after) after-width)))
