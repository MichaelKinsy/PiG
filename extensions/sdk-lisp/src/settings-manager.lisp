;;;; Pi's SettingsManager (core/settings-manager.ts): the global and project settings an extension reads and writes, or in-memory settings it
;;;; builds for a child session. The host owns the object; every method is Pi's under its kebab-case name, NIL is Pi's undefined.

(in-package #:pig)

(defstruct (settings-manager (:include graph-object) (:conc-name settings-) (:constructor %make-settings-manager (ctx handle))))

(defun settings-new (ctx op &rest args) (%make-settings-manager ctx (apply #'graph-new ctx "SettingsManager" op args)))

(defun settings-create (ctx cwd &optional agent-dir options)
  "SettingsManager.create(cwd, agentDir = the host's agent directory, options = {}): settings loaded from the files of AGENT-DIR (global) and CWD (project).
OPTIONS is Pi's SettingsManagerCreateOptions (projectTrusted)."
  (settings-new ctx "create" cwd agent-dir options))

(defun settings-in-memory (ctx &optional settings options)
  "SettingsManager.inMemory(settings = {}, options = {}): settings that never touch a file."
  (settings-new ctx "inMemory" (or settings (obj)) options))

;;; Storage: the host calls back (begin SCOPE) to start the storage's with-lock and learn its current text, then (finish RESULT) to hand the
;;; text fn returns to the host's result and wait for with-lock to return.

(defstruct (settings-lock (:constructor make-settings-lock ()))
  (mutex (sb-thread:make-mutex :name "pig settings storage"))
  (queue (sb-thread:make-waitqueue))
  (current nil) (result nil) (done nil))

(defun settings-lock-set (lock slot value)
  (sb-thread:with-mutex ((settings-lock-mutex lock))
    (setf (slot-value lock slot) (list value))
    (sb-thread:condition-broadcast (settings-lock-queue lock))))

(defun settings-lock-wait (lock &rest slots)
  "Wait until one of SLOTS is set and return (SLOT . (VALUE))."
  (sb-thread:with-mutex ((settings-lock-mutex lock))
    (loop (dolist (slot slots)
            (let ((cell (slot-value lock slot))) (when cell (return-from settings-lock-wait (cons slot cell)))))
          (sb-thread:condition-wait (settings-lock-queue lock) (settings-lock-mutex lock)))))

(defun settings-storage-callback (storage)
  "The function the host runs for every with-lock of STORAGE, a function (lambda (scope fn)) that calls FN with the scope's current text
(NIL when there is none) while it holds its lock; FN returns the text to store or NIL, and signals for a settings file that does not parse."
  (let ((pending nil) (guard (sb-thread:make-mutex :name "pig settings pending")))
    (lambda (op &optional argument)
      (cond
        ((equal op "begin")
         (let ((lock (make-settings-lock)))
           (sb-thread:make-thread
            (lambda ()
              (settings-lock-set
               lock 'done
               (handler-case
                   (progn (funcall storage argument
                                   (lambda (text)
                                     (settings-lock-set lock 'current text)
                                     (let* ((result (second (settings-lock-wait lock 'result)))
                                            (message (jget result "error")))
                                       (when (and (stringp message) (plusp (length message))) (error "~A" message))
                                       (and (eq (jget result "write") t) (jget result "text")))))
                          nil)
                 (error (e) e))))
            :name "pig settings storage")
           (let ((first (settings-lock-wait lock 'current 'done)))
             (when (eq (car first) 'done)
               (error (or (second first) "settings storage: with-lock returned without calling fn")))
             (sb-thread:with-mutex (guard) (setf pending lock))
             (obj "current" (second first)))))
        ((equal op "finish")
         (let ((lock (sb-thread:with-mutex (guard) (shiftf pending nil))))
           (unless lock (error "settings storage callback: finish without begin"))
           (settings-lock-set lock 'result (or argument (obj)))
           (let ((outcome (second (settings-lock-wait lock 'done))))
             (when outcome (error outcome)))
           nil))
        (t (error "settings storage callback: unknown operation ~S" op))))))

(defun settings-from-storage (ctx storage &optional options)
  "SettingsManager.fromStorage(storage, options = {}): settings kept by STORAGE, a function (lambda (scope fn)) of this process that the host calls back
whenever the manager reads or writes a scope: it runs FN on the scope's current text (NIL when there is none) while it holds its lock and stores the text FN returns."
  (settings-new ctx "fromStorage" (obj "withLock" (graph-callback-id ctx (settings-storage-callback storage))) options))

(defun settings-drain-errors (manager)
  "The errors loading or writing the settings files since the last call, as Pi's SettingsError objects (scope, path, error)."
  (or (graph-call manager "drainErrors") #()))

