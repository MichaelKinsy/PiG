;;;; SPDX-License-Identifier: MIT
;;;; pi-tui helpers against the vectors generated from Pi's own functions: test/parity/sdk-vectors/pi-tui/<export>.json (one file per export) and
;;;; test/parity/sdk-bulk/tui-*.json (large tables of cases). A helper that returns a constant or ports a different rule fails here.
;;;; The same vectors run in extensions/sdk-py/tests/test_tui_pi_vectors.py and test_tui_vectors.py.
(in-package #:pig-tests)

(defun tv-load (path) (pig:from-json (read-text-file (repo-path path))))
(defun tv-pi (export) (tv-load (format nil "test/parity/sdk-vectors/pi-tui/~A.json" export)))
(defun tv-bulk (name) (tv-load (format nil "test/parity/sdk-bulk/~A.json" name)))
(defun tv-list (vector) (coerce vector 'list))
(defun tv-undefined-p (v) (and (hash-table-p v) (equal (gethash "$" v) "undefined")))
(defun tv-opt (v) (or v (pig:obj "$" "undefined")))
(defun tv-null (v) (if (eq v :null) nil v))
(defun tv-true (v) (eq v t))

(defun tv-same (a b)
  "Strict structural equality (the harness's check= is case-insensitive on strings)."
  (cond ((and (stringp a) (stringp b)) (string= a b))
        ((and (realp a) (realp b)) (= a b))
        ((and (consp a) (consp b)) (and (tv-same (car a) (car b)) (tv-same (cdr a) (cdr b))))
        ((and (vectorp a) (vectorp b) (not (stringp a)) (not (stringp b))) (and (= (length a) (length b)) (every #'tv-same a b)))
        ((and (hash-table-p a) (hash-table-p b)) (pig::ts-json-equal a b))
        (t (eql a b))))

(defmacro check= (expected actual &optional message)
  `(let ((e ,expected) (a ,actual))
     (check (tv-same e a) (format nil "expected ~S, got ~S~@[ (~A)~]" e a ,message))))

(defun tv-rows (vector) (map 'list (lambda (row) (coerce row 'list)) vector))

(defun tv-near (got want)
  "WANT (from Pi) against GOT: numbers within 1e-9 relative, objects member by member (a neutral color has no hue), arrays element by element."
  (cond ((eq want :false) (or (null got) (eq got :false)))
        ((eq want t) (eq got t))
        ((realp want)
         (and (realp got) (or (= got want) (<= (abs (- got want)) (* 1d-9 (max 1 (abs want)))))))
        ((hash-table-p want)
         (and (hash-table-p got) (= (hash-table-count got) (hash-table-count want))
              (let ((neutral (loop for key in '("c" "s") thereis (let ((v (gethash key want))) (and (realp v) (< v 1d-9))))))
                (loop for key being the hash-keys of want using (hash-value x)
                      always (or (and neutral (equal key "h")) (and (nth-value 1 (gethash key got)) (tv-near (gethash key got) x)))))))
        ((and (vectorp want) (not (stringp want)))
         (and (vectorp got) (not (stringp got)) (= (length got) (length want)) (every #'tv-near got want)))
        (t (equal got want))))

(defmacro tv-with-error ((error-var) form &body on-result)
  "Run FORM; ON-RESULT sees the value, or ERROR-VAR bound to the message of the tui-error it signalled."
  `(let* ((,error-var nil) (value (handler-case ,form (pig:tui-error (e) (setf ,error-var (pig:tui-error-message e)) nil))))
     (declare (ignorable value))
     ,@on-result))

(defun tv-run-pi (export function)
  (let ((cases (tv-list (gethash "cases" (tv-pi export)))))
    (check (plusp (length cases)) export)
    (dolist (case cases)
      (let* ((args (tv-list (gethash "args" case))) (name (gethash "name" case)))
        (tv-with-error (error) (apply function args)
          (if (nth-value 1 (gethash "throws" case))
              (check= (gethash "throws" case) error (format nil "~A ~A ~S" export name args))
              (check (and (null error) (tv-near value (gethash "result" case)))
                     (format nil "~A ~A ~S: got ~S, want ~S" export name args value (gethash "result" case)))))))))

