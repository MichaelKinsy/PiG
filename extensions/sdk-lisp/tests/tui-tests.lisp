;;; ------------------------------------------------------------------ test/parity/sdk-bulk

(deftest tui-text-vectors-match-pi
  (let ((v (tv-bulk "tui-text")))
    (check= (gethash "cursorMarker" v) pig:+tui-cursor-marker+)
    (dolist (key '("visibleWidth" "truncate" "wrap")) (check (> (length (gethash key v)) 1000) key))
    (loop for (s w) in (tv-rows (gethash "visibleWidth" v)) do (check= w (pig:tui-visible-width s) s))
    (loop for (s out) in (tv-rows (gethash "strip" v)) do (check= out (pig:tui-strip-terminal-sequences s) s))
    (loop for (s out) in (tv-rows (gethash "bg" v)) do (check= out (pig:tui-get-active-background-ansi s) s))
    (loop for (s w ellipsis pad out) in (tv-rows (gethash "truncate" v))
          do (check= out (if (eq ellipsis :null) (pig:tui-truncate-to-width s w) (pig:tui-truncate-to-width s w ellipsis (tv-true pad))) (list s w ellipsis pad)))
    (loop for (s w out) in (tv-rows (gethash "wrap" v)) do (check= out (pig:tui-wrap-text-with-ansi s w) (list s w)))
    (loop for (s start n strict out with-width) in (tv-rows (gethash "slice" v))
          do (check= out (pig:tui-slice-by-column s start n (tv-true strict)) (list s start n strict))
             (multiple-value-bind (text width) (pig:tui-slice-with-width s start n (tv-true strict))
               (check= (list (gethash "text" with-width) (gethash "width" with-width)) (list text width) (list s start n strict))))
    (loop for (s before-end after-start after-len strict out) in (tv-rows (gethash "segments" v))
          do (check= (list (gethash "before" out) (gethash "beforeWidth" out) (gethash "after" out) (gethash "afterWidth" out))
                          (multiple-value-list (pig:tui-extract-segments s before-end after-start after-len (tv-true strict))) s))
    (loop for (s column out) in (tv-rows (gethash "link" v))
          do (check= (tv-null out) (pig:tui-get-osc8-link-at-column s column) (list s column)))))

(defun tv-camel-parts (name)
  (let ((parts '()) (start 0))
    (loop for i from 1 to (length name)
          do (when (or (= i (length name)) (upper-case-p (char name i)))
               (push (subseq name start i) parts)
               (setf start i)))
    (nreverse parts)))

(deftest tui-key-helper-matches-pi
  (let ((v (gethash "keyHelper" (tv-bulk "tui-keys"))))
    (check (> (hash-table-count v) 70))
    (loop for name being the hash-keys of v using (hash-value expected)
          do (let* ((parts (mapcar #'string-downcase (tv-camel-parts name)))
                    (modifiers (and (every (lambda (p) (member p '("shift" "alt" "ctrl" "super") :test #'string=)) parts)
                                    (mapcar (lambda (p) (intern (string-upcase p) :keyword)) parts))))
               (if modifiers
                   (check= expected (map 'simple-vector (lambda (k) (apply #'pig:tui-key k modifiers)) #("a" "Z" "enter" "f5" "[" "space")) name)
                   (check= expected (pig:tui-key (intern (string-upcase (format nil "~{~A~^-~}" parts)) :keyword)) name))))))

(defun tv-set-env (env)
  (dolist (name '("WT_SESSION" "SSH_CONNECTION" "SSH_CLIENT" "SSH_TTY")) (sb-posix:unsetenv name))
  (loop for name being the hash-keys of env using (hash-value value) do (sb-posix:setenv name value 1)))

(deftest tui-key-vectors-match-pi
  (let* ((v (tv-bulk "tui-keys")) (universe (gethash "universe" v)) (data (gethash "data" v)))
    (unwind-protect
         (loop for mode across (gethash "modes" v)
               do (tv-set-env (gethash "env" mode))
                  (pig:tui-set-kitty-protocol-active (tv-true (gethash "kitty" mode)))
                  (loop for index from 0 for d across data for row across (gethash "rows" mode)
                        do (destructuring-bind (parsed release repeat kitty-printable printable matched) (coerce row 'list)
                             (check= (tv-null parsed) (pig:tui-parse-key d) d)
                             (check= (tv-true release) (pig:tui-key-release-p d) d)
                             (check= (tv-true repeat) (pig:tui-key-repeat-p d) d)
                             (check= (tv-null kitty-printable) (pig:tui-decode-kitty-printable d) d)
                             (check= (tv-null printable) (pig:tui-decode-printable-key d) d)
                             ;; Every identifier Pi matches must match, and every 11th of the rest (an offset that moves with the row) must not.
                             (loop for j across matched do (check (pig:tui-matches-key d (aref universe j)) (list d (aref universe j))))
                             (loop for j from (mod index 11) below (length universe) by 11
                                   do (unless (find j matched) (check (not (pig:tui-matches-key d (aref universe j))) (list d (aref universe j))))))))
      (tv-set-env (pig:obj))
      (pig:tui-set-kitty-protocol-active nil))))

(deftest tui-fuzzy-vectors-match-pi
  (let ((v (tv-bulk "tui-fuzzy")))
    (loop for (query text matches score) in (tv-rows (gethash "match" v))
          do (let ((got (pig:tui-fuzzy-match query text)))
               (check (and (eq (tv-true matches) (pig:tui-fuzzy-match-matches got))
                           (or (not (tv-true matches)) (= score (pig:tui-fuzzy-match-score got))))
                      (list query text))))
    (loop for (items query out) in (tv-rows (gethash "filter" v))
          do (check= out (coerce (pig:tui-fuzzy-filter items query #'identity) 'simple-vector) (list items query)))))

(deftest tui-js-lower-matches-every-code-point
  (let ((changed (make-hash-table)))
    (loop for (cp to) in (tv-rows (gethash "pairs" (tv-bulk "tui-lower")))
          do (setf (gethash cp changed) (map 'string #'code-char to)))
    (dotimes (cp #x110000)
      (unless (or (<= #xD800 cp #xDFFF) (= cp #x3A3))
        (let ((got (pig::tui-js-lower (string (code-char cp)))))
          (unless (equal got (or (gethash cp changed) (string (code-char cp))))
            (check nil (format nil "toLowerCase of U+~X" cp))))))))

(deftest tui-color-vectors-match-pi
  (let ((v (tv-bulk "tui-colors")))
    (check (> (length (gethash "ops" v)) 1000))
    (loop for (op args want) in (tv-rows (gethash "ops" v))
          do (let ((args (mapcar (lambda (a) (if (equal a "NaN") :null a)) (coerce args 'list))))
               (tv-with-error (error)
                   (ecase (intern (string-upcase op) :keyword)
                     (:parsecolor (pig:tui-parse-color (first args)))
                     (:colortorgb (pig:tui-color-to-rgb (first args)))
                     (:colortohex (pig:tui-color-to-hex (first args)))
                     (:colortooklch (pig:tui-color-to-oklch (first args)))
                     (:colortookhsl (pig:tui-color-to-okhsl (first args)))
                     (:foregroundansi (apply #'pig:tui-foreground-ansi args))
                     (:backgroundansi (apply #'pig:tui-background-ansi args))
                     (:rgbcolor (apply #'pig:tui-rgb-color args))
                     (:oklchcolor (apply #'pig:tui-oklch-color args))
                     (:okhslcolor (apply #'pig:tui-okhsl-color args))
                     (:indexedcolor (apply #'pig:tui-indexed-color args))
                     (:mixcolors (pig:tui-mix-colors (first args) (second args) (third args) (if (stringp (fourth args)) (fourth args) "oklch")))
                     (:styletext (apply #'pig:tui-style-text args))
                     (:styletextwithansi (apply #'pig:tui-style-text-with-ansi args)))
                 (if (nth-value 1 (gethash "error" want))
                     (check= (gethash "error" want) error (list op args))
                     (check (and (null error) (tv-near value (gethash "ok" want))) (list op args value want))))))))

(deftest tui-hyperlink-and-capabilities-match-pi
  (let ((v (tv-bulk "tui-terminal")) (probed 0))
    (loop for (text url out) in (tv-rows (gethash "hyperlink" v)) do (check= out (pig:tui-hyperlink text url)))
    (loop for case across (gethash "capabilities" v)
          do (let* ((probes 0)
                    (got (pig::tt-detect (gethash "env" case) (gethash "platform" case)
                                         (lambda () (incf probes) (tv-true (gethash "tmux" case)))))
                    (want (gethash "detected" case)))
               (check= (list (tv-null (gethash "images" want)) (tv-true (gethash "trueColor" want)) (tv-true (gethash "hyperlinks" want)))
                            (list (pig:tui-capabilities-images got) (pig:tui-capabilities-true-color got) (pig:tui-capabilities-hyperlinks got))
                            (gethash "env" case))
               (check (eq (tv-true (gethash "tmuxProbed" case)) (plusp probes)) (gethash "env" case))
               (when (plusp probes) (incf probed))))
    (check (plusp probed))))

(defun tv-keys (value) (cond ((stringp value) (list value)) ((eq value :null) '()) (t (coerce value 'list))))

(defun tv-conflicts (conflicts)
  (mapcar (lambda (c) (list (pig:tui-keybinding-conflict-key c) (pig:tui-keybinding-conflict-keybindings c))) conflicts))

(defun tv-wanted-conflicts (conflicts)
  (map 'list (lambda (c) (list (gethash "key" c) (coerce (gethash "keybindings" c) 'list))) conflicts))

(deftest tui-keybindings-vectors-match-pi
  (let ((v (tv-bulk "tui-keybindings")))
    (loop for id being the hash-keys of (gethash "tuiKeybindings" v) using (hash-value want)
          do (let ((got (gethash id pig:*tui-keybindings*)))
               (check (and got (equal (tv-keys (pig:tui-keybinding-definition-default-keys got)) (tv-keys (gethash "defaultKeys" want)))
                           (equal (pig:tui-keybinding-definition-description got) (gethash "description" want)))
                      id)))
    (check= (hash-table-count (gethash "tuiKeybindings" v)) (hash-table-count pig:*tui-keybindings*))
    (let ((resolved (pig:tui-keybindings-get-resolved-bindings (pig:tui-get-keybindings))))
      (loop for id being the hash-keys of (gethash "defaultResolved" v) using (hash-value want)
            do (check= (tv-keys want) (tv-keys (gethash id resolved)) id))
      (check= (hash-table-count (gethash "defaultResolved" v)) (hash-table-count resolved)))
    (loop for case across (gethash "cases" v) for n from 0
          do (let* ((definitions (if (equal (gethash "definitions" case) "merged") (gethash "merged" v) (gethash "tuiKeybindings" v)))
                    (manager (pig:tui-make-keybindings-manager definitions (gethash "user" case))))
               (loop for id being the hash-keys of (gethash "keys" case) using (hash-value want)
                     do (check= want (pig:tui-keybindings-get-keys manager id) (list n id))
                        (let ((definition (pig:tui-keybindings-get-definition manager id)) (wanted (gethash id (gethash "definition" case))))
                          (check (eq (null definition) (eq wanted :null)) (list n id))
                          (when definition
                            (check= (tv-keys (gethash "defaultKeys" wanted)) (tv-keys (pig:tui-keybinding-definition-default-keys definition)) (list n id))))
                        (loop for data across (gethash "sample" v) for i from 0
                              do (check (eq (tv-true (aref (gethash id (gethash "matches" case)) i)) (pig:tui-keybindings-matches manager data id))
                                        (list n id data))))
               (check (pig::ts-json-equal (gethash "resolved" case) (pig:tui-keybindings-get-resolved-bindings manager)) n)
               (check= (tv-wanted-conflicts (gethash "conflicts" case)) (tv-conflicts (pig:tui-keybindings-get-conflicts manager)) n)
               (let ((user (pig:tui-keybindings-get-user-bindings manager)) (want (gethash "userBindings" case)))
                 (check= (hash-table-count want) (hash-table-count user) n)
                 (loop for id being the hash-keys of want using (hash-value keys) do (check= (tv-keys keys) (tv-keys (gethash id user)) (list n id))))
               (pig:tui-keybindings-set-user-bindings manager (pig:obj "tui.editor.cursorLeft" "ctrl+g"))
               (let ((after (gethash "afterSet" case)))
                 (check= (gethash "keys" after) (pig:tui-keybindings-get-keys manager "tui.editor.cursorLeft") n)
                 (check (pig::ts-json-equal (gethash "resolved" after) (pig:tui-keybindings-get-resolved-bindings manager)) n)
                 (check= (tv-wanted-conflicts (gethash "conflicts" after)) (tv-conflicts (pig:tui-keybindings-get-conflicts manager)) n))))))

;;; ------------------------------------------------------------------ the host's published state

(defun tv-state (submit confirm images)
  (pig:obj "keybindings"
           (pig:obj "definitions" (pig:obj "tui.input.submit" (pig:obj "defaultKeys" (vector "enter") "description" "Submit input")
                                           "tui.select.confirm" (pig:obj "defaultKeys" (vector confirm) "description" "Confirm selection (host)")
                                           "x.probe.a" (pig:obj "defaultKeys" "ctrl+a" "description" "Probe A")
                                           "x.probe.b" (pig:obj "defaultKeys" (vector "ctrl+b")))
                    "userBindings" (pig:obj "tui.input.submit" (vector submit) "x.probe.a" (vector "ctrl+k") "x.probe.b" "ctrl+k"))
           "terminalCapabilities" (pig:obj "images" images "trueColor" (if (equal images "iterm2") t :false) "hyperlinks" (if (equal images "iterm2") t :false))))

(deftest tui-state-follows-the-host
  (pig::ts-apply-host-state (tv-state "ctrl+y" "ctrl+j" "iterm2"))
  (let ((manager (pig:tui-get-keybindings)))
    (check= #("ctrl+y") (pig:tui-keybindings-get-keys manager "tui.input.submit"))
    (check= #("ctrl+j") (pig:tui-keybindings-get-keys manager "tui.select.confirm"))
    (check (pig:tui-keybindings-matches manager (string (code-char 25)) "tui.input.submit"))
    (check (not (pig:tui-keybindings-matches manager (string (code-char 13)) "tui.input.submit")))
    (check (pig:tui-keybindings-matches manager (string (code-char 11)) "x.probe.b"))
    (check= '(("ctrl+k" ("x.probe.a" "x.probe.b"))) (tv-conflicts (pig:tui-keybindings-get-conflicts manager)))
    (check= "Probe A" (pig:tui-keybinding-definition-description (pig:tui-keybindings-get-definition manager "x.probe.a")))
    (check (null (pig:tui-keybindings-get-definition manager "x.probe.missing")))
    (check= "ctrl+y" (pig:key-text "tui.input.submit") "the host's table, not Pi's default")
    (check= "" (pig:key-text "x.probe.missing")))
  (let ((caps (pig:tui-get-capabilities)))
    (check= (list "iterm2" t t) (list (pig:tui-capabilities-images caps) (pig:tui-capabilities-true-color caps) (pig:tui-capabilities-hyperlinks caps)))
    (check= "truecolor" (pig:tui-get-terminal-color-mode)))
  ;; A later publication replaces both.
  (pig::ts-apply-host-state (tv-state "ctrl+u" "ctrl+n" "kitty"))
  (check= #("ctrl+u") (pig:tui-keybindings-get-keys (pig:tui-get-keybindings) "tui.input.submit"))
  (check= (list "kitty" nil nil) (let ((caps (pig:tui-get-capabilities))) (list (pig:tui-capabilities-images caps) (pig:tui-capabilities-true-color caps) (pig:tui-capabilities-hyperlinks caps))))
  (check= "256color" (pig:tui-get-terminal-color-mode))
  ;; An explicit install supersedes what the host published before it; the host's next publication replaces it.
  (let ((own (pig:tui-make-keybindings-manager (pig:obj "x.probe" (pig:make-tui-keybinding-definition (vector "ctrl+q"))))))
    (pig:tui-set-keybindings own)
    (check= #("ctrl+q") (pig:tui-keybindings-get-keys (pig:tui-get-keybindings) "x.probe"))
    (pig:tui-keybindings-set-user-bindings (pig:tui-get-keybindings) (pig:obj "x.probe" (vector "ctrl+w")))
    (check= #("ctrl+w") (pig:tui-keybindings-get-keys (pig:tui-get-keybindings) "x.probe")))
  (pig::ts-apply-host-state (tv-state "ctrl+t" "ctrl+n" "kitty"))
  (check= #("ctrl+t") (pig:tui-keybindings-get-keys (pig:tui-get-keybindings) "tui.input.submit"))
  ;; setCapabilities and the overrides.
  (pig:tui-set-capabilities (pig:make-tui-capabilities "kitty" nil nil))
  (check= "256color" (pig:tui-get-terminal-color-mode))
  (pig:tui-set-capabilities (pig:make-tui-capabilities nil t nil))
  (check= "truecolor" (pig:tui-get-terminal-color-mode))
  (pig:tui-set-capability-overrides :hyperlinks t)
  (check (pig:tui-capabilities-hyperlinks (pig:tui-get-capabilities)))
  (pig:tui-set-capability-overrides)
  (pig:tui-reset-capabilities-cache)
  (check= "kitty" (progn (pig:tui-set-kitty-protocol-active t) (prog1 (and (pig:tui-kitty-protocol-active-p) "kitty") (pig:tui-set-kitty-protocol-active nil))))
  (check (not (pig:tui-kitty-protocol-active-p)))
  (check= "ctrl+x" (pig:tui-key "x" :ctrl))
  (check= "alt+enter" (pig:tui-key :enter :alt))
  (check= "ctrl+shift+p" (pig:tui-key "p" :ctrl :shift)))

(deftest key-text-formats-like-pi
  (check= "Ctrl+Y" (pig:format-key-text "ctrl+y" t))
  (check= "ctrl+y/enter" (pig:format-key-text "ctrl+y/enter"))
  (check= (if (member :darwin *features*) "option+left" "alt+left") (pig:format-key-text "alt+left")))
