;;; scratch: run every test in its own thread with a timeout and print its name (removed before the lane merges)
(require :asdf) (require :sb-bsd-sockets) (require :sb-posix)
(setf *compile-verbose* nil *compile-print* nil)
(defparameter *root* (merge-pathnames "../" (make-pathname :name nil :type nil :defaults (or *load-truename* *default-pathname-defaults*))))
(defun system-files (name)
  (with-open-file (in (merge-pathnames "pig-sdk.asd" *root*))
    (let ((*package* (find-package :cl-user)))
      (loop for form = (read in nil :eof) until (eq form :eof)
            do (when (and (consp form) (equal (second form) name))
                 (let* ((plist (cddr form)) (directory (getf plist :pathname)))
                   (return (loop for c in (getf plist :components) when (and (consp c) (eq (first c) :file)) collect (concatenate 'string directory (second c))))))))))
(handler-bind ((warning #'muffle-warning))
  (dolist (file (append (system-files "pig-sdk") (system-files "pig-sdk/tests")))
    (load (merge-pathnames (concatenate 'string file ".lisp") *root*))))
(let ((filter (sb-posix:getenv "TRACE_FILTER")))
  (dolist (test (symbol-value (find-symbol "*TESTS*" "PIG-TESTS")))
    (when (or (null filter) (search filter (string-downcase (symbol-name (car test)))))
      (format t "~&== ~A~%" (car test)) (finish-output)
      (let* ((fails-before (symbol-value (find-symbol "*FAILURES*" "PIG-TESTS")))
             (thread (sb-thread:make-thread (lambda () (handler-case (funcall (cdr test)) (error (e) (format t "~&ERROR ~A: ~A~%" (car test) e)))))))
        (unless (sb-thread:join-thread thread :default nil :timeout 30)
          (format t "~&HANG ~A~%" (car test)) (finish-output))
        (let ((f (symbol-value (find-symbol "*FAILURES*" "PIG-TESTS"))))
          (when (> f fails-before) (format t "~&  -> ~D failure(s)~%" (- f fails-before))))))))
(format t "~&done~%") (sb-ext:exit :code 0 :abort t)
