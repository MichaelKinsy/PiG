;;;; SPDX-License-Identifier: MIT
;;;; TuiAltScreen's wire encoding: the tui.alt calls it sends and the tui.alt.cb requests it answers (the contract of the Python SDK's
;;;; tests/test_tui_alt_screen.py). The host is a fake: the test thread records each tui.alt call the extension makes and answers it from a function,
;;;; and sends the host's callbacks (requests) while a call waits, as the real host does. A test that wants a callback sent runs it from the host side
;;;; with ALT-CB, which pumps one call through the host thread.
(in-package #:pig-tests)

(defvar *alt-thunk* nil "The function (lambda (ctx)) the alt command runs.")
(defvar *alt-result* nil)
(defvar *alt-calls* '() "(args . parent-request-id) of each tui.alt call, newest first.")
(defvar *alt-answer* nil "(lambda (args)) -> the result of a tui.alt call.")
(defvar *alt-host* nil)
(defvar *alt-ext* nil)
(defvar *alt-seq* 0)
(defvar *alt-action* nil "A function the host thread runs in place of answering the next pump call.")
(defvar *alt-action-value* nil)

(defun alt-extension ()
  (let ((ext (pig:make-extension "alt")))
    (pig:command ext "alt" "Alt" (lambda (ctx args) (declare (ignore args)) (setf *alt-result* (funcall *alt-thunk* ctx))))
    ext))

(defun alt-serve-until (host id)
  "Answer the extension's tui.alt calls until the response to request ID; that response."
  (loop
    (let ((frame (hread host)))
      (when (eq frame :eof) (error "end of file waiting for ~A" id))
      (let ((type (pig:jget frame "type")))
        (cond
          ((equal type "call")
           (let* ((call (pig:jget frame "call")) (args (pig:jget call "args"))
                  (pump (and *alt-action* (equal (pig:jget args "op") "requestRender"))))
             (unless (equal (pig:jget call "method") "tui.alt") (error "unexpected call ~A" (pig:jget call "method")))
             (unless pump (push (cons args (pig:jget call "parent_request_id")) *alt-calls*))
             (let ((result (if pump
                               (let ((action (shiftf *alt-action* nil))) (setf *alt-action-value* (funcall action)) (pig:obj))
                               (funcall *alt-answer* args))))
               (hsend host "type" "call_result" "id" (pig:jget frame "id") "call_result" (pig:obj "result" result)))))
          ((and (equal type "response") (equal (pig:jget frame "id") id)) (return (pig:jget frame "response"))))))))

(defun alt-callback (&rest args)
  "Send the host's tui.alt.cb request with the alternating ARGS and return its result (NIL for null), or (:error message) when the extension answered an
error; the extension's nested calls are answered meanwhile. Runs on the host thread."
  (let* ((id (format nil "cb~D" (incf *alt-seq*)))
         (response (progn (request *alt-host* id "tui.alt.cb" "args" (apply #'pig:obj args))
                          (alt-serve-until *alt-host* id)))
         (message (pig:jget (pig:jget response "error") "message")))
    (if message
        (list :error message)
        (let ((result (pig:jget response "result"))) (if (eq result :null) nil result)))))

(defun alt-host (screen function)
  "Run FUNCTION on the host thread (while the extension waits on a call to SCREEN) and return its value."
  (setf *alt-action* function)
  (pig:tui-alt-screen-request-render screen)
  *alt-action-value*)

(defun alt-cb (screen &rest args)
  "The host's tui.alt.cb request for SCREEN's first screen id t1 with ARGS; see ALT-CALLBACK."
  (alt-host screen (lambda () (apply #'alt-callback "id" "t1" args))))

(defun alt-run (thunk &optional (answer (lambda (args) (declare (ignore args)) (pig:obj))))
  "Run THUNK, (lambda (ctx)), in the alt command against a fake host that answers tui.alt calls with ANSWER; the calls (oldest first) and THUNK's value."
  (setf *alt-thunk* thunk *alt-answer* answer *alt-calls* '() *alt-result* nil *alt-action* nil *alt-ext* (alt-extension))
  (with-host (host *alt-ext*)
    (setf *alt-host* host)
    (request host "r" "command" "tool" "alt" "args" "")
    (sb-ext:with-timeout 30
      (let ((response (alt-serve-until host "r")))
        (let ((message (pig:jget (pig:jget response "error") "message")))
          (when message (error "alt command failed: ~A" message))))))
  (values (reverse *alt-calls*) *alt-result*))

(defun alt-terminal (&rest keys) (apply #'pig:make-tui-terminal (append keys (list :columns 20 :rows 6))))

(defun alt-lines (&rest lines)
  (pig:make-tui-component :render (lambda (width) (mapcar (lambda (line) (format nil "~A@~D" line width)) lines))))

(defun alt-arg (call key) (pig:jget (car call) key))
(defun alt-has (call key) (nth-value 1 (gethash key (car call))))
(defun alt-json (value) (pig:to-json value))
(defun alt-op (call) (alt-arg call "op"))
(defun alt-ops (calls) (mapcar #'alt-op calls))
(defun alt-find (op calls) (find op calls :key #'alt-op :test #'equal))

(deftest tui-alt-create-carries-the-options-and-the-terminal-block
  (let ((calls (alt-run (lambda (ctx)
                          (pig:make-tui-alt-screen ctx (alt-terminal) :show-hardware-cursor nil :mouse nil :wheel-scroll-lines :auto :copy-on-select t
                                                                      :copy-selection (lambda (text) (declare (ignore text)) t)
                                                                      :open-url (lambda (url) (declare (ignore url)) nil))
                          (pig:make-tui-alt-screen ctx (alt-terminal :kitty-protocol-active t))))))
    (check-equal 2 (length calls))
    (check-equal "{\"id\":\"t1\",\"op\":\"create\",\"showHardwareCursor\":false,\"options\":{\"wheelScrollLines\":\"auto\",\"mouse\":false,\"copyOnSelect\":true,\"callbacks\":[\"copySelection\",\"openUrl\"]},\"terminal\":{\"columns\":20,\"rows\":6,\"kitty\":false}}"
                 (alt-json (car (first calls))))
    (check-equal "{\"id\":\"t2\",\"op\":\"create\",\"terminal\":{\"columns\":20,\"rows\":6,\"kitty\":true}}" (alt-json (car (second calls))))
    (check-equal "r" (cdr (first calls)) "the create call is a child of the request that made it")))

(deftest tui-alt-every-call-reads-the-terminal-block-afresh
  (let* ((terminal (alt-terminal))
         (calls (alt-run (lambda (ctx)
                           (let ((screen (pig:make-tui-alt-screen ctx terminal)))
                             (setf (pig:tui-terminal-columns terminal) 100 (pig:tui-terminal-rows terminal) 30 (pig:tui-terminal-kitty-protocol-active terminal) t)
                             (pig:tui-alt-screen-render-now screen)
                             (eq terminal (pig:tui-alt-screen-terminal screen)))))))
    (check-equal "{\"columns\":20,\"rows\":6,\"kitty\":false}" (alt-json (alt-arg (first calls) "terminal")))
    (check-equal "{\"columns\":100,\"rows\":30,\"kitty\":true}" (alt-json (alt-arg (second calls) "terminal")))
    (check-equal t *alt-result* "the screen's terminal is the one it was made with")))

(deftest tui-alt-simple-ops-and-their-fields
  (let ((calls (alt-run (lambda (ctx)
                          (let ((screen (pig:make-tui-alt-screen ctx (alt-terminal))))
                            (pig:tui-alt-screen-start screen) (pig:tui-alt-screen-stop screen) (pig:tui-alt-screen-stop screen t)
                            (pig:tui-alt-screen-render-now screen) (pig:tui-alt-screen-render-now screen t)
                            (pig:tui-alt-screen-request-render screen t) (pig:tui-alt-screen-invalidate screen)
                            (pig:tui-alt-screen-scroll-by screen -2) (pig:tui-alt-screen-scroll-to-top screen) (pig:tui-alt-screen-scroll-to-bottom screen)
                            (pig:tui-alt-screen-flash screen "hi") (pig:tui-alt-screen-flash screen "hi" 500)
                            (pig:tui-alt-screen-set-wheel-scroll-lines screen 3) (pig:tui-alt-screen-set-wheel-scroll-lines screen :auto)
                            (pig:tui-alt-screen-set-copy-on-select screen nil) (pig:tui-alt-screen-set-show-hardware-cursor screen t)
                            (pig:tui-alt-screen-set-clear-on-shrink screen t) (pig:tui-alt-screen-reset-text-selection screen)
                            (pig:tui-alt-screen-set-terminal-color-scheme-notifications screen t) (pig:tui-alt-screen-hide-overlay screen)
                            (pig:tui-alt-screen-clear screen))))))
    (check-equal '("create" "start" "stop" "stop" "renderNow" "renderNow" "requestRender" "invalidate" "scrollBy" "scrollToTop" "scrollToBottom" "flash" "flash"
                   "setWheelScrollLines" "setWheelScrollLines" "setCopyOnSelect" "setShowHardwareCursor" "setClearOnShrink" "resetTextSelection"
                   "setTerminalColorSchemeNotifications" "hideOverlay" "clear")
                 (alt-ops calls))
    (flet ((field (n key) (alt-arg (nth n calls) key)))
      (check (not (alt-has (nth 2 calls) "preserveScreen")))
      (check-equal t (field 3 "preserveScreen"))
      (check (not (alt-has (nth 4 calls) "force")))
      (check-equal t (field 5 "force"))
      (check-equal t (field 6 "force"))
      (check-equal -2 (field 8 "lines"))
      (check-equal "hi" (field 11 "message"))
      (check (not (alt-has (nth 11 calls) "durationMs")))
      (check-equal 500 (field 12 "durationMs"))
      (check-equal 3 (field 13 "lines"))
      (check-equal "auto" (field 14 "lines"))
      (check-equal :false (field 15 "enabled"))
      (check-equal t (field 16 "enabled"))
      (check-equal t (field 17 "enabled"))
      (check-equal t (field 19 "enabled")))))

(deftest tui-alt-reads-come-from-one-state-call-each
  (multiple-value-bind (calls result)
      (alt-run (lambda (ctx)
                 (let* ((focus (pig:make-tui-component :render (lambda (width) (declare (ignore width)) (list "foc"))))
                        (screen (pig:make-tui-alt-screen ctx (alt-terminal))))
                   (pig:tui-alt-screen-set-focus screen focus)
                   (list (pig:tui-alt-screen-viewport-top screen) (pig:tui-alt-screen-following-output-p screen) (pig:tui-alt-screen-full-redraws screen)
                         (pig:tui-alt-screen-has-overlay-p screen) (pig:tui-alt-screen-has-overlay-entries-p screen)
                         (pig:tui-alt-screen-has-active-selection-p screen) (pig:tui-alt-screen-get-copy-on-select screen)
                         (pig:tui-alt-screen-get-show-hardware-cursor screen) (pig:tui-alt-screen-get-clear-on-shrink screen)
                         (eq focus (pig:tui-alt-screen-get-focused-component screen))
                         (pig:tui-alt-screen-mode screen) (pig:tui-alt-screen-viewport-tui-p screen))))
               (lambda (args)
                 (if (equal (pig:jget args "op") "state")
                     (pig:obj "viewportTop" 7 "isFollowingOutput" t "fullRedraws" 3 "hasOverlay" t "hasOverlayEntries" :false "hasActiveSelection" t
                              "copyOnSelect" t "showHardwareCursor" :false "clearOnShrink" t "focusedKey" "c1")
                     (pig:obj))))
    (check-equal 10 (count "state" (alt-ops calls) :test #'equal) "each read is one state call")
    (check-equal '(7 t 3 t nil t t nil t t "fullscreen" t) result)))

(deftest tui-alt-children-keys-and-caps
  (multiple-value-bind (calls result)
      (alt-run (lambda (ctx)
                 (let* ((screen (pig:make-tui-alt-screen ctx (alt-terminal)))
                        (plain (alt-lines "a"))
                        (full (pig:make-tui-component :render (lambda (w) (declare (ignore w)) nil) :handle-input (lambda (d) (declare (ignore d)))
                                                      :handle-mouse (lambda (e) (declare (ignore e)) nil) :focusable t :wants-key-release t)))
                   (pig:tui-alt-screen-add-child screen plain)
                   (pig:tui-alt-screen-add-child screen full)
                   (pig:tui-alt-screen-add-child screen plain)
                   (let ((three (length (pig:tui-alt-screen-children screen))))
                     (pig:tui-alt-screen-remove-child screen plain)
                     (pig:tui-alt-screen-remove-child screen (alt-lines "never added"))
                     (let ((after (pig:tui-alt-screen-children screen)))
                       (pig:tui-alt-screen-set-layout-root screen full)
                       (pig:tui-alt-screen-set-layout-root screen nil)
                       (pig:tui-alt-screen-clear screen)
                       (list three (length after) (eq full (first after)) (length (pig:tui-alt-screen-children screen))))))))
    (check-equal '(3 2 t 0) result)
    (check-equal '("create" "addChild" "addChild" "addChild" "removeChild" "setLayoutRoot" "setLayoutRoot" "clear") (alt-ops calls)
                 "a component never added is not removed")
    (check-equal "{\"input\":false,\"mouse\":false,\"focusable\":false,\"wantsKeyRelease\":false}" (alt-json (alt-arg (nth 1 calls) "caps")))
    (check-equal "{\"input\":true,\"mouse\":true,\"focusable\":true,\"wantsKeyRelease\":true}" (alt-json (alt-arg (nth 2 calls) "caps")))
    (check-equal "c1" (alt-arg (nth 1 calls) "key"))
    (check-equal "c2" (alt-arg (nth 2 calls) "key"))
    (check-equal "c1" (alt-arg (nth 3 calls) "key") "the same object keeps its key")
    (check-equal "c1" (alt-arg (nth 4 calls) "key"))
    (check-equal "c2" (alt-arg (nth 5 calls) "key"))
    (check-equal :null (alt-arg (nth 6 calls) "key"))))

(deftest tui-alt-overlay-and-its-handle
  (multiple-value-bind (calls result)
      (alt-run (lambda (ctx)
                 (let* ((screen (pig:make-tui-alt-screen ctx (alt-terminal)))
                        (over (alt-lines "OVER")) (other (alt-lines "other"))
                        (handle (pig:tui-alt-screen-show-overlay screen over (pig:obj "width" 8 "anchor" "center" "nonCapturing" t))))
                   (pig:tui-alt-overlay-set-hidden handle t)
                   (let ((hidden (pig:tui-alt-overlay-hidden-p handle)) (focused (pig:tui-alt-overlay-focused-p handle))
                         (bounds (pig:tui-alt-overlay-get-bounds handle)))
                     (pig:tui-alt-overlay-focus handle)
                     (pig:tui-alt-overlay-unfocus handle)
                     (pig:tui-alt-overlay-unfocus handle :target nil)
                     (pig:tui-alt-screen-add-child screen other)
                     (pig:tui-alt-overlay-unfocus handle :target other)
                     (pig:tui-alt-overlay-hide handle)
                     (list hidden focused (and bounds (pig:jget bounds "width"))
                           (handler-case (progn (pig:tui-alt-screen-show-overlay screen over (pig:obj "bogus" 1)) :accepted) (error () :rejected))
                           (handler-case (pig:tui-alt-overlay-unfocus handle :target (alt-lines "stranger")) (error () :rejected))))))
               (lambda (args)
                 (if (equal (pig:jget args "op") "overlay")
                     (pig:obj "hidden" t "focused" :false "bounds" (pig:obj "row" 1 "col" 2 "width" 8 "height" 1))
                     (pig:obj))))
    (check-equal '(t nil 8 :rejected :rejected) result)
    (let ((show (alt-find "showOverlay" calls)))
      (check-equal "{\"width\":8,\"anchor\":\"center\",\"nonCapturing\":true}" (alt-json (alt-arg show "options")))
      (check (not (alt-has show "visible"))))
    (let ((controls (remove-if-not (lambda (call) (equal (alt-op call) "overlay")) calls)))
      (check-equal '("setHidden" "state" "state" "state" "focus" "unfocus" "unfocus" "unfocus" "hide") (mapcar (lambda (call) (alt-arg call "action")) controls))
      (check-equal t (alt-arg (first controls) "hidden"))
      (check (not (alt-has (nth 5 controls) "target")) "the default release carries no target")
      (check-equal :null (alt-arg (nth 6 controls) "target"))
      (check-equal "{\"key\":\"c2\"}" (alt-json (alt-arg (nth 7 controls) "target"))))))

(deftest tui-alt-overlay-visible-callback
  (let ((widths '()))
    (let ((calls (alt-run (lambda (ctx)
                            (let ((screen (pig:make-tui-alt-screen ctx (alt-terminal))))
                              (pig:tui-alt-screen-show-overlay screen (alt-lines "OVER") (pig:obj "visible" (lambda (w h) (push (cons w h) widths) (>= w 20))))
                              :shown))
                          (lambda (args)
                            (when (equal (pig:jget args "op") "showOverlay")
                              (setf (gethash "seen" args)
                                    (list (alt-callback "id" "t1" "kind" "visible" "key" "c1" "termWidth" 20 "termHeight" 6)
                                          (alt-callback "id" "t1" "kind" "visible" "key" "c1" "termWidth" 10 "termHeight" 3))))
                            (pig:obj)))))
      (check-equal '((10 . 3) (20 . 6)) widths)
      (let ((show (alt-find "showOverlay" calls)))
        (check-equal t (alt-arg show "visible"))
        (check (not (nth-value 1 (gethash "visible" (alt-arg show "options")))) "the function stays in this process")
        (check-equal '("{\"value\":true}" "{\"value\":false}") (mapcar #'alt-json (alt-arg show "seen")))))))

(deftest tui-alt-input-listeners
  (let* ((seen '())
         (calls (alt-run (lambda (ctx)
                           (let* ((screen (pig:make-tui-alt-screen ctx (alt-terminal)))
                                  (listener (lambda (data) (push data seen) (when (equal data "c") (list :consume t))))
                                  (remove (pig:tui-alt-screen-add-input-listener screen listener)))
                             (pig:tui-alt-screen-add-input-listener screen listener)
                             (funcall remove)
                             (pig:tui-alt-screen-remove-input-listener screen listener)
                             :done))
                         (lambda (args)
                           (when (equal (pig:jget args "op") "addInputListener")
                             (setf (gethash "heard" args)
                                   (list (alt-callback "id" "t1" "kind" "listener" "listenerId" "l1" "data" "c")
                                         (alt-callback "id" "t1" "kind" "listener" "listenerId" "l1" "data" "k")
                                         (alt-callback "id" "t1" "kind" "listener" "listenerId" "nope" "data" "k"))))
                           (pig:obj)))))
    (check-equal '("addInputListener" "removeInputListener") (remove-if-not (lambda (op) (search "InputListener" op)) (alt-ops calls))
                 "adding a listener twice, and removing one that is gone, change nothing")
    (check-equal '("k" "c") seen)
    (let ((add (alt-find "addInputListener" calls)))
      (check-equal "l1" (alt-arg add "listenerId"))
      (check-equal '("{\"consume\":true}" "{}" "{}") (mapcar #'alt-json (alt-arg add "heard"))))))

(deftest tui-alt-debug-color-scheme-and-late-colors
  (let ((debug 0) (schemes '()) (late '()))
    (multiple-value-bind (calls result)
        (alt-run (lambda (ctx)
                   (let ((screen (pig:make-tui-alt-screen ctx (alt-terminal))))
                     (pig:tui-alt-screen-set-on-debug screen (lambda () (incf debug)))
                     (alt-cb screen "kind" "debug")
                     (let ((unsubscribe (pig:tui-alt-screen-on-terminal-color-scheme-change screen (lambda (scheme) (push scheme schemes)))))
                       (alt-cb screen "kind" "colorScheme" "scheme" "dark")
                       (funcall unsubscribe)
                       (alt-cb screen "kind" "colorScheme" "scheme" "light"))
                     (let ((colors (pig:tui-alt-screen-query-terminal-colors screen 20 (lambda (colors) (push colors late)))))
                       (alt-cb screen "kind" "lateColors" "queryId" "q1" "colors" (pig:obj "foreground" (pig:obj "r" 1 "g" 2 "b" 3)))
                       (alt-cb screen "kind" "lateColors" "queryId" "q1" "colors" (pig:obj))
                       (pig:tui-alt-screen-set-on-debug screen nil)
                       (alt-cb screen "kind" "debug")
                       (alt-json colors))))
                 (lambda (args)
                   (if (equal (pig:jget args "op") "queryTerminalColors")
                       (pig:obj "colors" (pig:obj "background" (pig:obj "r" 9 "g" 8 "b" 7)))
                       (pig:obj))))
      (check-equal "{\"background\":{\"r\":9,\"g\":8,\"b\":7}}" result)
      (check-equal 1 debug)
      (check-equal '("dark") schemes "a listener that unsubscribed hears nothing")
      (check-equal 1 (length late) "a late reply is delivered once")
      (check-equal "{\"foreground\":{\"r\":1,\"g\":2,\"b\":3}}" (alt-json (first late)))
      (let ((query (alt-find "queryTerminalColors" calls)) (debug-calls (remove "setOnDebug" calls :key #'alt-op :test-not #'equal)))
        (check-equal 20 (alt-arg query "timeoutMs"))
        (check-equal t (alt-arg query "onLateReply"))
        (check-equal "q1" (alt-arg query "queryId"))
        (check-equal '(t :false) (mapcar (lambda (call) (alt-arg call "enabled")) debug-calls))))))

(deftest tui-alt-mouse-dispatch-and-results
  (multiple-value-bind (calls result)
      (alt-run (lambda (ctx)
                 (let ((screen (pig:make-tui-alt-screen ctx (alt-terminal))))
                   (list (pig:tui-alt-screen-handle-mouse screen (pig:make-mouse-event :type "wheel" :button "none" :width 20 :height 6 :wheel-delta 1))
                         (pig:tui-alt-screen-handle-mouse screen (pig:make-mouse-event :type "click" :button "left" :x 3 :y 1 :click-count 2)))))
               (lambda (args)
                 (if (equal (pig:jget args "op") "handleMouse")
                     (if (equal (pig:jget (pig:jget args "event") "type") "wheel")
                         (pig:obj "result" nil)
                         (pig:obj "result" (pig:obj "handled" t "capture" :false "focus" :false "render" :null)))
                     (pig:obj))))
    (check-equal '(nil (:handled t :capture nil :focus nil)) result)
    (check-equal "{\"type\":\"wheel\",\"button\":\"none\",\"x\":0,\"y\":0,\"screenX\":0,\"screenY\":0,\"width\":20,\"height\":6,\"shift\":false,\"alt\":false,\"ctrl\":false,\"wheelDelta\":1}"
                 (alt-json (alt-arg (nth 1 calls) "event")))
    (check-equal "{\"type\":\"click\",\"button\":\"left\",\"x\":3,\"y\":1,\"screenX\":0,\"screenY\":0,\"width\":0,\"height\":0,\"shift\":false,\"alt\":false,\"ctrl\":false,\"clickCount\":2}"
                 (alt-json (alt-arg (nth 2 calls) "event")))))

(deftest tui-alt-copy-selection-render-and-screen-lines
  (multiple-value-bind (calls result)
      (alt-run (lambda (ctx)
                 (let ((screen (pig:make-tui-alt-screen ctx (alt-terminal))))
                   (list (pig:tui-alt-screen-copy-active-selection-to-clipboard screen) (pig:tui-alt-screen-render screen 10)
                         (pig:tui-alt-screen-get-screen-lines screen))))
               (lambda (args)
                 (let ((op (pig:jget args "op")))
                   (cond ((equal op "copyActiveSelectionToClipboard") (pig:obj "value" t))
                         ((equal op "render") (pig:obj "lines" (vector "row 1 w=10" "row 2 w=10")))
                         ((equal op "getScreenLines") (pig:obj "lines" (vector "a" "b" "c")))
                         (t (pig:obj))))))
    (check-equal '(t ("row 1 w=10" "row 2 w=10") ("a" "b" "c")) result)
    (check-equal 10 (alt-arg (nth 2 calls) "width"))))

(deftest tui-alt-terminal-callbacks
  (let ((log '()) (on-input nil))
    (alt-run (lambda (ctx)
               (let* ((terminal (alt-terminal :start (lambda (input resize) (setf on-input input) (push (list :start (functionp resize)) log))
                                              :stop (lambda () (push :stop log))
                                              :drain-input (lambda (max idle) (push (list :drain max idle) log))
                                              :write (lambda (data) (push (list :write data) log))
                                              :move-by (lambda (n) (push (list :move-by n) log))
                                              :hide-cursor (lambda () (push :hide log)) :show-cursor (lambda () (push :show log))
                                              :clear-line (lambda () (push :clear-line log)) :clear-from-cursor (lambda () (push :clear-from log))
                                              :clear-screen (lambda () (push :clear-screen log))
                                              :set-title (lambda (title) (push (list :title title) log))
                                              :set-progress (lambda (active) (push (list :progress active) log))
                                              :set-program-status (lambda (status) (push (list :status (pig:jget status "state")) log))
                                              :restore-on-exit (lambda (before after) (push (list :restore before after) log))))
                      (screen (pig:make-tui-alt-screen ctx terminal)))
                 (flet ((cb (&rest fields) (apply #'alt-cb screen "kind" "terminal" fields)))
                   (cb "method" "start") (cb "method" "write" "data" "hello") (cb "method" "moveBy" "lines" -2) (cb "method" "hideCursor")
                   (cb "method" "showCursor") (cb "method" "clearLine") (cb "method" "clearFromCursor") (cb "method" "clearScreen")
                   (cb "method" "setTitle" "title" "T") (cb "method" "setProgress" "active" t)
                   (cb "method" "setProgramStatus" "status" (pig:obj "state" "working")) (cb "method" "restoreOnExit" "before" "b" "after" "a")
                   (cb "method" "drainInput" "maxMs" 100 "idleMs" 10) (cb "method" "stop")
                   (funcall on-input "typed")
                   (check (eq :error (first (cb "method" "bogus")))))
                 nil)))
    (check-equal '((:start t) (:write "hello") (:move-by -2) :hide :show :clear-line :clear-from :clear-screen (:title "T") (:progress t) (:status "working")
                   (:restore "b" "a") (:drain 100 10) :stop)
                 (reverse log))
    (let ((last (first *alt-calls*)))
      (check-equal '("input" "typed") (list (alt-op last) (alt-arg last "data")) "the on-input function the terminal received makes a tui.alt input call"))))

(deftest tui-alt-component-callbacks
  (let ((inputs '()) (focus '()) (invalidated 0) (full nil) (bare nil))
    (alt-run (lambda (ctx)
               (let ((screen (pig:make-tui-alt-screen ctx (alt-terminal))))
                 (setf full (pig:make-tui-component :render (lambda (width) (list (format nil "full@~D" width)))
                                                    :handle-input (lambda (data) (push data inputs))
                                                    :focusable t :on-focus (lambda (focused) (push focused focus))
                                                    :invalidate (lambda () (incf invalidated)))
                       bare (pig:make-tui-component :render (lambda (width) (declare (ignore width)) '())))
                 (pig:tui-alt-screen-add-child screen full)
                 (pig:tui-alt-screen-add-child screen bare)
                 (alt-cb screen "kind" "input" "key" "c1" "data" "x")
                 (alt-cb screen "kind" "input" "key" "c2" "data" "y")
                 (alt-cb screen "kind" "focus" "key" "c1" "focused" t)
                 (alt-cb screen "kind" "focus" "key" "c2" "focused" t)
                 (alt-cb screen "kind" "invalidate" "key" "c1")
                 (alt-cb screen "kind" "invalidate" "key" "c2")
                 nil)))
    (check-equal '("x") inputs "a component without a handler is not asked")
    (check-equal '(t) focus)
    (check-equal t (pig:tui-component-focused full))
    (check-equal nil (pig:tui-component-focused bare) "a component that is not focusable is not focused")
    (check-equal 1 invalidated)))

(deftest tui-alt-component-callback-results
  (let ((replies (progn
                   (alt-run (lambda (ctx)
                              (let* ((screen (pig:make-tui-alt-screen ctx (alt-terminal)))
                                     (full (pig:make-tui-component :render (lambda (width) (list (format nil "full@~D" width)))
                                                                   :handle-mouse (lambda (event) (when (equal (pig:mouse-event-type event) "click") (list :handled t :render nil)))))
                                     (bare (pig:make-tui-component :render (lambda (width) (declare (ignore width)) '()))))
                                (pig:tui-alt-screen-add-child screen full)
                                (pig:tui-alt-screen-add-child screen bare)
                                (mapcar (lambda (reply) (if (hash-table-p reply) (alt-json reply) reply))
                                        (list (alt-cb screen "kind" "render" "key" "c1" "width" 7)
                                              (alt-cb screen "kind" "render" "key" "c2" "width" 7)
                                              (alt-cb screen "kind" "input" "key" "c2" "data" "x")
                                              (alt-cb screen "kind" "mouse" "key" "c1" "event" (pig:obj "type" "click" "x" 4))
                                              (alt-cb screen "kind" "mouse" "key" "c1" "event" (pig:obj "type" "move"))
                                              (alt-cb screen "kind" "mouse" "key" "c2" "event" (pig:obj "type" "click"))
                                              (alt-cb screen "kind" "focus" "key" "c1" "focused" t)))))
                            )
                   *alt-result*)))
    (check-equal '("{\"lines\":[\"full@7\"]}" "{\"lines\":[]}" "{}" "{\"result\":{\"handled\":true,\"render\":false}}" "{\"result\":null}" "{\"result\":null}" "{}")
                 replies)))

(deftest tui-alt-callbacks-to-unknown-things-answer-an-error
  (let ((replies (progn
                   (alt-run (lambda (ctx)
                              (let ((screen (pig:make-tui-alt-screen ctx (alt-terminal))))
                                (list (alt-cb screen "kind" "render" "key" "c9" "width" 1)
                                      (alt-host screen (lambda () (alt-callback "id" "nope" "kind" "debug")))
                                      (alt-cb screen "kind" "bogus")))))
                   *alt-result*)))
    (check-equal '(:error :error :error) (mapcar #'first replies))
    (check-equal "unknown component c9" (second (first replies)))
    (check-equal "unknown TuiAltScreen nope" (second (second replies)))))

(deftest tui-alt-option-callbacks
  (let ((opened '()) (pasted 0))
    (let ((calls (alt-run (lambda (ctx)
                            (let ((screen (pig:make-tui-alt-screen ctx (alt-terminal)
                                                                   :copy-selection (lambda (text) (cond ((equal text "ok") t) ((equal text "bad") "no clipboard") (t nil)))
                                                                   :open-url (lambda (url) (push url opened)) :on-right-click-paste (lambda () (incf pasted))
                                                                   :search-match-style (lambda (text) (format nil "[~A]" text))
                                                                   :search-current-match-style (lambda (text) (format nil "<~A>" text))
                                                                   :search-navigation-button-style (lambda (text hovered) (format nil "~A~A" text (if hovered "!" "")))
                                                                   :scroll-to-end-indicator (lambda () "END"))))
                              (flet ((option (name &rest arguments)
                                       (let ((reply (alt-cb screen "kind" "option" "name" name "args" (coerce arguments 'simple-vector))))
                                         (if (hash-table-p reply) (alt-json reply) reply))))
                                (list (option "copySelection" "ok") (option "copySelection" "bad") (option "copySelection" "other")
                                      (option "openUrl" "http://x") (option "onRightClickPaste")
                                      (option "searchMatchStyle" "m") (option "searchCurrentMatchStyle" "c")
                                      (option "searchNavigationButtonStyle" "n" t) (option "searchNavigationButtonStyle" "n" :false) (option "scrollToEndIndicator"))))))))
      (check-equal '("{\"value\":true}" "{\"value\":\"no clipboard\"}" "{\"value\":false}" "{\"value\":null}" "{\"value\":null}" "{\"value\":\"[m]\"}"
                     "{\"value\":\"<c>\"}" "{\"value\":\"n!\"}" "{\"value\":\"n\"}" "{\"value\":\"END\"}")
                   *alt-result*)
      (check-equal '("http://x") opened)
      (check-equal 1 pasted)
      (check-equal "[\"copySelection\",\"openUrl\",\"searchMatchStyle\",\"searchCurrentMatchStyle\",\"searchNavigationButtonStyle\",\"scrollToEndIndicator\",\"onRightClickPaste\"]"
                   (alt-json (pig:jget (alt-arg (first calls) "options") "callbacks"))))))

(deftest tui-alt-calls-from-frame-callbacks-say-so
  (let ((seen '()) (screen nil) (other nil))
    (let ((calls (alt-run (lambda (ctx)
                            (setf screen (pig:make-tui-alt-screen ctx (alt-terminal)
                                                                  :search-match-style (lambda (text) (push (pig:tui-alt-screen-has-overlay-p screen) seen) text))
                                  other (pig:make-tui-alt-screen ctx (alt-terminal)))
                            (let ((doc (pig:make-tui-component :render (lambda (width) (declare (ignore width))
                                                                         (push (pig:tui-alt-screen-viewport-top screen) seen)
                                                                         (list "row"))
                                                               :handle-input (lambda (data) (declare (ignore data)) (pig:tui-alt-screen-scroll-by screen 1))))
                                  (outer (pig:make-tui-component :render (lambda (width) (declare (ignore width))
                                                                           (push (pig:tui-alt-screen-viewport-top other) seen)
                                                                           (list "x")))))
                              (pig:tui-alt-screen-add-child screen doc)
                              (pig:tui-alt-screen-add-child other outer)
                              (alt-cb screen "kind" "render" "key" "c1" "width" 5)
                              (alt-cb screen "kind" "option" "name" "searchMatchStyle" "args" (vector "m"))
                              (alt-cb screen "kind" "input" "key" "c1" "data" "x")
                              (alt-host screen (lambda () (alt-callback "id" "t2" "kind" "render" "key" "c1" "width" 5)))
                              (pig:tui-alt-screen-viewport-top screen)))
                          (lambda (args) (if (equal (pig:jget args "op") "state") (pig:obj "viewportTop" 4) (pig:obj))))))
      (check-equal '(4 nil 4) (reverse seen) "the screens' reads from inside a callback are answered")
      (let ((states (remove "state" (remove "scrollBy" calls :key #'alt-op :test #'equal) :key #'alt-op :test-not #'equal))
            (scroll (alt-find "scrollBy" calls))
            (outside (car (last (remove "state" calls :key #'alt-op :test-not #'equal)))))
        (check-equal 4 (length states) "three reads from callbacks and the one outside")
        (check (notany (lambda (call) (alt-has call "inFrame")) calls) "no call carries an inFrame field: the parent request is the signal")
        (check-equal '("t1" "t1" "t2") (mapcar (lambda (call) (alt-arg call "id")) (subseq states 0 3)))
        (check (every (lambda (call) (and (stringp (cdr call)) (search "cb" (cdr call)))) (subseq states 0 3)) "a call made inside a callback is a child of its request")
        (check (and (stringp (cdr scroll)) (search "cb" (cdr scroll))) "an input handler's call is a child of its request")
        (check-equal "" (or (cdr outside) "") "a call from outside any callback is the extension's own")))))

(deftest tui-alt-a-callback-is-answered-while-an-on-loaded-handler-runs
  (let ((ext (pig:make-extension "alt-loaded")) (started nil) (top nil))
    (pig:on-loaded ext (lambda (ctx)
                         (let ((screen (pig:make-tui-alt-screen ctx (pig:make-tui-terminal :columns 20 :rows 6 :start (lambda (input resize) (declare (ignore input resize)) (setf started t))))))
                           (pig:tui-alt-screen-start screen)
                           (setf top (pig:tui-alt-screen-viewport-top screen)))))
    (setf *alt-calls* '() *alt-action* nil *alt-answer* (lambda (args) (if (equal (pig:jget args "op") "state") (pig:obj "viewportTop" 5) (pig:obj))))
    (with-host (host ext)
      (setf *alt-host* host)
      (sb-ext:with-timeout 30
        (flet ((serve-one (during)
                 (let ((frame (hread-type host "call")))
                   (when during (funcall during))
                   (hsend host "type" "call_result" "id" (pig:jget frame "id")
                               "call_result" (pig:obj "result" (funcall *alt-answer* (pig:jget (pig:jget frame "call") "args"))))
                   (pig:jget (pig:jget frame "call") "args"))))
          (check-equal "create" (pig:jget (serve-one nil) "op"))
          (check-equal "start" (pig:jget (serve-one (lambda () (alt-callback "id" "t1" "kind" "terminal" "method" "start"))) "op")
                       "the host's callback is answered while the on-loaded handler waits on its start call")
          (check-equal "state" (pig:jget (serve-one nil) "op"))
          (sleep 0.2)
          (check-equal t started)
          (check-equal 5 top))))))

(deftest tui-alt-the-connection-ending-ends-the-screens
  (alt-run (lambda (ctx) (pig:make-tui-alt-screen ctx (alt-terminal)) nil))
  (check (null (pig::tas-find *alt-ext* "t1")))
  (check-error pig:host-call-error (pig:make-tui-alt-screen (pig::make-ctx *alt-ext*) (alt-terminal))))
