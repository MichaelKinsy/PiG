;;;; The session graph (session manager, settings manager, resource loader, package manager, trust store, host info) against the fake host.
(in-package #:pig-tests)

(defun graph-drive (body answer)
  "Run BODY, a function of the context, in a command handler; ANSWER (lambda (method args)) is the result of each host call. Returns the calls as (method . args), in order, and BODY's value."
  (let ((ext (pig:make-extension "graph")) (calls '()) (value nil) (failure nil))
    (pig:command ext "run" "Run" (lambda (ctx args) (declare (ignore args))
                                   (handler-case (setf value (funcall body ctx))
                                     (error (e) (setf failure (princ-to-string e))))))
    (with-host (host ext)
      (request host "r" "command" "tool" "run" "args" "")
      (loop (let ((frame (hread host)))
              (when (eq frame :eof) (error "end of file"))
              (cond ((equal (pig:jget frame "type") "call")
                     (let ((call (pig:jget frame "call")))
                       (push (cons (pig:jget call "method") (pig:jget call "args")) calls)
                       (hsend host "type" "call_result" "id" (pig:jget frame "id")
                                   "call_result" (pig:obj "result" (funcall answer (pig:jget call "method") (pig:jget call "args"))))))
                    ((equal (pig:jget frame "type") "response") (return))))))
    (when failure (error "graph-drive: ~A" failure))
    (values (nreverse calls) value)))

(defun graph-answer (method args)
  (declare (ignore args))
  (if (equal method "sessionGraph.new") (pig:obj "handle" "h1") nil))

(deftest graph-method-names-are-camel-case
  (check-equal "getDefaultModel" (pig::graph-camel "get-default-model"))
  (check-equal "getWebSocketConnectTimeoutMs" (pig::graph-camel "get-web-socket-connect-timeout-ms"))
  (check-equal "setMany" (pig::graph-camel "SET-MANY")))

(deftest session-manager-constructors-and-calls-use-the-graph-wire
  (let ((calls (graph-drive (lambda (ctx)
                              (let ((m (pig:sm-create ctx "/p" "/d" (pig:obj "id" "x"))))
                                (pig:sm-append-label-change m "e1" "l")
                                (pig:sm-get-branch m)
                                (pig:sm-find-by-id ctx "/p" "id")
                                (pig:sm-in-memory ctx "/p")
                                (pig:sm-open ctx "/f" nil "/o")))
                            #'graph-answer)))
    (check-equal '("sessionGraph.new" "sessionGraph.call" "sessionGraph.call" "sessionGraph.call" "sessionGraph.new" "sessionGraph.new")
                 (mapcar #'car calls))
    (let ((new (cdr (first calls))))
      (check-equal "SessionManager" (pig:jget new "kind"))
      (check-equal "create" (pig:jget new "op"))
      (check-equal "/p" (aref (pig:jget new "args") 0)))
    (let ((call (cdr (second calls))))
      (check-equal "h1" (pig:jget call "handle"))
      (check-equal "appendLabelChange" (pig:jget call "method"))
      (check-equal "l" (aref (pig:jget call "args") 1)))
    (check-equal "getBranch" (pig:jget (cdr (third calls)) "method"))
    (let ((static (cdr (fourth calls))))
      (check-equal "SessionManager" (pig:jget static "kind"))
      (check-equal "findById" (pig:jget static "method"))
      (check (null (pig:jget static "handle"))))
    (check-equal "inMemory" (pig:jget (cdr (fifth calls)) "op"))
    (check-equal "/o" (aref (pig:jget (cdr (sixth calls)) "args") 2))))

(deftest session-manager-lists-with-dates-as-epoch-milliseconds
  (check-equal 1767225600000 (pig::sm-iso-ms "2026-01-01T00:00:00.000Z"))
  (check-equal 1767225600123 (pig::sm-iso-ms "2026-01-01T00:00:00.123Z"))
  (let ((progress '()))
    (multiple-value-bind (calls value)
        (graph-drive (lambda (ctx) (pig:sm-list ctx "/p" "/d" (lambda (loaded total partial) (push (list loaded total partial) progress))))
                     (lambda (method args) (declare (ignore args))
                       (if (equal method "sessionGraph.async")
                           (pig:arr (pig:obj "id" "s" "created" "2026-01-01T00:00:00.000Z" "modified" "2026-01-01T00:00:01.000Z"))
                           nil)))
      (check-equal "sessionGraph.async" (car (first calls)))
      (check-equal "cb1" (aref (pig:jget (cdr (first calls)) "args") 2))
      (check-equal 1767225601000 (pig:jget (aref value 0) "modified"))
      (check-equal 1767225600000 (pig:jget (aref value 0) "created")))))

(deftest graph-callbacks-answer-the-hosts-requests
  (let ((seen nil) (ext (pig:make-extension "graph")))
    (pig:command ext "run" "Run" (lambda (ctx args) (declare (ignore args))
                                   (check-equal "cb1" (pig::graph-callback-id ctx (lambda (&rest values) (setf seen values) "answer")))
                                   (check (null (pig::graph-callback-id ctx nil)))))
    (with-host (host ext)
      (request host "r" "command" "tool" "run" "args" "")
      (hread-type host "response")
      (request host "cb" "sessionGraph.callback" "args" (pig:obj "id" "cb1" "args" (pig:arr 1 :null "x")))
      (check-equal "answer" (pig:jget (pig:jget (hread-type host "response") "response") "result"))
      (check-equal '(1 nil "x") seen)
      (request host "cb2" "sessionGraph.callback" "args" (pig:obj "id" "nope" "args" (pig:arr)))
      (check-equal "unknown session graph callback nope"
                   (pig:jget (pig:jget (pig:jget (hread-type host "response") "response") "error") "message")))))

(deftest settings-manager-booleans-and-drain-errors
  (multiple-value-bind (calls value)
      (graph-drive (lambda (ctx)
                     (let ((s (pig:settings-in-memory ctx)))
                       (pig:settings-set-hide-thinking-block s nil)
                       (pig:settings-set-block-images s t)
                       (list (pig:settings-get-block-images s) (pig:settings-drain-errors s) (pig:settings-reload s))))
                   (lambda (method args)
                     (cond ((equal method "sessionGraph.new") (pig:obj "handle" "h1"))
                           ((equal (pig:jget args "method") "getBlockImages") :false)
                           (t nil))))
    (check-equal :false (aref (pig:jget (cdr (second calls)) "args") 0) "a nil boolean is sent as false")
    (check-equal t (aref (pig:jget (cdr (third calls)) "args") 0))
    (check-equal '(nil #() nil) value)
    (check-equal "sessionGraph.async" (car (sixth calls)))))

(deftest settings-storage-callback-runs-with-lock-across-begin-and-finish
  (let* ((store (make-hash-table :test 'equal)) (callback nil) (log '()))
    (setf (gethash "global" store) "{\"a\":1}")
    (setf callback (pig::settings-storage-callback
                    (lambda (scope fn)
                      (push scope log)
                      (let ((next (funcall fn (gethash scope store))))
                        (when next (setf (gethash scope store) next))))))
    (check-equal "{\"a\":1}" (pig:jget (funcall callback "begin" "global") "current"))
    (check (null (funcall callback "finish" (pig:obj "write" t "text" "{\"a\":2}"))))
    (check-equal "{\"a\":2}" (gethash "global" store))
    (check (null (pig:jget (funcall callback "begin" "project") "current")))
    (funcall callback "finish" (pig:obj "write" :false))
    (check (null (gethash "project" store)))
    (funcall callback "begin" "global")
    (check-error error (funcall callback "finish" (pig:obj "error" "boom")))
    (check-equal '("global" "project" "global") (reverse log))
    (check-error error (funcall callback "finish" (pig:obj)))
    (check-error error (funcall (pig::settings-storage-callback (lambda (scope fn) (declare (ignore scope fn)) nil)) "begin" "global"))))

(deftest resource-loader-sends-its-options-and-refuses-the-unserved
  (let ((calls (graph-drive (lambda (ctx)
                              (let ((l (pig:make-resource-loader ctx :cwd "/p" :agent-dir "/a" :no-skills t :append-system-prompt (list "x")
                                                                      :system-prompt-override (lambda (base) base))))
                                (pig:loader-reload l :resolve-project-trust (lambda (r) (declare (ignore r)) t))
                                (pig:loader-extend-resources l (pig:obj))
                                (check-error pig:unsupported-capability (pig:make-resource-loader ctx :extensions-override (lambda (x) x)))))
                            #'graph-answer)))
    (let ((wire (aref (pig:jget (cdr (first calls)) "args") 0)))
      (check-equal "/p" (pig:jget wire "cwd"))
      (check-equal t (pig:jget wire "noSkills"))
      (check-equal :false (pig:jget wire "noThemes"))
      (check-equal "cb1" (pig:jget wire "systemPromptOverride"))
      (check (null (pig:jget wire "skillsOverride"))))
    (check-equal "reload" (pig:jget (cdr (second calls)) "method"))
    (check-equal "sessionGraph.async" (car (second calls)))
    (check-equal "cb2" (pig:jget (aref (pig:jget (cdr (second calls)) "args") 0) "resolveProjectTrust"))))

(deftest package-manager-sends-scope-options
  (let ((calls (graph-drive (lambda (ctx)
                              (let ((pm (pig:make-package-manager ctx :cwd "/p" :agent-dir "/a" :settings-manager (pig:settings-in-memory ctx))))
                                (pig:pkgmgr-add-source-to-settings pm "s")
                                (pig:pkgmgr-install pm "s" t)
                                (pig:pkgmgr-resolve-extension-sources pm (list "s") nil t)
                                (pig:pkgmgr-update pm)))
                            #'graph-answer)))
    (check-equal "h1" (pig:jget (aref (pig:jget (cdr (second calls)) "args") 0) "settingsManager"))
    (check-equal :false (pig:jget (aref (pig:jget (cdr (third calls)) "args") 1) "local"))
    (check-equal "install" (pig:jget (cdr (fourth calls)) "method"))
    (check-equal t (pig:jget (aref (pig:jget (cdr (fourth calls)) "args") 1) "local"))
    (check-equal t (pig:jget (aref (pig:jget (cdr (fifth calls)) "args") 1) "temporary"))
    (check-equal "update" (pig:jget (cdr (sixth calls)) "method"))))

(deftest trust-store-calls-and-has-trust-requiring-project-resources
  (multiple-value-bind (calls value)
      (graph-drive (lambda (ctx)
                     (let ((store (pig:make-project-trust-store ctx "/a")))
                       (pig:trust-store-set store "/p" :false)
                       (pig:trust-store-set-many store (pig:arr (pig:obj "path" "/p" "decision" nil)))
                       (list (pig:trust-store-get store "/p") (pig:trust-store-get-entry store "/p")
                             (pig:has-trust-requiring-project-resources ctx "/p"))))
                   (lambda (method args)
                     (cond ((equal method "sessionGraph.new") (pig:obj "handle" "h1"))
                           ((equal (pig:jget args "method") "get") :false)
                           ((equal (pig:jget args "method") "hasTrustRequiringProjectResources") t)
                           (t nil))))
    (check-equal "ProjectTrustStore" (pig:jget (cdr (first calls)) "kind"))
    (check-equal :false (aref (pig:jget (cdr (second calls)) "args") 1))
    (check-equal '(:false nil t) value)
    (check-equal "hasTrustRequiringProjectResources" (pig:jget (cdr (sixth calls)) "method"))))

(defun with-host-info (value body)
  (let ((old (sb-posix:getenv "PIG_EXT_HOST_INFO")))
    (unwind-protect (progn (if value (sb-posix:setenv "PIG_EXT_HOST_INFO" value 1) (sb-posix:unsetenv "PIG_EXT_HOST_INFO")) (funcall body))
      (if old (sb-posix:setenv "PIG_EXT_HOST_INFO" old 1) (sb-posix:unsetenv "PIG_EXT_HOST_INFO")))))

(deftest host-info-reads-the-hosts-environment-entry
  (with-host-info "{\"agentDir\":\"/home/u/.pig/agent\",\"configDirName\":\".pig\",\"version\":\"1.1.0\",\"packageDir\":\"/opt/pig\",\"shell\":{\"shell\":\"/bin/bash\",\"args\":[\"-c\"]}}"
    (lambda ()
      (check-equal "/home/u/.pig/agent" (pig:host-agent-dir))
      (check-equal ".pig" (pig:host-config-dir-name))
      (check-equal "1.1.0" (pig:host-version))
      (check-equal "/opt/pig" (pig:host-package-dir))
      (let ((shell (pig:host-shell-config)))
        (check-equal "/bin/bash" (pig:shell-config-shell shell))
        (check-equal '("-c") (pig:shell-config-args shell))
        (check (null (pig:shell-config-command-transport shell))))
      (let ((shell (pig:host-shell-config "/bin/sh")))
        (check-equal "/bin/sh" (pig:shell-config-shell shell))
        (check-equal '("-c") (pig:shell-config-args shell)))
      (check-error error (pig:host-shell-config "/no/such/shell")))))

(deftest host-info-is-unavailable-without-a-host-that-provides-it
  (dolist (value '(nil "" "{bad" "[]"))
    (with-host-info value (lambda () (check-error pig:host-info-unavailable (pig:host-agent-dir))
                                      (check-error pig:host-info-unavailable (pig:host-version)))))
  (with-host-info "{\"version\":\"1\"}"
    (lambda () (check-error pig:host-info-unavailable (pig:host-agent-dir))
      (check-error pig:host-info-unavailable (pig:host-package-dir))
      (check-error pig:host-info-unavailable (pig:host-shell-config))))
  (with-host-info "{\"shell\":{\"error\":\"no bash\"}}"
    (lambda () (check-error error (pig:host-shell-config)))))

(deftest legacy-wsl-bash-paths-use-stdin
  (check (pig::host-legacy-wsl-bash-p "C:\\Windows\\System32\\bash.exe"))
  (check (pig::host-legacy-wsl-bash-p "d:/windows/sysnative/bash.exe"))
  (check (not (pig::host-legacy-wsl-bash-p "C:\\Windows\\System32\\cmd.exe")))
  (check (not (pig::host-legacy-wsl-bash-p "1:\\windows\\system32\\bash.exe"))))
