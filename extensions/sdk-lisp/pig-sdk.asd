;;;; SPDX-License-Identifier: MIT
;;;; ASDF system of the PiG Common Lisp extension SDK. It depends on nothing
;;;; but the SBCL contribs that ship with SBCL.

(asdf:defsystem "pig-sdk"
  :description "Write PiG extensions in Common Lisp (SBCL)."
  :license "MIT"
  :depends-on ("sb-bsd-sockets" "sb-posix")
  :serial t
  :pathname "src/"
  :components ((:file "package")
               (:file "errors")
               (:file "diagnostic")
               (:file "json")
               (:file "wire")
               (:file "extension")
               (:file "context")
               (:file "hooks")
               (:file "dispatch")
               (:file "context-extra")
               (:file "tool-order")
               (:file "host-helper")
               (:file "type-schema")
               (:file "type-engine")
               (:file "tool-schema")
               (:file "pi-ai")
               (:file "tui-tables")
               (:file "tui-width")
               (:file "tui-text")
               (:file "tui-fuzzy")
               (:file "tui-keys")
               (:file "tui-state")
               (:file "tui-keybindings")
               (:file "tui-terminal")
               (:file "tui-colors")
               (:file "tui-theme")
               (:file "compaction")
               (:file "truncate")
               (:file "coding-helpers")
               (:file "conversation")
               (:file "event-stream")
               (:file "model-stream")
               (:file "model-types")
               (:file "session-manager")
               (:file "settings-manager")
               (:file "resource-loader")
               (:file "package-manager")
               (:file "project-trust")
               (:file "host-info")
               (:file "model-runtime")
               (:file "create-provider")
               (:file "extension-runner")
               (:file "extension-factories")
               (:file "mcp-options")
               (:file "event-bus")
               (:file "builtin-tool")
               (:file "session-ops")
               (:file "child-session")
               (:file "agent-runtime")
               (:file "provider")
               (:file "oauth")
               (:file "renderer")
               (:file "virtual-model")
               (:file "mcp")
               (:file "kit")
               (:file "ui-custom")
               (:file "overlay")
               (:file "widgets")
               (:file "theme")
               (:file "editor-component")
               (:file "autocomplete")
               (:file "terminal-input")
               (:file "tui-alt-screen")
               (:file "runner")))

(asdf:defsystem "pig-sdk/tests"
  :depends-on ("pig-sdk")
  :serial t
  :pathname "tests/"
  :components ((:file "harness")
               (:file "json-tests")
               (:file "deep-tests")
               (:file "sdk-tests")
               (:file "core-tests")
                (:file "type-tests")
                (:file "tui-tests")
                (:file "coding-tests")
                (:file "model-tests")
                (:file "graph-tests")
                (:file "runtime-tests")
                (:file "session-tests")
                (:file "provider-tests")
                (:file "ui-tests")
                (:file "editor-tests")
                (:file "tui-alt-tests")
                )
  :perform (asdf:test-op (op c) (declare (ignore op c)) (uiop:symbol-call :pig-tests :run-all)))
