;;;; The Lisp scenario driver: it registers, through the Lisp SDK's public API, the extension the
;;;; scenario Spec describes (sdkscenarios.Spec). The Go, Node, Python and Rust drivers read the same
;;;; file and do the same, so one scenario table exercises every SDK. Keep it a straight reading of
;;;; the Spec: behavior belongs in the scenario, not here.

(defpackage "scenario-driver" (:use "COMMON-LISP"))
(in-package "scenario-driver")

(defun read-file-octets (path)
  (with-open-file (in path :element-type '(unsigned-byte 8))
    (let ((buffer (make-array (file-length in) :element-type '(unsigned-byte 8))))
      (read-sequence buffer in)
      buffer)))

(defun write-file (path text)
  (with-open-file (out path :direction :output :if-exists :supersede :external-format :utf-8)
    (write-string text out)))

(defun append-line (path line)
  (with-open-file (out path :direction :output :if-exists :append :if-does-not-exist :create :external-format :utf-8)
    (write-string line out)
    (write-char #\Newline out)))

(defun mark (name)
  "Record that a tool or command started, for the harness to wait on."
  (with-open-file (out (concatenate 'string ".started-" name) :direction :output :if-exists :supersede) (declare (ignore out))))

(defvar *recorded* 0 "the record-counted lines this process wrote")
(defvar *footer-subscribed* nil)

(defun json-text (value) (pig:to-json value))

(defun word-char-p (char) (or (alphanumericp char) (char= char #\_)))

(defun substitute-text (text variables)
  "A \"${name}\" in TEXT is the answer of the prompt kept as name."
  (with-output-to-string (out)
    (let ((i 0))
      (loop while (< i (length text))
            do (let* ((close (and (char= (char text i) #\$) (< (1+ i) (length text)) (char= (char text (1+ i)) #\{)
                                  (position #\} text :start (+ i 2))))
                      (name (and close (plusp (- close i 2)) (subseq text (+ i 2) close))))
                 (if (and name (every #'word-char-p name))
                     (progn (write-string (or (gethash name variables) "") out) (setf i (1+ close)))
                     (progn (write-char (char text i) out) (incf i))))))))

(defun substitute-variables (value variables)
  (cond ((stringp value) (substitute-text value variables))
        ((vectorp value) (map 'simple-vector (lambda (item) (substitute-variables item variables)) value))
        ((hash-table-p value)
         (let ((copy (make-hash-table :test 'equal)))
           (maphash (lambda (key item) (setf (gethash key copy) (substitute-variables item variables))) value)
           copy))
        (t value)))

(defun run-flow (flow interaction &optional options)
  (let ((variables (make-hash-table :test 'equal)))
    (loop for step across (or (pig:jget flow "steps") #())
          do (let ((as (let ((a (pig:jget step "as"))) (if (stringp a) a ""))))
               (cond ((eq (pig:jget step "deviceId") t)
                      (let ((get (and options (pig:login-options-get-device-id options))))
                        (setf (gethash as variables) (if get (funcall get) "<none>"))))
                     ((stringp (pig:jget step "notify"))
                      (funcall (pig:auth-interaction-notify interaction)
                               (substitute-variables (pig:from-json (pig:jget step "notify")) variables)))
                     (t (setf (gethash as variables)
                              (funcall (pig:auth-interaction-prompt interaction) (pig:from-json (pig:jget step "prompt"))))))))
    (substitute-variables (pig:from-json (pig:jget flow "result")) variables)))

(defun provider-object (provider)
  (let* ((id (pig:jget provider "id")) (name (pig:jget provider "name"))
         (zero (pig:obj "input" 0 "output" 0 "cacheRead" 0 "cacheWrite" 0))
         (model (pig:obj "id" (concatenate 'string id "-model") "name" (concatenate 'string name " model") "provider" id
                         "api" "openai-completions" "baseUrl" "http://127.0.0.1:9" "reasoning" :false "input" (vector "text")
                         "cost" zero "contextWindow" 4000 "maxTokens" 100))
         (api-key nil) (oauth nil))
    (flet ((unused (model context options) (declare (ignore model context options)) (error "the scenario provider streams nothing"))
           (resolve (input)
             (let ((key (let ((credential (pig:api-key-auth-input-credential input))) (and credential (pig:jget credential "key")))))
               (and (stringp key) (plusp (length key))
                    (pig:make-auth-result :auth (pig:obj "apiKey" (concatenate 'string "resolved-" key)) :source "stored credential")))))
      (let ((spec (pig:jget provider "apiKey")))
        (when (hash-table-p spec)
          (let ((login (pig:jget spec "login")) (source (pig:jget spec "checkSource")))
            (setf api-key (pig:make-api-key-auth
                           :name (pig:jget spec "name") :resolve #'resolve
                           :check (and (stringp source) (plusp (length source))
                                       (lambda (input) (declare (ignore input)) (pig:make-auth-check :type "api_key" :source source)))
                           :login (and (hash-table-p login) (lambda (interaction) (run-flow login interaction))))))))
      (let ((spec (pig:jget provider "oauth")))
        (when (hash-table-p spec)
          (let ((refresh (let ((text (pig:jget spec "refresh"))) (if (and (stringp text) (plusp (length text))) (pig:from-json text) (pig:obj)))))
            (setf oauth (pig:make-oauth-auth
                         :name (pig:jget spec "name")
                         :login (lambda (interaction options) (run-flow (pig:jget spec "login") interaction options))
                         :refresh (lambda (credential signal)
                                    (declare (ignore signal))
                                    (let ((merged (make-hash-table :test 'equal)))
                                      (maphash (lambda (k v) (setf (gethash k merged) v)) credential)
                                      (maphash (lambda (k v) (setf (gethash k merged) v)) refresh)
                                      merged))
                         :to-auth (lambda (credential) (pig:obj "apiKey" (pig:jget credential "access")))
                         :is-subscription (and (eq (pig:jget spec "subscription") t) t)
                         :login-label (let ((label (pig:jget spec "loginLabel"))) (and (stringp label) (plusp (length label)) label)))))))
      (pig:make-provider :id id :name name :auth (pig:make-provider-auth :api-key api-key :oauth oauth)
                         :get-models (lambda () (list model)) :stream #'unused :stream-simple #'unused))))

(defun tool-runner (tool)
  (let ((behavior (pig:jget tool "behavior")) (name (pig:jget tool "name")))
    (lambda (ctx params)
      (cond
        ((equal behavior "echo") (pig:obj "content" (concatenate 'string "echo:" (let ((text (pig:jget params "text"))) (if (stringp text) text "")))))
        ((equal behavior "fail") (error "boom"))
        ((equal behavior "crash") (error 'type-error :datum "tool crash" :expected-type 'null))
        ((equal behavior "details")
         (pig:obj "content" "with details" "details" (pig:obj "count" 2 "nested" (pig:obj "a" (vector 1 2)))))
        ((equal behavior "soft-error") (pig:tool-result "soft failure" :is-error t))
        ((equal behavior "bad-text")
         (pig:obj "content" (vector (pig:obj "type" "text" "text" (concatenate 'string "a" (string (code-char #xD83D)) "b")))))
        ((equal behavior "empty") (pig:obj "content" (vector)))
        ((equal behavior "blocks")
         (pig:obj "content" (vector (pig:obj "type" "text" "text" "a") (pig:obj "type" "text" "text" "b"))))
        ((equal behavior "cooperative")
         (mark name)
         (loop until (pig:ctx-cancelled-p ctx) do (sleep 0.01))
         (pig:obj "content" "cooperative stopped"))
        ((equal behavior "hang") (mark name) (loop (sleep 3600)))
        (t (error "unknown tool behavior ~A" behavior))))))

(defun register-tool (ext tool)
  (let ((schema (let ((text (pig:jget tool "schema")))
                  (if (and (stringp text) (plusp (length text)))
                      (pig:from-json text)
                      (pig:obj "type" "object" "properties" (pig:obj "text" (pig:obj "type" "string")))))))
    (pig:tool ext (pig:jget tool "name") (pig:jget tool "description") schema (tool-runner tool))))

(defun query (ctx name)
  (cond ((equal name "idle") (if (pig:ctx-is-idle-p ctx) t :false))
        ((equal name "pending") (if (pig:ctx-has-pending-messages-p ctx) t :false))
        ((equal name "system-prompt") (pig:ctx-get-system-prompt ctx))
        ((equal name "thinking") (pig:ctx-get-thinking-level ctx))
        ((equal name "all-tools")
         (map 'simple-vector (lambda (tool) (pig:obj "name" (pig:jget tool "name") "description" (pig:jget tool "description")))
              (pig:ctx-get-all-tools ctx)))
        ((equal name "session-header")
         (let ((header (pig:session-get-header (pig:ctx-session-manager ctx))))
           (pig:obj "type" (pig:jget header "type") "id" (pig:jget header "id") "cwd" (pig:jget header "cwd"))))
        ((equal name "leaf-entry")
         (let ((entry (pig:session-get-leaf-entry (pig:ctx-session-manager ctx))))
           (pig:obj "type" (pig:jget entry "type") "id" (pig:jget entry "id"))))
        ((equal name "session-manager-id") (pig:session-get-session-id (pig:ctx-session-manager ctx)))
        (t (error "unknown query ~A" name))))

(defun split-colon (text)
  (let ((colon (position #\: text)))
    (values (subseq text 0 colon) (subseq text (1+ colon)))))

(defun registry-query (ctx arg)
  (multiple-value-bind (query provider) (split-colon arg)
    (let ((registry (pig:ctx-model-registry ctx)))
      (cond ((equal query "has-auth")
             (if (pig:registry-has-configured-auth registry (pig:obj "provider" provider "id" "m")) t :false))
            ((equal query "using-oauth")
             (if (pig:registry-is-using-oauth registry (pig:obj "provider" provider "id" "m")) t :false))
            ((equal query "provider-name") (pig:registry-get-provider-name registry provider))
            (t (error "unknown registry query ~A" query))))))

(defun perform-action (ctx name)
  (cond ((equal name "abort") (pig:ctx-abort ctx))
        ((equal name "shutdown") (pig:ctx-shutdown ctx))
        ((equal name "compact") (pig:ctx-compact ctx :custom-instructions "be brief"))
        (t (error "unknown action ~A" name))))

(defun footer-data (ctx path)
  (let ((data (pig:ctx-footer-data ctx)))
    (unless *footer-subscribed*
      (setf *footer-subscribed* t)
      (pig:footer-on-branch-change data (lambda () (append-line ".branch-changes" (let ((b (pig:footer-get-git-branch data))) (if b b "None")))))
      (funcall (pig:footer-on-branch-change data (lambda () (append-line ".branch-changes" "unsubscribed-callback-ran")))))
    (write-file path (json-text (pig:obj "branch" (or (pig:footer-get-git-branch data) :null)
                                         "statuses" (pig:footer-get-extension-statuses data)
                                         "count" (pig:footer-get-available-provider-count data))))))

(defun late-register (ext kind)
  (cond ((equal kind "command")
         (pig:command ext "late-command" "Registered late" (lambda (ctx args) (declare (ignore ctx)) (write-file args "ran late"))))
        ((equal kind "shortcut")
         (pig:shortcut ext "ctrl+alt+l" "Registered late" (lambda (ctx) (declare (ignore ctx)) (write-file ".shortcut-fired" "late"))))
        ((equal kind "flag") (pig:flag ext "late-flag" :description "Registered late" :type "string" :default "late"))
        ((equal kind "message-renderer")
         (pig:message-renderer ext "late-type" (lambda (ctx message options width) (declare (ignore ctx message options width)) nil)))
        ((equal kind "entry-renderer")
         (pig:entry-renderer ext "late-type" (lambda (ctx entry options width) (declare (ignore ctx entry options width)) nil)))
        (t (error "unknown late registration ~A" kind))))

(defun register-command (ext command)
  (let ((op (pig:jget command "op")) (arg (let ((a (pig:jget command "arg"))) (if (stringp a) a ""))) (name (pig:jget command "name")))
    (pig:command
     ext name (pig:jget command "description")
     (lambda (ctx path)
       (cond
         ((equal op "noop") nil)
         ((equal op "error") (error "command boom"))
         ((equal op "crash") (error 'type-error :datum "command crash" :expected-type 'null))
         ((equal op "ping") (write-file path "pong"))
         ((equal op "echo") (write-file ".echo-args" path))
         ((equal op "footer-data") (footer-data ctx path))
         ((equal op "late-register") (late-register ext arg) (write-file path "registered"))
         ((equal op "registered-provider")
          (let ((provider (pig:registry-get-registered-native-provider (pig:ctx-model-registry ctx) arg)))
            (write-file path (if provider (pig:provider-name provider) "none"))))
         ((equal op "flag") (write-file path (json-text (or (pig:ctx-get-flag ctx arg) :null))))
         ((equal op "hang") (mark name) (loop (sleep 3600)))
         ((equal op "query") (write-file path (json-text (query ctx arg))))
         ((equal op "signal-wait")
          (mark name)
          (pig:abort-signal-wait (pig:ctx-signal ctx))
          (write-file path "signal aborted while running"))
         ((equal op "signal")
          (let ((signal (pig:ctx-signal ctx)))
            (write-file path (cond ((null signal) "none") ((pig:abort-signal-set-p signal) "aborted") (t "live")))))
         ((equal op "registry") (write-file path (json-text (registry-query ctx arg))))
         ((equal op "action") (perform-action ctx arg) (write-file path "called"))
         ((equal op "reload-stale")
          (pig:ctx-reload ctx)
          (write-file path (handler-case (progn (pig:ctx-cwd ctx) "cwd live")
                             (error (e) (concatenate 'string "cwd threw: " (princ-to-string e))))))
         (t (error "unknown command op ~A" op)))))))

(defun event-handler (op tag)
  (lambda (ctx data)
    (declare (ignorable ctx))
    (cond
      ((equal op "throw") (error "event boom"))
      ((equal op "crash") (error 'type-error :datum "event crash" :expected-type 'null))
      ((equal op "block") (pig:obj "block" t "reason" "event blocked"))
      ((equal op "set-content") (pig:obj "content" (vector (pig:obj "type" "text" "text" "patched"))))
      ((equal op "set-error") (pig:obj "isError" t))
      ((equal op "record") (append-line ".events" (concatenate 'string tag ":" (json-text data))) nil)
      ((equal op "record-counted")
       (incf *recorded*)
       (append-line ".events" (format nil "~A@~D:~A" tag *recorded* (json-text data)))
       nil)
      ((equal op "set-prompt") (pig:obj "systemPrompt" "base prompt"))
      ((equal op "append-prompt") (pig:obj "systemPrompt" (concatenate 'string (pig:jget data "systemPrompt") "+")))
      ((equal op "note") (pig:obj "message" (pig:obj "customType" "note" "content" "hello" "display" t)))
      ((equal op "see-prompt")
       (pig:obj "message" (pig:obj "customType" "saw" "content" (pig:jget data "prompt") "display" :false)))
      ((equal op "transform") (pig:obj "action" "transform" "text" (concatenate 'string (pig:jget data "text") "!")))
      ((equal op "handled") (pig:obj "action" "handled"))
      ((equal op "continue") (pig:obj "action" "continue"))
      ((equal op "see-content")
       (let ((content (pig:jget data "content")))
         (pig:obj "details" (pig:obj "saw" (or (pig:jref content 0 "text") :null)))))
      (t nil))))

(defun new-extension ()
  ;; Read at every factory call, so a reload builds the extension from the current file.
  (let ((spec (pig:decode-json (read-file-octets ".sdk-scenario.json")))
        (ext (pig:make-extension "scenario-driver-lisp")))
    (loop for provider across (or (pig:jget spec "providers") #()) do (pig:register-native-provider ext (provider-object provider)))
    (loop for tool across (or (pig:jget spec "tools") #()) do (register-tool ext tool))
    (loop for command across (or (pig:jget spec "commands") #()) do (register-command ext command))
    (loop for shortcut across (or (pig:jget spec "shortcuts") #())
          do (let ((key (pig:jget shortcut "key")))
               (pig:shortcut ext key (pig:jget shortcut "description")
                             (lambda (ctx) (declare (ignore ctx)) (write-file ".shortcut-fired" key)))))
    (loop for event across (or (pig:jget spec "events") #())
          do (pig:on ext (pig:jget event "name")
                     (event-handler (pig:jget event "op") (let ((tag (pig:jget event "tag"))) (if (stringp tag) tag "")))))
    (loop for flag across (or (pig:jget spec "flags") #())
          do (let ((default (pig:jget flag "default")))
               (if default
                   (pig:flag ext (pig:jget flag "name") :description (pig:jget flag "description")
                                :type (pig:jget flag "type") :default default)
                   (pig:flag ext (pig:jget flag "name") :description (pig:jget flag "description")
                                :type (pig:jget flag "type")))))
    ext))
