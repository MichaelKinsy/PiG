(in-package "lisp-sdk-fixture")
;;; the host-surface rows (host_surface_test.go) and the theme rows (theme_test.go), carried by the surface extension: the tools of register_host_surface and
;;; theme_probe in the Python fixture (model_types_test.go)

(defun sf-null (value) (if (or (null value) (eq value :null)) :null value))
(defun sf-bool (value) (if value t :false))
(defun sf-list (value) (if (vectorp value) (coerce value 'list) '()))
(defun sf-now-ms () (multiple-value-bind (seconds microseconds) (sb-ext:get-time-of-day) (+ (* seconds 1000) (floor microseconds 1000))))
(defun sf-text (value) (pig:obj "content" (vector (pig:obj "type" "text" "text" (pig:to-json value)))))
(defun sf-table (keys function)
  "An object holding (FUNCTION key) under each of KEYS."
  (let ((table (pig:obj))) (dolist (key keys table) (setf (gethash key table) (funcall function key)))))
(defun sf-attempt (thunk) (handler-case (funcall thunk) (error (e) (format nil "throw:~A" e))))

(defun sf-theme-queries (theme args)
  (if (not (eq (pig:jget args "queries") t))
      :null
      (let ((tokens (sf-list (pig:jget args "ansiTokens"))) (texts (sf-list (pig:jget args "modifierTexts")))
            (modifiers (list (cons "bold" #'pig:theme-bold) (cons "italic" #'pig:theme-italic) (cons "underline" #'pig:theme-underline)
                             (cons "inverse" #'pig:theme-inverse) (cons "strikethrough" #'pig:theme-strikethrough))))
        (pig:obj "modifiers" (sf-table (mapcar #'car modifiers) (lambda (name) (funcall (cdr (assoc name modifiers :test #'equal)) theme "x")))
                 "modifierTexts" (sf-table (mapcar #'car modifiers)
                                           (lambda (name) (map 'simple-vector (lambda (text) (funcall (cdr (assoc name modifiers :test #'equal)) theme text)) texts)))
                 "fgAnsi" (sf-table tokens (lambda (token) (sf-attempt (lambda () (pig:theme-get-fg-ansi theme token)))))
                 "bgAnsi" (sf-table tokens (lambda (token) (sf-attempt (lambda () (pig:theme-get-bg-ansi theme token)))))
                 "bgs" (sf-table tokens (lambda (token) (sf-attempt (lambda () (pig:theme-bg theme token "x")))))
                 "mode" (pig:theme-get-color-mode theme)
                 "thinking" (sf-table (sf-list (pig:jget args "levels"))
                                      (lambda (level) (sf-attempt (lambda () (funcall (pig:theme-get-thinking-border-color theme level) "x")))))
                 "bash" (sf-attempt (lambda () (funcall (pig:theme-get-bash-mode-border-color theme) "x")))
                 "sourcePath" (sf-null (pig:theme-source-path theme)) "sourceInfo" (sf-null (pig:theme-source-info theme))))))

(defun sf-theme-probe (ctx params)
  (let* ((theme (pig:ctx-theme ctx)) (colors (pig:theme-colors theme)))
    (sf-text (pig:obj "appearance" (pig:theme-appearance theme)
                      "colors" (sf-table (sf-list (pig:jget params "tokens")) (lambda (token) (sf-null (pig:jget colors token))))
                      "styles" (map 'simple-vector
                                    (lambda (options) (handler-case (pig:obj "ok" (pig:theme-style theme "x" options)) (error (e) (pig:obj "error" (format nil "~A" e)))))
                                    (sf-list (pig:jget params "cases")))
                      "fgs" (sf-table (sf-list (pig:jget params "fgTokens")) (lambda (token) (sf-attempt (lambda () (pig:theme-fg theme token "x")))))
                      "queries" (sf-theme-queries theme params)))))

(def-surface-fixture "surface-host" (ext)
  (let ((lock (sb-thread:make-mutex :name "surface log")) (theme-log '()) (expanded-log '()) (theme-off nil) (expanded-off nil)
        (heard '()) (heard-at-emit 0) (error-emit-failed nil) (cross-own-at nil) (cross-returned-at nil) (ack-heard '()) (ack-at-cross 0) (loaded nil)
        (bus (pig:extension-events ext)))
    (flet ((append-to (place value) (sb-thread:with-mutex (lock) (ecase place (:theme (setf theme-log (append theme-log (list value)))) (:expanded (setf expanded-log (append expanded-log (list value)))))))
           (log-of (place) (sb-thread:with-mutex (lock) (coerce (ecase place (:theme theme-log) (:expanded expanded-log)) 'simple-vector))))
      ;; a factory's pi.events.emit reaches the listeners subscribed before it, its own included, and returns after them
      (pig:events-on bus "c3:factory" (lambda (ctx data) (declare (ignore ctx)) (sb-thread:with-mutex (lock) (setf heard (append heard (list data))))))
      (pig:events-emit bus "c3:factory" (pig:obj "n" 1 "from" "factory"))
      (setf heard-at-emit (length heard))
      (setf error-emit-failed (handler-case (progn (pig:events-emit bus "error" (pig:obj "from" "factory")) nil) (error () t)))
      (pig:events-on bus "c3:ack" (lambda (ctx data) (declare (ignore ctx)) (sb-thread:with-mutex (lock) (setf ack-heard (append ack-heard (list data))))))
      (pig:events-on bus "c3:cross" (lambda (ctx data) (declare (ignore ctx data)) (setf cross-own-at (sf-now-ms))))
      (pig:events-emit bus "c3:cross" (pig:obj "from" "factory"))
      (setf cross-returned-at (sf-now-ms) ack-at-cross (length ack-heard))
      (pig:on-loaded ext (lambda (ctx)
                           ;; the handler takes its time: a request served before it finished would read nothing
                           (sleep 0.3)
                           (let ((expanded (pig:ctx-tools-expanded-p ctx)))
                             (setf loaded (pig:obj "cwd" (pig:ctx-cwd ctx) "mode" (pig:ctx-mode ctx) "hostCall" t "expanded" (sf-bool expanded))))))
      (flet ((def (name handler) (pig:tool ext name name (pig:obj "type" "object") handler))
             (ok () (sf-text (pig:obj "ok" t))))
        (def "c3_theme_arm" (lambda (ctx params) (declare (ignore params))
                              (setf theme-off (pig:ctx-on-theme-change ctx (lambda (theme) (append-to :theme (format nil "~A|~A" (pig:theme-name theme) (pig:theme-fg theme "accent" "x"))))))
                              (ok)))
        (def "c3_theme_disarm" (lambda (ctx params) (declare (ignore ctx params)) (funcall theme-off) (ok)))
        (def "c3_theme_log" (lambda (ctx params) (declare (ignore ctx params)) (sf-text (pig:obj "log" (log-of :theme)))))
        (def "c3_expanded_arm" (lambda (ctx params) (declare (ignore params))
                                 (setf expanded-off (pig:ctx-on-tools-expanded-change ctx (lambda (expanded) (append-to :expanded (sf-bool expanded)))))
                                 (ok)))
        (def "c3_expanded_disarm" (lambda (ctx params) (declare (ignore ctx params)) (funcall expanded-off) (ok)))
        (def "c3_expanded_log" (lambda (ctx params) (declare (ignore ctx params)) (sf-text (pig:obj "log" (log-of :expanded)))))
        (def "c3_widget_arm" (lambda (ctx params)
                               (pig:ctx-set-widget-renderer ctx "c3w" (lambda (width) (list (format nil "w=~D|~A" width (pig:theme-name (pig:ctx-theme ctx)))))
                                                            (pig:obj "placement" (sf-null (pig:jget params "placement"))))
                               (ok)))
        (def "c3_widget_clear" (lambda (ctx params) (declare (ignore params)) (pig:ctx-set-widget-renderer ctx "c3w" nil) (ok)))
        (def "c3_bell" (lambda (ctx params) (declare (ignore params)) (pig:ctx-bell ctx) (sf-text (pig:obj "error" "<nil>"))))
        (def "c3_tool_call" (lambda (ctx params) (declare (ignore params))
                              (let* ((arguments (pig:ctx-tool-params ctx)) (meta (and arguments (sf-null (pig:jget arguments "meta")))))
                                (sf-text (pig:obj "index" (sf-null (pig:ctx-tool-call-index ctx)) "input" (sf-null (pig:ctx-tool-input ctx))
                                                  "keys" (coerce (and arguments (loop for key being the hash-keys of arguments collect key)) 'simple-vector)
                                                  "meta" (if (member meta '(nil :null)) :null (pig:to-json meta)))))))
        (def "c3_source" (lambda (ctx params) (declare (ignore params)) (sf-text (pig:obj "info" (sf-null (pig:ctx-extension-source-info ctx))))))
        (def "c3_loaded" (lambda (ctx params) (declare (ignore ctx params))
                           (sf-text (pig:obj "loaded" (sf-null loaded) "factoryHeard" (coerce heard 'simple-vector) "heardAtEmit" heard-at-emit
                                             "errorEmitFailed" (sf-bool error-emit-failed) "crossOwnAt" (sf-null cross-own-at)
                                             "crossReturnedAt" (sf-null cross-returned-at) "ackHeard" (coerce ack-heard 'simple-vector) "ackAtCross" ack-at-cross))))
        (def "theme_probe" #'sf-theme-probe)))))
