                 (lambda (ctx args) (declare (ignore args))
                   (let ((signal (pig:ctx-signal ctx)))
                     (cond ((null signal) (core-info ctx "wait:none"))
                           (t (core-info ctx "wait:start")
                              (core-info ctx (concatenate 'string "wait:" (if (pig:abort-signal-wait signal 10) "aborted" "timeout"))))))))
