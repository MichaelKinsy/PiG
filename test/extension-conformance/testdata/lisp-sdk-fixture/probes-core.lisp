(def-fixture "core-exec" (ext)
  (pig:command ext "exec-reject-probe" "Report exec outcomes"
               (lambda (ctx args)
                 (loop for command across (pig:from-json args)
                       do (handler-case (core-info ctx (format nil "resolved:~D" (pig:exec-result-exit-code (pig:ctx-exec ctx command :args '()))))
                            (pig:host-call-error (e) (core-info ctx (format nil "rejected:~A" (pig:host-call-error-message e))))))))
  (pig:command ext "exec-abort-probe" "Abort a running exec through its signal"
               (lambda (ctx args)
                 (let* ((probe (pig:from-json args)) (signal (pig:make-abort-signal)) (pid-file (pig:jget probe "pidFile")))
                   (if (eq (pig:jget probe "pre") t)
