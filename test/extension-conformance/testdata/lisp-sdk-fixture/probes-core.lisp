(defun core-py-str (value)
  "Python's str() of a decoded JSON value, for the fields the Python fixture formats with %s."
  (cond ((or (null value) (eq value :null)) "None") ((eq value t) "True") ((eq value :false) "False")
        ((stringp value) value) ((integerp value) (princ-to-string value))
        ((floatp value) (let ((*read-default-float-format* 'double-float)) (princ-to-string value)))
        (t (pig:to-json value))))
(defun core-get (data &rest path) (apply #'pig:jref data path))
(defun core-key-str (data key default) (if (nth-value 1 (gethash key data)) (core-py-str (gethash key data)) default))
(defun core-lower (value) (if (and value (not (eq value :false)) (not (eq value :null))) "true" "false"))
(defun core-rebuild (table keep &optional extra-pairs)
  "Rewrite TABLE in place with the members KEEP accepts (a predicate on the key) in their order, then EXTRA-PAIRS: SBCL reuses a removed member's slot, which would move a later insertion."
  (let ((pairs '()))
    (maphash (lambda (k v) (when (funcall keep k) (push (cons k v) pairs))) table)
    (clrhash table)
    (dolist (pair (nreverse pairs)) (setf (gethash (car pair) table) (cdr pair)))
    (dolist (pair extra-pairs) (setf (gethash (car pair) table) (cdr pair)))
    table))
(defun core-append-entry (data key entry)
  (setf (gethash key data) (concatenate 'simple-vector (or (gethash key data) (vector)) (vector entry))))
(defun core-g (x) (let ((*read-default-float-format* 'double-float)) (if (and (floatp x) (= x (ftruncate x))) (format nil "~D" (truncate x)) (princ-to-string x))))

(defun core-bash-operations ()
  (pig:make-bash-operations
   (lambda (command cwd options)
     (flet ((emit (text) (funcall (pig:bash-exec-options-on-data options) text)))
       (cond ((equal command "echo")
              (emit (format nil "cmd:~A~%" command)) (emit (format nil "cwd:~A~%" cwd))
              (let ((env (pig:bash-exec-options-env options)))
                (when (and env (zerop (hash-table-count env))) (emit (format nil "env-empty~%")))
                (when env
                  (let ((names '())) (maphash (lambda (k v) (declare (ignore v)) (push k names)) env)
                    (dolist (name (sort names #'string<)) (emit (format nil "env:~A=~A~%" name (gethash name env)))))))
              (when (pig:bash-exec-options-timeout options) (emit (format nil "timeout:~A~%" (core-g (pig:bash-exec-options-timeout options)))))
              3)
             ((equal command "chunks") (emit "a") (emit "b") (emit "c") nil)
             ((equal command "binary") (funcall (pig:bash-exec-options-on-data options) (coerce '(255 0 128) '(simple-array (unsigned-byte 8) (*)))) 0)
             ((equal command "wait")
              (emit "waiting") (pig:abort-signal-wait (pig:bash-exec-options-signal options)) (emit "stopped") (error "aborted"))
             (t (error "exec failed: ~A" command)))))))

