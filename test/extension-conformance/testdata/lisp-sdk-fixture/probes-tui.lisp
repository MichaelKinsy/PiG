(in-package "lisp-sdk-fixture")
;;; the probe commands, tools and event handlers of lane H (see def-fixture in fixture.lisp)

;;; tui_probe: pi-tui's keybindings, capabilities and Key over the state the host published (test/extension-conformance/tui_probe_test.go).
(defun tui-bool (x) (if x t :false))
(defun tui-keys-of (keys) (cond ((null keys) (vector)) ((stringp keys) (vector keys)) (t (coerce keys 'simple-vector))))
(defun tui-caps-json (caps)
  (pig:obj "images" (pig:tui-capabilities-images caps) "trueColor" (tui-bool (pig:tui-capabilities-true-color caps))
           "hyperlinks" (tui-bool (pig:tui-capabilities-hyperlinks caps))))

(defun tui-probe (ctx args)
  (declare (ignore ctx))
  (let* ((ids (coerce (pig:jget args "ids" (vector)) 'list)) (keybindings (pig:tui-get-keybindings)) (original (pig:tui-get-capabilities))
         (report (pig:obj))
         (default-keys (lambda (id) (tui-keys-of (pig:tui-keybinding-definition-default-keys (gethash id pig:*tui-keybindings*)))))
         (user (pig:tui-keybindings-get-user-bindings keybindings)))
    (flet ((put (key value) (setf (gethash key report) value)))
      (put "keys" (let ((table (pig:obj))) (dolist (id ids table) (setf (gethash id table) (pig:tui-keybindings-get-keys keybindings id)))))
      (put "matches" (map 'simple-vector (lambda (item) (tui-bool (pig:tui-keybindings-matches keybindings (pig:jget item "data") (pig:jget item "id"))))
                          (pig:jget args "inputs" (vector))))
      (put "definitions" (let ((table (pig:obj)))
                           (dolist (id ids table)
                             (let ((definition (pig:tui-keybindings-get-definition keybindings id)))
                               (setf (gethash id table) (and definition (pig:tui-keybinding-definition-description definition)))))))
      (put "user" (let ((table (pig:obj))) (maphash (lambda (id keys) (setf (gethash id table) (tui-keys-of keys))) user) table))
      (put "conflicts" (map 'simple-vector (lambda (c) (pig:obj "key" (pig:tui-keybinding-conflict-key c)
                                                                "keybindings" (coerce (pig:tui-keybinding-conflict-keybindings c) 'simple-vector)))
                            (pig:tui-keybindings-get-conflicts keybindings)))
      (put "resolvedIds" (let ((resolved (pig:tui-keybindings-get-resolved-bindings keybindings)))
                           (coerce (sort (loop for id being the hash-keys of resolved collect id) #'string<) 'simple-vector)))
      (put "defaults" (pig:obj "count" (hash-table-count pig:*tui-keybindings*)
                               "tui.input.submit" (funcall default-keys "tui.input.submit") "tui.select.confirm" (funcall default-keys "tui.select.confirm")))
      (put "key" (pig:obj "ctrl" (pig:tui-key "x" :ctrl) "alt" (pig:tui-key (pig:tui-key :enter) :alt) "shift" (pig:tui-key (pig:tui-key :tab) :shift)
                          "escape" (pig:tui-key :escape) "ctrlShift" (pig:tui-key "p" :ctrl :shift)))
      (put "capabilities" (tui-caps-json original))
      (put "colorMode" (pig:tui-get-terminal-color-mode))
      (pig:tui-set-keybindings (pig:tui-make-keybindings-manager
                                (pig:obj "x.probe" (pig:make-tui-keybinding-definition (vector "ctrl+q")))))
      (let ((installed (pig:obj "keys" (pig:tui-keybindings-get-keys (pig:tui-get-keybindings) "x.probe")
                                "hostKeys" (pig:tui-keybindings-get-keys (pig:tui-get-keybindings) "tui.input.submit"))))
        (pig:tui-keybindings-set-user-bindings (pig:tui-get-keybindings) (pig:obj "x.probe" (vector "ctrl+w")))
        (setf (gethash "rebound" installed) (pig:tui-keybindings-get-keys (pig:tui-get-keybindings) "x.probe"))
        (pig:tui-set-keybindings keybindings)
        (setf (gethash "restored" installed) (pig:tui-keybindings-get-keys (pig:tui-get-keybindings) "tui.input.submit"))
        (put "installed" installed))
      (pig:tui-set-capabilities (pig:make-tui-capabilities "kitty" nil nil))
      (let ((swapped (pig:obj "capabilities" (tui-caps-json (pig:tui-get-capabilities)) "colorMode" (pig:tui-get-terminal-color-mode))))
        (pig:tui-set-capability-overrides :hyperlinks t)
        (setf (gethash "overridden" swapped) (tui-bool (pig:tui-capabilities-hyperlinks (pig:tui-get-capabilities))))
        (pig:tui-set-capability-overrides)
        (pig:tui-reset-capabilities-cache)
        (pig:tui-detect-capabilities (lambda () nil))
        (setf (gethash "detected" swapped) t)
        (pig:tui-set-capabilities original)
        (setf (gethash "restored" swapped) (tui-caps-json (pig:tui-get-capabilities)))
        (let ((before (pig:tui-kitty-protocol-active-p)))
          (pig:tui-set-kitty-protocol-active t)
          (let ((after (pig:tui-kitty-protocol-active-p)))
            (pig:tui-set-kitty-protocol-active before)
            (setf (gethash "kitty" swapped) (vector (tui-bool before) (tui-bool after) (tui-bool (pig:tui-kitty-protocol-active-p))))))
        (put "swapped" swapped)))
    (pig:to-json report)))

(def-surface-fixture "tui_probe" (ext)
  (pig:tool ext "tui_probe" "Runs pi-tui's keybinding, capability and Key helpers." (pig:obj "type" "object") #'tui-probe))

;;; tui_theme_probe: pi-coding-agent's theme helpers and key hints over the host's theme and keybindings (tui_theme_test.go).
(defun tui-apply-all (style samples) (map 'simple-vector style samples))

(defun tui-theme-probe (ctx args)
  (declare (ignore ctx))
  (let ((samples (pig:jget args "samples" (vector))) (op (pig:jget args "op")))
    (flet ((all (style) (tui-apply-all style samples))
           (pairs (style) (map 'simple-vector (lambda (s) (vector (funcall style s nil) (funcall style s t))) (pig:jget args "samples" (vector)))))
      (pig:to-json
       (cond
         ((equal op "markdown")
          (let ((theme (pig:get-markdown-theme)))
            (pig:obj "styles" (pig:obj "heading" (all (pig:markdown-theme-heading theme)) "link" (all (pig:markdown-theme-link theme))
                                       "linkUrl" (all (pig:markdown-theme-link-url theme)) "code" (all (pig:markdown-theme-code theme))
                                       "codeBlock" (all (pig:markdown-theme-code-block theme))
                                       "codeBlockBorder" (all (pig:markdown-theme-code-block-border theme))
                                       "quote" (all (pig:markdown-theme-quote theme)) "quoteBorder" (all (pig:markdown-theme-quote-border theme))
                                       "hr" (all (pig:markdown-theme-hr theme)) "listBullet" (all (pig:markdown-theme-list-bullet theme))
                                       "bold" (all (pig:markdown-theme-bold theme)) "italic" (all (pig:markdown-theme-italic theme))
                                       "underline" (all (pig:markdown-theme-underline theme))
                                       "strikethrough" (all (pig:markdown-theme-strikethrough theme)))
                     "highlight" (map 'simple-vector (lambda (pair)
                                                       (let ((lang (aref pair 1)))
                                                         (funcall (pig:markdown-theme-highlight-code theme) (aref pair 0) (and (stringp lang) lang))))
                                      (pig:jget args "highlight" (vector))))))
         ((equal op "select")
          (let ((theme (pig:get-select-list-theme)))
            (pig:obj "styles" (pig:obj "selectedPrefix" (all (pig:select-list-theme-selected-prefix theme))
                                       "selectedText" (all (pig:select-list-theme-selected-text theme))
                                       "description" (all (pig:select-list-theme-description theme))
                                       "scrollInfo" (all (pig:select-list-theme-scroll-info theme)) "noMatch" (all (pig:select-list-theme-no-match theme))))))
         ((equal op "settings")
          (let ((theme (pig:get-settings-list-theme)))
            (pig:obj "styles" (pig:obj "label" (pairs (pig:settings-list-theme-label theme)) "value" (pairs (pig:settings-list-theme-value theme))
                                       "description" (all (pig:settings-list-theme-description theme))
                                       "cursor" (pig:settings-list-theme-cursor theme) "hint" (all (pig:settings-list-theme-hint theme))))))
         ((equal op "highlight")
          (let ((theme (pig:jget args "theme")))
            (when (and (stringp theme) (plusp (length theme))) (pig:init-theme theme))
            (let ((lang (pig:jget args "lang")))
              (pig:obj "lines" (pig:highlight-code (pig:jget args "code" "") (and (stringp lang) lang))))))
         ((equal op "init_theme")
          (let ((name (pig:jget args "theme")))
            (pig:init-theme (and (stringp name) name))
            (let ((theme (pig:get-markdown-theme)))
              (pig:obj "bold" (all (pig:markdown-theme-bold theme)) "heading" (all (pig:markdown-theme-heading theme))))))
         ((equal op "key_hint")
          (pig:obj "keyHint" (pig:key-hint (pig:jget args "id") (pig:jget args "description")) "keyText" (pig:key-text (pig:jget args "id"))))
         ((equal op "raw_key_hint")
          (pig:obj "rawKeyHint" (pig:raw-key-hint (pig:jget args "key") (pig:jget args "description"))))
         (t (error "unknown op ~A" op)))))))

(def-surface-fixture "tui_theme_probe" (ext)
  (pig:tool ext "tui_theme_probe" "Runs pi-coding-agent's theme and key hint helpers." (pig:obj "type" "object") #'tui-theme-probe))
