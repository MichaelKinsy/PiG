(defun types-timing (scenario)
  "How the final message reaches a stream made by create-assistant-message-event-stream and what it carries (the golden file's \"timing\")."
  (let* ((kind (pig:jget scenario "kind")) (preset (pig:jget scenario "preset")) (stamp (pig:jget scenario "timestamp"))
         (stream (pig::create-assistant-message-event-stream)))
    (flet ((message (now)
             (let ((result (pig:obj "role" "assistant" "content" (vector) "stopReason" (if (equal kind "error") "error" "stop"))))
               (cond ((or now (equal stamp "now"))
                      (setf (gethash "timestamp" result) (multiple-value-bind (s us) (sb-ext:get-time-of-day) (+ (* s 1000) (floor us 1000)))))
                     ((equal stamp "old") (setf (gethash "timestamp" result) 1)))
               (when (and (realp preset) (not now)) (setf (gethash "durationMs" result) preset))
               result)))
      (let ((final (message nil)) (later (message t)))
        (cond ((equal kind "done") (pig::model-stream-push stream (pig:obj "type" "done" "reason" "stop" "message" final)))
              ((equal kind "error") (pig::model-stream-push stream (pig:obj "type" "error" "reason" "error" "error" final)))
              ((equal kind "end") (pig::model-stream-end stream final))
              (t (pig::model-stream-push stream (pig:obj "type" "done" "reason" "stop" "message" final))
                 (pig::model-stream-end stream later)))
        (let ((value (gethash "durationMs" final)))
          (pig:obj "present" (if (nth-value 1 (gethash "durationMs" final)) t :false)
                   "value" (if (and (realp preset) (eql value preset)) preset :null)
                   "laterTimed" (if (nth-value 1 (gethash "durationMs" later)) t :false)))))))

(defun types-auth-case (case)
  (let* ((seen '())
         (auth (pig:env-api-key-auth (pig:jget case "name") (pig:jget case "envVars")))
         (env (pig:jget case "env"))
         (result (funcall (pig::api-key-auth-resolve auth)
                          (pig::make-api-key-auth-input
                           :ctx (pig::make-auth-context :env (lambda (name) (push name seen) (let ((v (pig:jget env name))) (and (stringp v) v)))
                                                        :file-exists (lambda (path) (declare (ignore path)) nil))
                           :credential (let ((c (pig:jget case "credential"))) (and (hash-table-p c) c))
                           :signal nil))))
    (pig:obj "result" (if result
                          (let ((out (pig:obj "auth" (pig::auth-result-auth result))))
                            (when (pig::auth-result-env result) (setf (gethash "env" out) (pig::auth-result-env result)))
                            (when (pig::auth-result-source result) (setf (gethash "source" out) (pig::auth-result-source result)))
                            out)
                          :null)
             "seen" (coerce (reverse seen) 'simple-vector))))

(def-fixture "types-pi-ai-helpers-probe" (ext)
  (pig:command ext "pi_ai_helpers_probe" "Run the golden pi-ai helper calls"
               (lambda (ctx path)
                 (let* ((golden (types-read-json path)) (calls (types-helper-calls)))
                   (let ((cases (map 'simple-vector
                                     (lambda (case)
                                       (if (equal (pig:jget case "fn") "DEFAULT_MAX_AGENT_RETRY_DELAY_MS")
                                           (vector pig:+default-max-agent-retry-delay-ms+)
                                           (destructuring-bind (function boolean-p) (rest (assoc (pig:jget case "fn") calls :test #'string=))
                                             (let ((value (apply function (coerce (pig:jget case "args") 'list))))
                                               (cond (boolean-p (vector (if value t :false)))
                                                     ((null value) (vector))
                                                     (t (vector value)))))))
                                     (pig:jget golden "cases")))
                         (auth (map 'simple-vector #'types-auth-case (pig:jref golden "auth" "cases")))
                         (prompts '()) (credential nil))
                     (let ((login (pig::api-key-auth-login (pig:env-api-key-auth "Name" (vector "FIRST" "SECOND")))))
                       (setf credential (funcall login (pig::make-auth-interaction
                                                        :prompt (lambda (request) (push request prompts) "typed-key")
                                                        :notify (lambda (event) (declare (ignore event)) nil) :signal nil))))
                     (types-notify ctx (concatenate 'string "pi_ai_helpers:"
                                                    (pig:to-json (pig:obj "cases" cases "timing" (map 'simple-vector #'types-timing (pig:jget golden "timing"))
                                                                          "auth" auth
                                                                          "login" (pig:obj "prompts" (coerce (reverse prompts) 'simple-vector) "result" credential)))
                                                    ":end")))))))
