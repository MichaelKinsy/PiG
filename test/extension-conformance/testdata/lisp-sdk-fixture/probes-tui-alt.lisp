(in-package "lisp-sdk-fixture")
;;; the tui-alt-screen-probe and tui-alt-frame-probe commands: TuiAltScreen over a recording terminal (test/extension-conformance/tui_alt_screen_test.go).
;;; Each is the Python fixture's probe of the same name (python-sdk-fixture/main.py) and must print the exact text Pi's own TuiAltScreen does.

(defstruct (alt-rec (:constructor make-alt-rec ())) (log '()) (on-input nil) (started nil) (on-write nil))

(defun alt-recording-terminal (rec)
  "A recording pig:tui-terminal: 20x6, no kitty protocol; start keeps the input callback, write appends to the log."
  (pig:make-tui-terminal
   :columns 20 :rows 6 :kitty-protocol-active nil
   :start (lambda (on-input on-resize) (declare (ignore on-resize))
            (setf (alt-rec-on-input rec) on-input (alt-rec-started rec) t) (push "start" (alt-rec-log rec)))
   :stop (lambda () (setf (alt-rec-started rec) nil) (push "stop" (alt-rec-log rec)))
   :drain-input (lambda (max-ms idle-ms) (declare (ignore max-ms idle-ms)))
   :write (lambda (data) (push data (alt-rec-log rec)) (when (alt-rec-on-write rec) (funcall (alt-rec-on-write rec) data)))
   :move-by (lambda (lines) (declare (ignore lines)))
   :hide-cursor (lambda ()) :show-cursor (lambda ()) :clear-line (lambda ()) :clear-from-cursor (lambda ()) :clear-screen (lambda ())
   :set-title (lambda (title) (declare (ignore title)))
   :set-progress (lambda (active) (declare (ignore active)))
   :set-program-status (lambda (status) (declare (ignore status)))))

(defun alt-lines (function) (pig:make-tui-component :render function))

(defun alt-b (value) (if value "true" "false"))

(defun alt-esc () (code-char 27))

(defun alt-strip-ansi (text)
  "TEXT without its CSI sequences and OSC 8 hyperlinks."
  (with-output-to-string (out)
    (let ((i 0) (n (length text)) (esc (alt-esc)))
      (loop while (< i n)
            do (let ((c (char text i)))
                 (cond
                   ((and (char= c esc) (< (1+ i) n) (char= (char text (1+ i)) #\[))
                    (let ((j (+ i 2)))
                      (loop while (and (< j n) (find (char text j) "0123456789;?")) do (incf j))
                      (if (and (< j n) (< (char-code (char text j)) 128) (alpha-char-p (char text j)))
                          (setf i (1+ j))
                          (progn (write-char c out) (incf i)))))
                   ((and (char= c esc) (<= (+ i 4) n) (string= "]8;;" text :start2 (1+ i) :end2 (+ i 5)))
                    (let ((j (+ i 5)))
                      (loop while (and (< j n) (char/= (char text j) (code-char 7)) (char/= (char text j) esc)) do (incf j))
                      (cond ((and (< j n) (char= (char text j) (code-char 7))) (setf i (1+ j)))
                            ((and (< (1+ j) n) (char= (char text j) esc) (char= (char text (1+ j)) #\\)) (setf i (+ j 2)))
                            (t (setf i j)))))
                   (t (write-char c out) (incf i))))))))

(defun alt-join (separator items)
  (with-output-to-string (out)
    (loop for item in items for first = t then nil do (unless first (write-string separator out)) (write-string item out))))

;;; What the report's own text cannot tell from a broken member that answers its default (a selection that is never active, a mouse event nobody
;;; handles, no colors): the probe drives each through the host and signals when its value differs. The report is the other SDKs' own text.
(defun alt-sgr (esc button column row final) (format nil "~C[<~D;~D;~D~C" esc button column row (if (eql final :release) #\m #\M)))

(defun alt-extras (ctx)
  (let ((failures '()) (esc (alt-esc)))
    (flet ((expect (what expected actual)
             (unless (equalp expected actual) (push (format nil "~A: expected ~S, got ~S" what expected actual) failures)))
           (rows (count) (lambda (w) (declare (ignore w)) (loop for i from 1 to count collect (format nil "alpha ~D" i)))))
      ;; a selection by mouse: active, copied to the clipboard (OSC 52), dropped by reset-text-selection
      (let* ((rec (make-alt-rec)) (term (alt-recording-terminal rec))
             (screen (pig:make-tui-alt-screen ctx term :show-hardware-cursor nil :mouse t :copy-on-select nil)))
        (pig:tui-alt-screen-add-child screen (alt-lines (rows 12)))
        (pig:tui-alt-screen-start screen)
        (pig:tui-alt-screen-render-now screen)
        (expect "no selection before the pointer" nil (pig:tui-alt-screen-has-active-selection-p screen))
        (expect "nothing to copy" nil (pig:tui-alt-screen-copy-active-selection-to-clipboard screen))
        (dolist (data (list (alt-sgr esc 0 1 1 :press) (alt-sgr esc 32 5 1 :drag) (alt-sgr esc 0 5 1 :release)))
          (funcall (alt-rec-on-input rec) data)
          (pig:tui-alt-screen-render-now screen))
        (expect "selection after press, drag and release" t (pig:tui-alt-screen-has-active-selection-p screen))
        (setf (alt-rec-log rec) '())
        (expect "copy of a selection" t (pig:tui-alt-screen-copy-active-selection-to-clipboard screen))
        (expect "the copy reaches the terminal as OSC 52" t (and (some (lambda (chunk) (search (format nil "~C]52;" esc) chunk)) (alt-rec-log rec)) t))
        (pig:tui-alt-screen-reset-text-selection screen)
        (expect "selection after reset" nil (pig:tui-alt-screen-has-active-selection-p screen))
        (pig:tui-alt-screen-stop screen))
      ;; the wheel moves the viewport by the wheel-scroll-lines setting
      (let* ((rec (make-alt-rec)) (term (alt-recording-terminal rec))
             (screen (pig:make-tui-alt-screen ctx term :show-hardware-cursor nil :mouse t :wheel-scroll-lines 1)))
        (pig:tui-alt-screen-add-child screen (alt-lines (rows 30)))
        (pig:tui-alt-screen-start screen)
        (pig:tui-alt-screen-render-now screen)
        (pig:tui-alt-screen-scroll-to-top screen)
        (pig:tui-alt-screen-render-now screen)
        (funcall (alt-rec-on-input rec) (alt-sgr esc 65 1 1 :press))
        (pig:tui-alt-screen-render-now screen)
        (let ((one (pig:tui-alt-screen-viewport-top screen)))
          (pig:tui-alt-screen-set-wheel-scroll-lines screen 4)
          (funcall (alt-rec-on-input rec) (alt-sgr esc 65 1 1 :press))
          (pig:tui-alt-screen-render-now screen)
          (expect "a wheel step of 1 then of 4 lines" (list 1 5) (list one (pig:tui-alt-screen-viewport-top screen))))
        (pig:tui-alt-screen-stop screen))
      ;; a component's mouse handler: the host gives it the event in its own coordinates and answers with the handler's flags
      (let* ((rec (make-alt-rec)) (term (alt-recording-terminal rec)) (seen '())
             (screen (pig:make-tui-alt-screen ctx term :show-hardware-cursor nil :mouse t))
             (button (pig:make-tui-component :render (lambda (w) (declare (ignore w)) (list "[ press ]" "[ more  ]"))
                                             :handle-mouse (lambda (event)
                                                             (push (list (pig:mouse-event-type event) (pig:mouse-event-x event) (pig:mouse-event-y event)) seen)
                                                             (list :handled t :focus nil)))))
        (pig:tui-alt-screen-add-child screen button)
        (pig:tui-alt-screen-start screen)
        (pig:tui-alt-screen-render-now screen)
        (let ((result (pig:tui-alt-screen-handle-mouse screen (pig:make-mouse-event :type "press" :button "left" :x 3 :y 1 :screen-x 3 :screen-y 1 :width 20 :height 2))))
          (expect "the handler's answer" t (getf result :handled))
          (expect "the handler's focus flag" nil (getf result :focus))
          (expect "the event the handler saw" '(("press" 3 1)) (reverse seen)))
        (pig:tui-alt-screen-stop screen))
      ;; the terminal's colors, answered by the terminal while the host asks
      (let* ((rec (make-alt-rec)) (term (alt-recording-terminal rec))
             (screen (pig:make-tui-alt-screen ctx term :show-hardware-cursor nil :mouse nil)))
        (setf (alt-rec-on-write rec)
              (lambda (data)
                (when (search (format nil "~C]10;?" esc) data)
                  (funcall (alt-rec-on-input rec) (format nil "~C]10;#ff0000~C" esc (code-char 7)))
                  (funcall (alt-rec-on-input rec) (format nil "~C]11;#0000ff~C" esc (code-char 7)))
                  (funcall (alt-rec-on-input rec) (format nil "~C[?62c" esc)))))
        (pig:tui-alt-screen-start screen)
        (let ((colors (pig:tui-alt-screen-query-terminal-colors screen 5000)))
          (flet ((channels (color) (list (pig:jget color "r") (pig:jget color "g") (pig:jget color "b"))))
            (expect "the foreground the terminal answered" '(255 0 0) (channels (pig:jget colors "foreground")))
            (expect "the background the terminal answered" '(0 0 255) (channels (pig:jget colors "background"))))
          (expect "no palette the terminal did not answer" nil (nth-value 1 (gethash "palette" colors))))
        (pig:tui-alt-screen-stop screen)))
    (when failures (error "TuiAltScreen: ~{~A~^; ~}" (reverse failures)))))

(defun tui-alt-screen-probe (ctx args)
  "Drive the 46 members of pig:tui-alt-screen over a recording terminal and report one line of facts."
  (declare (ignore args))
  (let* ((rec (make-alt-rec)) (term (alt-recording-terminal rec))
         (screen (pig:make-tui-alt-screen ctx term :show-hardware-cursor nil :mouse nil :wheel-scroll-lines 3 :copy-on-select t))
         (doc (alt-lines (lambda (w) (loop for i from 1 to 12 collect (format nil "row ~D w=~D" i w)))))
         (facts '()))
    (labels ((fact (text) (push text facts))
             (render-now () (pig:tui-alt-screen-render-now screen))
             (sl () (mapcar (lambda (line) (string-right-trim '(#\Space #\Tab #\Newline) (alt-strip-ansi line))) (pig:tui-alt-screen-get-screen-lines screen)))
             (viewport () (format nil "~D/~A" (pig:tui-alt-screen-viewport-top screen) (alt-b (pig:tui-alt-screen-following-output-p screen))))
             (input (data) (funcall (alt-rec-on-input rec) data)))
      (pig:tui-alt-screen-add-child screen doc)
      (unless (eq (pig:tui-alt-screen-viewport-tui-p screen) t) (error "tui-alt-screen-viewport-tui-p must be true"))
      (fact (format nil "mode=~A" (pig:tui-alt-screen-mode screen)))
      (fact (format nil "children=~D" (length (pig:tui-alt-screen-children screen))))
      (fact (format nil "terminal=~A" (alt-b (eq (pig:tui-alt-screen-terminal screen) term))))
      (pig:tui-alt-screen-start screen)
      (render-now)
      (fact (format nil "viewport=~A" (viewport)))
      (fact (format nil "first=~A" (first (sl))))
      (fact (format nil "last=~A" (sixth (sl))))
      (fact (format nil "redraws=~A" (alt-b (plusp (pig:tui-alt-screen-full-redraws screen)))))
      (fact (format nil "entered=~A" (alt-b (some (lambda (chunk) (search (format nil "~C[?1049h" (alt-esc)) chunk)) (alt-rec-log rec)))))
      (pig:tui-alt-screen-scroll-by screen -2)
      (render-now)
      (fact (format nil "up=~A" (viewport)))
      (pig:tui-alt-screen-scroll-to-top screen)
      (render-now)
      (fact (format nil "top=~A" (viewport)))
      (fact (format nil "topfirst=~A" (first (sl))))
      (pig:tui-alt-screen-scroll-to-bottom screen)
      (render-now)
      (fact (format nil "bottom=~A" (viewport)))
      (pig:tui-alt-screen-flash screen "hello" 500)
      (render-now)
      (fact (format nil "flash=~A" (alt-b (some (lambda (line) (search "hello" line)) (sl)))))
      (let* ((over (alt-lines (lambda (w) (declare (ignore w)) (list "OVER"))))
             (handle (pig:tui-alt-screen-show-overlay screen over (pig:obj "width" 8 "anchor" "center"))))
        (render-now)
        (let ((bounds (pig:tui-alt-overlay-get-bounds handle)))
          (fact (format nil "overlay=~A/~A/~A/~A" (alt-b (pig:tui-alt-screen-has-overlay-p screen)) (alt-b (pig:tui-alt-screen-has-overlay-entries-p screen))
                        (alt-b (pig:tui-alt-overlay-focused-p handle)) (if bounds (pig:jget bounds "width") "undefined"))))
        (pig:tui-alt-overlay-set-hidden handle t)
        (fact (format nil "hidden=~A" (alt-b (pig:tui-alt-overlay-hidden-p handle))))
        (pig:tui-alt-overlay-set-hidden handle nil)
        (pig:tui-alt-screen-hide-overlay screen)
        (fact (format nil "afterHide=~A/~A" (alt-b (pig:tui-alt-screen-has-overlay-p screen)) (alt-b (pig:tui-alt-screen-has-overlay-entries-p screen)))))
      (let* ((inputs '())
             (foc (pig:make-tui-component :render (lambda (w) (declare (ignore w)) (list "foc")) :focusable t
                                          :handle-input (lambda (data) (push data inputs))))
             (listener (lambda (data) (when (equal data "c") (list :consume t)))))
        (pig:tui-alt-screen-set-focus screen foc)
        (fact (format nil "focus=~A/~A" (alt-b (eq (pig:tui-alt-screen-get-focused-component screen) foc)) (alt-b (pig:tui-component-focused foc))))
        (input "k")
        (let ((remove (pig:tui-alt-screen-add-input-listener screen listener)))
          (input "c")
          (funcall remove)
          (input "c"))
        (pig:tui-alt-screen-add-input-listener screen listener)
        (pig:tui-alt-screen-remove-input-listener screen listener)
        (fact (format nil "inputs=~A" (alt-join "," (reverse inputs)))))
      (let ((debug 0))
        (pig:tui-alt-screen-set-on-debug screen (lambda () (incf debug)))
        (input (format nil "~C[100;6u" (alt-esc)))
        (fact (format nil "debug=~D" debug)))
      (pig:tui-alt-screen-set-show-hardware-cursor screen t)
      (pig:tui-alt-screen-set-clear-on-shrink screen t)
      (fact (format nil "flags=~A/~A" (alt-b (pig:tui-alt-screen-get-show-hardware-cursor screen)) (alt-b (pig:tui-alt-screen-get-clear-on-shrink screen))))
      (pig:tui-alt-screen-set-wheel-scroll-lines screen 2)
      (pig:tui-alt-screen-set-copy-on-select screen nil)
      (fact (format nil "copy=~A/~A/~A" (alt-b (pig:tui-alt-screen-get-copy-on-select screen)) (alt-b (pig:tui-alt-screen-has-active-selection-p screen))
                    (alt-b (pig:tui-alt-screen-copy-active-selection-to-clipboard screen))))
      (pig:tui-alt-screen-reset-text-selection screen)
      (let ((schemes '()))
        (pig:tui-alt-screen-on-terminal-color-scheme-change screen (lambda (scheme) (push scheme schemes)))
        (pig:tui-alt-screen-set-terminal-color-scheme-notifications screen t)
        (input (format nil "~C[?997;1n" (alt-esc)))
        (input (format nil "~C[?997;2n" (alt-esc)))
        (fact (format nil "schemes=~A" (alt-join "," (reverse schemes)))))
      (fact (format nil "colors=~A" (pig:to-json (pig:tui-alt-screen-query-terminal-colors screen 20))))
      (fact (format nil "mouse=~A" (pig:to-json (pig:tui-alt-screen-handle-mouse screen (pig:make-mouse-event :type "wheel" :button "none" :width 20 :height 6 :wheel-delta 1)))))
      (fact (format nil "render=~A" (alt-join "|" (let ((lines (pig:tui-alt-screen-render screen 10))) (subseq lines 0 (min 2 (length lines)))))))
      (pig:tui-alt-screen-invalidate screen)
      (pig:tui-alt-screen-request-render screen)
      (let ((root (alt-lines (lambda (w) (declare (ignore w)) (list "ROOT")))))
        (pig:tui-alt-screen-set-layout-root screen root)
        (render-now)
        (fact (format nil "root=~A" (alt-b (eql 0 (search "ROOT" (first (sl))))))))
      (pig:tui-alt-screen-set-layout-root screen nil)
      (pig:tui-alt-screen-remove-child screen doc)
      (fact (format nil "removed=~D" (length (pig:tui-alt-screen-children screen))))
      (pig:tui-alt-screen-add-child screen doc)
      (pig:tui-alt-screen-clear screen)
      (fact (format nil "cleared=~D" (length (pig:tui-alt-screen-children screen))))
      (pig:tui-alt-screen-stop screen)
      (fact (format nil "stopped=~A" (alt-b (not (alt-rec-started rec)))))
      (alt-extras ctx)
      (pig:ctx-notify ctx (format nil "tui-alt: ~A" (alt-join "; " (reverse facts))) "info"))))

(def-fixture "tui-alt-screen-probe" (ext)
  (pig:command ext "tui-alt-screen-probe" "Drive every TuiAltScreen member over a recording terminal" #'tui-alt-screen-probe))

(defun tui-alt-frame-probe (ctx args)
  "Read the screen from inside a component's render, and drive an overlay's visible callback, over a recording terminal."
  (declare (ignore args))
  (let* ((rec (make-alt-rec)) (term (alt-recording-terminal rec))
         (screen (pig:make-tui-alt-screen ctx term :show-hardware-cursor nil :mouse nil))
         (seen '()) (doc-invalidated 0) (over-invalidated 0) (widths '()) (facts '()))
    (let* ((doc (pig:make-tui-component
                 :render (lambda (width) (declare (ignore width))
                           (push (format nil "~D/~A/~D/~A/~A/~A" (pig:tui-alt-screen-viewport-top screen) (alt-b (pig:tui-alt-screen-following-output-p screen))
                                         (length (pig:tui-alt-screen-get-screen-lines screen)) (alt-b (pig:tui-alt-screen-has-active-selection-p screen))
                                         (alt-b (pig:tui-alt-screen-has-overlay-p screen)) (alt-b (pig:tui-alt-screen-get-show-hardware-cursor screen)))
                                 seen)
                           (loop for i from 1 to 12 collect (format nil "row ~D" i)))
                 :invalidate (lambda () (incf doc-invalidated))))
           (over (pig:make-tui-component :render (lambda (width) (declare (ignore width)) (list "OVER")) :invalidate (lambda () (incf over-invalidated)))))
      (pig:tui-alt-screen-add-child screen doc)
      (pig:tui-alt-screen-start screen)
      (pig:tui-alt-screen-render-now screen)
      (pig:tui-alt-screen-render-now screen)
      (push (format nil "frame1=~A" (car (last seen))) facts)
      (push (format nil "frame2=~A" (first seen)) facts)
      (let ((hide-on (pig:tui-alt-screen-show-overlay
                      screen over (pig:obj "width" 8 "visible" (lambda (width height) (push (format nil "~Dx~D" width height) widths) (>= width 20))))))
        (pig:tui-alt-screen-render-now screen)
        (push (format nil "visibleOn=~A/~A/~A" (alt-b (pig:tui-alt-screen-has-overlay-p screen)) (alt-b (pig:tui-alt-screen-has-overlay-entries-p screen))
                      (alt-b (member "20x6" widths :test #'string=)))
              facts)
        (pig:tui-alt-overlay-hide hide-on))
      (let ((hide-off (pig:tui-alt-screen-show-overlay screen (alt-lines (lambda (w) (declare (ignore w)) (list "X")))
                                                       (pig:obj "visible" (lambda (w h) (declare (ignore w h)) nil)))))
        (push (format nil "visibleOff=~A/~A" (alt-b (pig:tui-alt-screen-has-overlay-p screen)) (alt-b (pig:tui-alt-screen-has-overlay-entries-p screen))) facts)
        (pig:tui-alt-overlay-hide hide-off))
      (pig:tui-alt-screen-show-overlay screen over (pig:obj "width" 8))
      (setf doc-invalidated 0 over-invalidated 0)
      (pig:tui-alt-screen-invalidate screen)
      (push (format nil "invalidate=~A/~A" (alt-b (plusp doc-invalidated)) (alt-b (plusp over-invalidated))) facts)
      (pig:tui-alt-screen-stop screen)
      (pig:ctx-notify ctx (format nil "tui-alt-frame: ~A" (alt-join "; " (reverse facts))) "info"))))

(def-fixture "tui-alt-frame-probe" (ext)
  (pig:command ext "tui-alt-frame-probe" "Read the screen from a component's render and drive an overlay's visible callback" #'tui-alt-frame-probe))
