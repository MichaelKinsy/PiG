(in-package "lisp-sdk-fixture")
;;; the probe commands of lane S3 (see def-fixture in fixture.lisp): builtin_probe, the built-in tool delegation of testdata/python-sdk-fixture/main.py
;;; (TestConformance_BuiltinToolDelegationAcrossSDKs and the override rows).

(defun bp-yes (x) (if x t :false))
(defun bp-case (case key) (let ((value (pig:jget case key))) (if (eq value :null) nil value)))
(defun bp-text-of (bytes) (sb-ext:octets-to-string bytes :external-format :utf-8))

(defun bp-report (result)
  (let* ((blocks (map 'simple-vector (lambda (block)
                                       (if (equal (pig:jget block "type") "text")
                                           (pig:obj "type" "text" "text" (or (pig:jget block "text") ""))
                                           (pig:obj "type" (pig:jget block "type") "mimeType" (pig:jget block "mimeType"))))
                      (pig:jget result "content")))
         (report (pig:obj "content" blocks "isError" (bp-yes (eq (pig:jget result "is_error") t))))
         (details (pig:jget result "details")) (structured (pig:jget result "structured_content")))
    (when (and details (not (eq details :null)))
      (setf (gethash "details" report) details (gethash "detailsJSON" report) (pig:to-json details)))
    (when (hash-table-p structured)
      (setf (gethash "structuredKeys" report) (coerce (loop for key being the hash-keys of structured collect key) 'simple-vector)
            (gethash "exitCode" report) (pig:jget structured "exit_code")))
    report))

(defun bp-options (case log)
  "The options of the tool the case names; LOG is a cons whose car collects what the custom operations saw."
  (flet ((note (text) (push text (car log)) nil)
         (custom () (equal (bp-case case "ops") "custom")))
    (let ((tool (bp-case case "tool")))
      (cond
        ((equal tool "read")
         (pig:make-read-tool-options
          :auto-resize-images (bp-case case "autoResizeImages")
          :operations (and (custom) (pig:make-read-operations :read-file (lambda (path) (note (format nil "readFile:~A" path)) (sb-ext:string-to-octets (format nil "OPS:~A" path) :external-format :utf-8))
                                                              :access (lambda (path) (note (format nil "access:~A" path)))))))
        ((equal tool "write")
         (pig:make-write-tool-options
          :operations (and (custom) (pig:make-write-operations :write-file (lambda (path content) (note (format nil "writeFile:~A:~A" path content)))
                                                               :mkdir (lambda (dir) (note (format nil "mkdir:~A" dir)))))))
        ((equal tool "edit")
         (pig:make-edit-tool-options
          :operations (and (custom) (pig:make-edit-operations :read-file (lambda (path) (note (format nil "readFile:~A" path)) (sb-ext:string-to-octets (format nil "hello world~%") :external-format :utf-8))
                                                              :write-file (lambda (path content) (note (format nil "writeFile:~A:~A" path content)))
                                                              :access (lambda (path) (note (format nil "access:~A" path)))))))
        ((equal tool "ls")
         (pig:make-ls-tool-options
          :operations (and (custom) (pig:make-ls-operations :exists (lambda (path) (note (format nil "exists:~A" path)) t)
                                                            :stat (lambda (path) (note (format nil "stat:~A" path)) (pig:make-ls-stat :is-directory (not (find #\. path))))
                                                            :readdir (lambda (path) (note (format nil "readdir:~A" path)) (list "b.txt" "a.txt" "sub"))))))
        ((equal tool "grep")
         (pig:make-grep-tool-options
          :operations (and (custom) (pig:make-grep-operations :is-directory (lambda (path) (note (format nil "isDirectory:~A" path)) (error "no such path for the probe"))))))
        ((equal tool "find")
         (pig:make-find-tool-options
          :operations (and (custom) (pig:make-find-operations :exists (lambda (path) (note (format nil "exists:~A" path)) nil)
                                                              :glob (lambda (pattern cwd options) (declare (ignore cwd options)) (note (format nil "glob:~A" pattern)) (list))))))
        ((equal tool "powershell")
         (pig:make-power-shell-tool-options :expose-session-environment (bp-case case "exposeSessionEnvironment")))
        (t
         (pig:make-bash-tool-options
          :command-prefix (let ((prefix (bp-case case "commandPrefix"))) (and (stringp prefix) (plusp (length prefix)) prefix))
          :expose-session-environment (bp-case case "exposeSessionEnvironment")
          :spawn-hook (and (bp-case case "hook")
                           (lambda (spawn)
                             (note (format nil "spawnHook:~A" (pig:jget spawn "command")))
                             (let ((env (pig:obj)))
                               (maphash (lambda (k v) (setf (gethash k env) v)) (pig:jget spawn "env"))
                               (setf (gethash "HOOK_VAR" env) "hook-env")
                               (pig:obj "command" "printf '%s|%s' \"$HOOK_VAR\" \"$PI_SESSION_ID\"" "cwd" (pig:jget spawn "cwd") "env" env))))
          :operations (and (custom)
                           (pig:make-bash-operations
                            (lambda (command cwd options)
                              (note (format nil "exec:~A|cwd=~A" command cwd))
                              (funcall (pig:bash-exec-options-on-data options) (sb-ext:string-to-octets (format nil "custom:~A" command) :external-format :utf-8))
                              (pig:obj "exitCode" 0))))))))))

(defun bp-factories (tool)
  "(definition-factory . tool-factory) of the built-in TOOL."
  (cond ((equal tool "read") (cons #'pig:create-read-tool-definition #'pig:create-read-tool))
        ((equal tool "write") (cons #'pig:create-write-tool-definition #'pig:create-write-tool))
        ((equal tool "edit") (cons #'pig:create-edit-tool-definition #'pig:create-edit-tool))
        ((equal tool "bash") (cons #'pig:create-bash-tool-definition #'pig:create-bash-tool))
        ((equal tool "grep") (cons #'pig:create-grep-tool-definition #'pig:create-grep-tool))
        ((equal tool "find") (cons #'pig:create-find-tool-definition #'pig:create-find-tool))
        ((equal tool "ls") (cons #'pig:create-ls-tool-definition #'pig:create-ls-tool))
        ((equal tool "powershell") (cons #'pig:create-powershell-tool-definition #'pig:create-powershell-tool))
        (t (error "no built-in tool ~A" tool))))

(defun bp-override (ctx tool factory-cwd wrap)
  "Register the built-in TOOL's definition with its execute wrapped by WRAP, (lambda (result)); the registered name."
  (let* ((definition (funcall (car (bp-factories tool)) factory-cwd)) (run (pig:builtin-tool-definition-execute definition))
         (override (pig:copy-builtin-tool-definition definition)))
    (setf (pig:builtin-tool-definition-execute override) (lambda (ctx params) (funcall wrap (funcall run ctx params))))
    (pig:register-builtin-tool-definition ctx override)
    (pig:builtin-tool-definition-name definition)))

(defun bp-map-first (result function)
  "RESULT with the text of its first content block rewritten by FUNCTION."
  (let ((copy (pig:obj)) (blocks (copy-seq (pig:jget result "content"))))
    (maphash (lambda (k v) (setf (gethash k copy) v)) result)
    (when (plusp (length blocks))
      (let ((block (pig:obj)))
        (maphash (lambda (k v) (setf (gethash k block) v)) (aref blocks 0))
        (setf (gethash "text" block) (funcall function (pig:jget block "text")) (aref blocks 0) block)))
    (setf (gethash "content" copy) blocks)
    copy))

(defun bp-local-probe (case)
  (let* ((operations (if (equal (bp-case case "shell") "powershell") (pig:create-local-powershell-operations) (pig:create-local-bash-operations)))
         (signal (pig::make-abort-signal)) (chunks '()) (report (pig:obj))
         (options (pig:make-bash-exec-options
                   (lambda (data) (push (bp-text-of data) chunks) (when (bp-case case "abortOnOutput") (pig::signal-abort signal)))
                   signal (bp-case case "timeout") (bp-case case "env"))))
    (handler-case (setf (gethash "exitCode" report) (pig:jget (funcall (pig:bash-operations-exec operations) (pig:jget case "command") (pig:jget case "factoryCwd") options) "exitCode"))
      (error (e) (setf (gethash "error" report) (princ-to-string e))))
    (setf (gethash "output" report) (apply #'concatenate 'string (reverse chunks)))
    report))

(defun bp-run (ctx case)
  (let ((kind (pig:jget case "kind")) (factory-cwd (pig:jget case "factoryCwd")))
    (cond
      ((equal kind "cwd") (pig:obj "cwd" (pig:ctx-cwd ctx)))
      ((equal kind "register")
       (pig:obj "registered" (vector (bp-override ctx "read" factory-cwd (lambda (result)
                                                                          (let ((out (bp-map-first result (lambda (text) (format nil "«delegated:~A»" text)))))
                                                                            (setf (gethash "details" out) (pig:obj "delegated" t))
                                                                            out)))
                                     (bp-override ctx "bash" factory-cwd (lambda (result) (bp-map-first result (lambda (text) (format nil "«~A»" text))))))))
      ((equal kind "registerEdit")
       (pig:obj "registered" (vector (bp-override ctx "edit" factory-cwd (lambda (result) (bp-map-first result (lambda (text) (format nil "«edited:~A»" text))))))))
      ((equal kind "prepare")
       (let* ((definition (funcall (car (bp-factories (pig:jget case "tool"))) factory-cwd)) (prepare (pig:builtin-tool-definition-prepare-arguments definition))
              (report (pig:obj "has" (bp-yes prepare))))
         (when prepare
           (handler-case (setf (gethash "prepared" report) (funcall prepare (or (bp-case case "params") (pig:obj))))
             (error (e) (setf (gethash "error" report) (princ-to-string e)))))
         report))
      ((equal kind "local") (bp-local-probe case))
      ((equal kind "sets")
       (pig:obj "coding" (map 'simple-vector #'pig:builtin-tool-name (pig:create-coding-tools factory-cwd))
                "readOnly" (map 'simple-vector #'pig:builtin-tool-name (pig:create-read-only-tools factory-cwd))))
      (t (bp-tool-case ctx case kind factory-cwd)))))

(defun bp-tool-case (ctx case kind factory-cwd)
  (let* ((log (list nil)) (factories (bp-factories (pig:jget case "tool"))) (options (bp-options case log)))
    (if (equal kind "definition")
        (let ((d (funcall (car factories) factory-cwd options)))
          (pig:obj "definition" (pig:obj "name" (pig:builtin-tool-definition-name d) "label" (pig:builtin-tool-definition-label d)
                                         "description" (pig:builtin-tool-definition-description d)
                                         "promptSnippet" (or (pig:builtin-tool-definition-prompt-snippet d) "")
                                         "promptGuidelines" (let ((g (pig:builtin-tool-definition-prompt-guidelines d))) (and g (coerce g 'simple-vector)))
                                         "parameters" (pig:builtin-tool-definition-parameters d) "outputSchema" (pig:builtin-tool-definition-output-schema d)
                                         "constrainedSampling" (pig:builtin-tool-definition-constrained-sampling d)
                                         "executionMode" (or (pig:builtin-tool-definition-execution-mode d) "")
                                         "renderShell" (if (equal (pig:builtin-tool-definition-render-shell d) "self") "self" ""))))
        (let* ((signal (pig::make-abort-signal)) (updates '()) (report (pig:obj))
               (on-update (and (or (bp-case case "updates") (bp-case case "abortOnOutput"))
                               (lambda (partial)
                                 (let ((text (format nil "~{~A~^~%~}" (loop for block across (pig:jget partial "content")
                                                                           when (equal (pig:jget block "type") "text") collect (pig:jget block "text")))))
                                   (push text updates)
                                   (when (and (bp-case case "abortOnOutput") (string/= text "")) (pig::signal-abort signal)))))))
          (when (bp-case case "preAborted") (pig::signal-abort signal))
          (handler-case
              (setf (gethash "result" report)
                    (bp-report (if (bp-case case "noContext")
                                   (pig:builtin-tool-execute (funcall (cdr factories) factory-cwd options) "probe-call" (or (bp-case case "params") (pig:obj)) :signal signal :on-update on-update)
                                   (pig:builtin-tool-definition-execute-with (funcall (car factories) factory-cwd options) ctx "probe-call" (or (bp-case case "params") (pig:obj))
                                                                             :signal signal :on-update on-update))))
            (error (e) (setf (gethash "error" report) (princ-to-string e))))
          (when (bp-case case "updates") (setf (gethash "updates" report) (coerce (reverse updates) 'simple-vector)))
          (setf (gethash "calls" report) (coerce (reverse (car log)) 'simple-vector))
          report))))

(def-fixture "builtin_probe" (ext)
  (pig:command ext "builtin_probe" "Delegate to a built-in tool through the SDK and report what it returned"
               (lambda (ctx args)
                 (pig:ctx-notify ctx (format nil "builtin:~A:end" (pig:to-json (bp-run ctx (pig:from-json args)))) "info"))))
