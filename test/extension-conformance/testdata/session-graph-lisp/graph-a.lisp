(defun memory-storage (store calls &optional fail)
  "A settings storage over the hash-table STORE; CALLS collects what the host asked of it, in reverse."
  (lambda (scope fn)
    (when fail (error "disk full"))
    (push (format nil "~A:~A" scope (if (gethash scope store) "text" "none")) (car calls))
    (let ((next (funcall fn (gethash scope store))))
      (when next
        (push (format nil "~A:write" scope) (car calls))
        (setf (gethash scope store) next)))))

(defun parsed-text (text) (and text (pig:from-json text)))

(defun calls-list (calls) (vec (reverse (car calls))))

(defun storage-report (ctx)
  (let* ((store (make-hash-table :test 'equal)) (calls (list '())) (storage (memory-storage store calls)) (out (pig:obj)))
    (setf (gethash "global" store) "{\"theme\":\"dark\",\"quietStartup\":true}")
    (let ((manager (pig:settings-from-storage ctx storage)))
      (setf (gethash "loaded" out) (pig:obj "theme" (pig:settings-get-theme manager) "quiet" (pig:settings-get-quiet-startup manager)
                                            "calls" (calls-list calls) "errors" (length (pig:settings-drain-errors manager))))
      (setf (car calls) '())
      (pig:settings-set-theme manager "light")
      (pig:settings-flush manager)
      (setf (gethash "wrote" out) (pig:obj "calls" (calls-list calls) "global" (parsed-text (gethash "global" store))
                                           "project" (jb (null (gethash "project" store))) "theme" (pig:settings-get-theme manager)))
      (setf (gethash "global" store) "{\"theme\":\"solarized\"}" (car calls) '())
      (pig:settings-reload manager)
      (setf (gethash "reloaded" out) (pig:obj "theme" (pig:settings-get-theme manager) "calls" (calls-list calls)))
      (setf (car calls) '())
      (pig:settings-set-project-extension-paths manager (pig:arr "./e"))
      (pig:settings-flush manager)
      (setf (gethash "projectWrote" out)
            (pig:obj "project" (parsed-text (gethash "project" store)) "calls" (calls-list calls)
                     "paths" (pig:jget (pig:settings-get-project-settings manager) "extensions")))
      (setf (car calls) '())
      (let ((untrusted (pig:settings-from-storage ctx storage (pig:obj "projectTrusted" :false))))
        (setf (gethash "untrusted" out) (pig:obj "calls" (calls-list calls) "theme" (pig:settings-get-theme untrusted)
                                                 "trusted" (jb (pig:settings-is-project-trusted untrusted))))))
    (setf (gethash "global" store) "{bad")
    (let ((broken (pig:settings-from-storage ctx storage)))
      (setf (gethash "broken" out)
            (vec (loop for entry across (pig:settings-drain-errors broken)
                       collect (pig:obj "scope" (pig:jget entry "scope") "noPath" (jb (null (pig:jget entry "path")))
                                        "hasMessage" (jb (not (equal (pig:jget entry "error") ""))))))))
    (let ((failing (pig:settings-from-storage ctx (memory-storage (make-hash-table :test 'equal) (list '()) t))))
      (setf (gethash "failing" out)
            (vec (loop for entry across (pig:settings-drain-errors failing)
                       collect (pig:obj "scope" (pig:jget entry "scope") "message" (pig:jget entry "error"))))))
    out))

(def-script "settings_manager" (ctx args)
  (let* ((cwd (arg args "cwd")) (agent-dir (arg args "agentDir")) (config-dir (arg args "configDir")) (broken-cwd (arg args "brokenCwd"))
         (r (pig:obj)) (s (pig:settings-create ctx cwd agent-dir)))
    (setf (gethash "initial" r) (settings-read-all s))
    (setf (gethash "modelBudget" r)
          (pig:obj "reserve" (pig:settings-get-compaction-reserve-tokens s (pig:obj "provider" "p" "id" "m")) "reserveNone" (pig:settings-get-compaction-reserve-tokens s)
                   "keep" (pig:settings-get-compaction-keep-recent-tokens s)
                   "settings" (pig:settings-get-compaction-settings s (pig:obj "provider" "p" "id" "m"))
                   "thinking" (pig:settings-get-model-thinking-level s "p" "m")))
    (pig:settings-set-default-provider s "openai")
    (pig:settings-set-default-model s "gpt")
    (pig:settings-set-default-thinking-level s "high")
    (pig:settings-set-theme s "light")
    (pig:settings-set-steering-mode s "one-at-a-time")
    (pig:settings-set-follow-up-mode s "one-at-a-time")
    (pig:settings-set-compaction-enabled s t)
    (pig:settings-set-retry-enabled s :false)
    (pig:settings-set-packages s (pig:arr "npm:a" (pig:obj "source" "npm:b" "extensions" (pig:arr "x"))))
    (pig:settings-set-extension-paths s (pig:arr "a" "b"))
    (pig:settings-set-skill-paths s (pig:arr "s1"))
    (pig:settings-set-prompt-template-paths s (pig:arr "p1"))
    (pig:settings-set-theme-paths s (pig:arr "t1"))
    (pig:settings-set-enabled-models s (pig:arr "m1" "m2"))
    (pig:settings-set-quiet-startup s "header")
    (pig:settings-set-shell-path s "/bin/sh")
    (pig:settings-set-shell-command-prefix s "set -e")
    (pig:settings-set-npm-command s (pig:arr "pnpm" "dlx"))
    (pig:settings-set-model-thinking-level s "p" "m" "low")
    (pig:settings-set-http-idle-timeout-ms s 5000)
    (pig:settings-set-image-width-cells s 40)
    (pig:settings-set-output-pad s 0)
    (pig:settings-set-tui-mode s "fullscreen")
    (pig:settings-set-fullscreen-wheel-scroll-lines s 3)
    (pig:settings-set-warnings s (pig:obj "anthropicExtraUsage" t))
    (pig:settings-set-default-project-trust s "never")
    (pig:settings-set-last-changelog-version s "9.9.9")
    (pig:settings-set-enable-analytics s :false)
    (pig:settings-set-transport s "sse")
    (pig:settings-set-cache-warming-mode s "idle")
    (pig:settings-set-hide-thinking-block s t)
    (pig:settings-set-show-images s :false)
    (pig:settings-set-clear-on-shrink s t)
    (pig:settings-set-double-escape-action s "tree")
    (pig:settings-set-tree-filter-mode s "user-only")
    (pig:settings-set-mermaid-rendering-mode s "off")
    (pig:settings-set-editor-padding-x s 2)
    (pig:settings-set-autocomplete-max-visible s 7)
    (pig:settings-set-collapse-changelog s t)
    (pig:settings-set-block-images s t)
    (pig:settings-set-session-share-destination s "gist")
    (pig:settings-set-fullscreen-exit-output s "resume-hint")
    (pig:settings-set-fullscreen-scrollbar s "hidden")
    (pig:settings-set-fullscreen-copy-on-select s :false)
    (pig:settings-set-show-hardware-cursor s t)
    (pig:settings-set-image-auto-resize s :false)
    (pig:settings-set-show-terminal-progress s t)
    (pig:settings-set-enable-skill-commands s :false)
    (pig:settings-set-enable-install-telemetry s :false)
    (pig:settings-set-show-cache-miss-notices s :false)
    (pig:settings-set-default-model-and-provider s "anthropic" "opus")
    (pig:settings-set-project-packages s (pig:arr "npm:proj"))
    (pig:settings-set-project-extension-paths s (pig:arr "pe"))
    (pig:settings-set-project-skill-paths s (pig:arr "ps"))
    (pig:settings-set-project-prompt-template-paths s (pig:arr "pp"))
    (pig:settings-set-project-theme-paths s (pig:arr "pt"))
    (pig:settings-flush s)
    (setf (gethash "afterSet" r) (settings-read-all s))
    (setf (gethash "modelThinking" r) (pig:settings-get-model-thinking-level s "p" "m"))
    (pig:settings-remove-model-thinking-level s "p" "m")
    (setf (gethash "removed" r)
          (pig:obj "thinking" (pig:settings-get-model-thinking-level s "p" "m") "trackingId" (pig:settings-get-tracking-id s)
                   "deviceId" (jb (plusp (length (pig:settings-get-or-create-device-id s))))))
    (pig:settings-flush s)
    (setf (gethash "files" r) (pig:obj "global" (read-json-file (join agent-dir "settings.json")) "project" (read-json-file (join cwd config-dir "settings.json"))))
    (let ((persisted (pig:settings-create ctx cwd agent-dir)))
      (setf (gethash "persisted" r) (settings-read-all persisted))
      (with-open-file (out (join agent-dir "settings.json") :direction :output :if-exists :supersede :external-format :utf-8)
        (write-string "{\"defaultProvider\":\"external\"}" out))
      (pig:settings-reload persisted)
      (setf (gethash "reload" r) (pig:obj "provider" (pig:settings-get-default-provider persisted) "model" (pig:settings-get-default-model persisted)
                                          "merged" (pig:settings-get-settings persisted)))
      (pig:settings-set-shell-path persisted nil)
      (pig:settings-set-shell-command-prefix persisted nil)
      (pig:settings-set-npm-command persisted nil)
      (pig:settings-set-enabled-models persisted nil)
      (pig:settings-set-default-model persisted "kept")
      (pig:settings-flush persisted)
      (setf (gethash "cleared" r)
            (pig:obj "shellPath" (pig:settings-get-shell-path persisted) "prefix" (pig:settings-get-shell-command-prefix persisted)
                     "npm" (pig:settings-get-npm-command persisted) "enabled" (pig:settings-get-enabled-models persisted)
                     "file" (read-json-file (join agent-dir "settings.json")))))
    (let ((memory (pig:settings-in-memory ctx (pig:obj "defaultProvider" "mem" "compaction" (pig:obj "enabled" :false) "retry" (pig:obj "maxRetries" 9)))))
      (setf (gethash "memory" r)
            (pig:obj "provider" (pig:settings-get-default-provider memory) "compaction" (pig:settings-get-compaction-settings memory)
                     "retry" (pig:settings-get-retry-settings memory) "merged" (pig:settings-get-settings memory)
                     "trusted" (jb (pig:settings-is-project-trusted memory))))
      (pig:settings-set-default-model memory "mm")
      (pig:settings-apply-overrides memory (pig:obj "defaultModel" "ov"))
      (setf (gethash "memoryAfter" r)
            (pig:obj "model" (pig:settings-get-default-model memory) "global" (pig:settings-get-global-settings memory)
                     "merged" (pig:settings-get-settings memory))))
    (let ((untrusted (pig:settings-in-memory ctx nil (pig:obj "projectTrusted" :false))))
      (setf (gethash "untrustedMemory" r)
            (pig:obj "trusted" (jb (pig:settings-is-project-trusted untrusted))
                     "write" (failure (lambda () (pig:settings-set-project-packages untrusted (pig:arr "x"))) "refusing to write project settings"))))
    (let* ((broken (pig:settings-create ctx broken-cwd agent-dir)) (drained (pig:settings-drain-errors broken)) (entry (pig:obj "count" (length drained))))
      (when (plusp (length drained))
        (let ((first (aref drained 0)))
          (setf (gethash "scope" entry) (pig:jget first "scope")
                (gethash "pathSuffix" entry) (jb (and (stringp (pig:jget first "path")) (ends-with (pig:jget first "path") (join config-dir "settings.json"))))
                (gethash "hasMessage" entry) (jb (plusp (length (or (pig:jget first "error") "")))))))
      (setf (gethash "again" entry) (length (pig:settings-drain-errors broken)))
      (setf (gethash "errors" r) entry))
    (let ((distrust (pig:settings-create ctx cwd agent-dir (pig:obj "projectTrusted" :false))))
      (setf (gethash "distrusted" r)
            (pig:obj "trusted" (jb (pig:settings-is-project-trusted distrust)) "project" (pig:settings-get-project-settings distrust)
                     "merged" (pig:settings-get-settings distrust)
                     "write" (failure (lambda () (pig:settings-set-project-extension-paths distrust (pig:arr "z"))) "refusing to write project settings")))
      (pig:settings-set-project-trusted distrust t)
      (setf (gethash "retrusted" r)
            (pig:obj "trusted" (jb (pig:settings-is-project-trusted distrust))
                     "projectModel" (pig:jget (pig:settings-get-project-settings distrust) "defaultModel"))))
    (setf (gethash "storage" r) (storage-report ctx))
    r))

(def-script "project_trust_store" (ctx args)
  (let* ((root (arg args "root")) (cwd (arg args "cwd")) (agent-dir (arg args "agentDir")) (other (arg args "otherDir"))
         (sub (join cwd "sub")) (anc (join root "anc")) (anc-project (join root "anc" "proj")) (bare (join root "bare"))
         (r (pig:obj)) (store (pig:make-project-trust-store ctx agent-dir)))
    (setf (gethash "initial" r) (pig:obj "get" (pig:trust-store-get store cwd) "entry" (pig:trust-store-get-entry store cwd)))
    (pig:trust-store-set store cwd t)
    (pig:trust-store-set store other :false)
    (setf (gethash "saved" r)
          (pig:obj "get" (pig:trust-store-get store cwd) "entry" (pig:trust-store-get-entry store sub) "otherGet" (pig:trust-store-get store other)
                   "file" (read-json-file (join agent-dir "trust.json"))))
    (pig:trust-store-set-many store (pig:arr (pig:obj "path" cwd "decision" nil) (pig:obj "path" anc "decision" t)))
    (setf (gethash "many" r)
          (pig:obj "cwd" (pig:trust-store-get store cwd) "anc" (pig:trust-store-get store anc-project) "entryAnc" (pig:trust-store-get-entry store anc-project)
                   "file" (read-json-file (join agent-dir "trust.json"))))
    (pig:trust-store-set store sub :false)
    (setf (gethash "nested" r)
          (pig:obj "sub" (pig:trust-store-get store sub) "parent" (pig:trust-store-get store cwd) "file" (read-json-file (join agent-dir "trust.json"))))
    (flet ((failure-of-get (directory contains)
             (failure (lambda () (pig:trust-store-get (pig:make-project-trust-store ctx (join root directory)) cwd)) contains)))
      (setf (gethash "errors" r)
            (pig:obj "notObject" (failure-of-get "agent-array" "Invalid trust store") "unreadable" (failure-of-get "agent-bad-json" "Failed to read trust store")
                     "badValue" (failure-of-get "agent-bad-value" "must be true, false, or null"))))
    (setf (gethash "resources" r)
          (pig:obj "config" (jb (pig:has-trust-requiring-project-resources ctx cwd)) "bare" (jb (pig:has-trust-requiring-project-resources ctx bare))
                   "ancestor" (jb (pig:has-trust-requiring-project-resources ctx anc-project))))
    r))

(defun skill-report (result)
  (let ((skills (sort (loop for skill across (pig:jget result "skills")
                            collect (pig:obj "name" (pig:jget skill "name") "description" (pig:jget skill "description")
                                             "disable" (jb (eq (pig:jget skill "disableModelInvocation") t)) "file" (basename (pig:jget skill "filePath"))
                                             "baseDir" (basename (pig:jget skill "baseDir")) "scope" (pig:jref skill "sourceInfo" "scope")
                                             "origin" (pig:jref skill "sourceInfo" "origin") "source" (pig:jref skill "sourceInfo" "source")))
                      #'string< :key (lambda (skill) (pig:jget skill "name")))))
    (pig:obj "skills" (vec skills) "diagnostics" (diagnostics-report result))))

(defun diagnostics-report (result)
  (vec (loop for d across (pig:jget result "diagnostics") collect (format nil "~A: ~A" (pig:jget d "type") (pig:jget d "message")))))

(defun prompt-report (result)
  (let ((prompts (sort (loop for prompt across (pig:jget result "prompts")
                             collect (pig:obj "name" (pig:jget prompt "name") "description" (pig:jget prompt "description")
                                              "argumentHint" (let ((hint (pig:jget prompt "argumentHint"))) (if (and (stringp hint) (plusp (length hint))) hint ""))
                                              "content" (pig:jget prompt "content") "file" (basename (pig:jget prompt "filePath"))
                                              "scope" (pig:jref prompt "sourceInfo" "scope")))
                       #'string< :key (lambda (prompt) (pig:jget prompt "name")))))
    (pig:obj "prompts" (vec prompts) "diagnostics" (diagnostics-report result))))

(defun resource-report (loader)
  (let ((extensions (pig:loader-get-extensions loader)) (source (pig:loader-get-system-prompt-source loader)))
    (pig:obj "extensions" (length (pig:jget extensions "extensions")) "extensionErrors" (length (pig:jget extensions "errors"))
             "themes" (length (pig:jget (pig:loader-get-themes loader) "themes"))
             "skills" (skill-report (pig:loader-get-skills loader)) "prompts" (prompt-report (pig:loader-get-prompts loader))
             "agentsFiles" (vec (loop for file across (pig:jget (pig:loader-get-agents-files loader) "agentsFiles")
                                      collect (pig:obj "path" (pig:jget file "path") "content" (pig:jget file "content"))))
             "systemPrompt" (pig:loader-get-system-prompt loader) "systemPromptSource" (and source (pig:jget source "path"))
             "appendSystemPrompt" (pig:loader-get-append-system-prompt loader)
             "appendSources" (vec (loop for item across (pig:loader-get-append-system-prompt-sources loader) collect (pig:jget item "path"))))))

(defun with-fields (object &rest members)
  "A copy of the JSON object OBJECT with MEMBERS (key value ...) set."
  (let ((copy (pig:obj)))
    (maphash (lambda (k v) (setf (gethash k copy) v)) object)
    (loop for (k v) on members by #'cddr do (setf (gethash k copy) v))
    copy))

(def-script "resource_loader" (ctx args)
  (let* ((root (arg args "root")) (cwd (arg args "cwd")) (agent-dir (arg args "loaderAgentDir"))
         (extra-skills (join root "extra-skills")) (extra-prompts (join root "extra-prompts")) (r (pig:obj))
         (plain (pig:make-resource-loader ctx :cwd cwd :agent-dir agent-dir)))
    (pig:loader-reload plain)
    (setf (gethash "plain" r) (resource-report plain))
    (let ((overridden
            (pig:make-resource-loader
             ctx :cwd cwd :agent-dir agent-dir :no-skills t :additional-skill-paths (list extra-skills) :no-prompt-templates t
                 :additional-prompt-template-paths (list extra-prompts) :no-context-files t :system-prompt "inline prompt"
                 :append-system-prompt (list "a1" "a2")
                 :system-prompt-override (lambda (base) (and base (concatenate 'string base "!")))
                 :append-system-prompt-override (lambda (base) (vec (append (coerce base 'list) (list "z"))))
                 :skills-override (lambda (base)
                                    (pig:obj "skills" (vec (remove "beta" (coerce (pig:jget base "skills") 'list) :key (lambda (s) (pig:jget s "name")) :test #'equal))
                                             "diagnostics" (pig:jget base "diagnostics")))
                 :prompts-override (lambda (base)
                                     (pig:obj "prompts" (map 'vector (lambda (p) (with-fields p "description" (concatenate 'string "overridden " (pig:jget p "name"))))
                                                             (pig:jget base "prompts"))
                                              "diagnostics" (pig:jget base "diagnostics")))
                 :agents-files-override (lambda (base) (declare (ignore base))
                                          (pig:obj "agentsFiles" (pig:arr (pig:obj "path" "/virtual/AGENTS.md" "content" "virtual")))))))
      (pig:loader-reload overridden)
      (setf (gethash "overridden" r) (resource-report overridden)))
    (pig:loader-extend-resources plain (pig:obj "skillPaths" (pig:arr (pig:obj "path" (join extra-skills "beta")
                                                                                "metadata" (pig:obj "source" "test" "scope" "project" "origin" "top-level")))))
    (setf (gethash "extended" r) (skill-report (pig:loader-get-skills plain)))
    (let* ((settings (pig:settings-in-memory ctx (pig:obj "skills" (pig:arr extra-skills))))
           (via-settings (pig:make-resource-loader ctx :cwd cwd :agent-dir agent-dir :settings-manager settings)))
      (pig:loader-reload via-settings)
      (setf (gethash "viaSettings" r) (skill-report (pig:loader-get-skills via-settings))))
    (let ((calls 0) (trusting (pig:make-resource-loader ctx :cwd cwd :agent-dir agent-dir)))
      (pig:loader-reload trusting :resolve-project-trust (lambda (result) (declare (ignore result)) (incf calls) t))
      (setf (gethash "trust" r) (pig:obj "calls" calls "skills" (length (pig:jget (pig:loader-get-skills trusting) "skills"))))
      (let ((bootstrap (pig:loader-load-project-trust-extensions trusting)))
        (setf (gethash "projectTrust" r)
              (pig:obj "extensions" (length (pig:jget bootstrap "extensions")) "errors" (length (pig:jget bootstrap "errors"))))))
    r))

(defun resolved-report (paths)
  (pig:obj "extensions" (length (pig:jget paths "extensions"))
           "skills" (vec (loop for skill across (pig:jget paths "skills")
                               collect (pig:obj "file" (basename (pig:jget skill "path")) "enabled" (pig:jget skill "enabled")
                                                "source" (pig:jref skill "metadata" "source") "scope" (pig:jref skill "metadata" "scope")
                                                "origin" (pig:jref skill "metadata" "origin"))))
           "prompts" (length (pig:jget paths "prompts")) "themes" (length (pig:jget paths "themes"))))

(def-script "package_manager" (ctx args)
  (let* ((root (arg args "root")) (cwd (arg args "pmCwd")) (agent-dir (arg args "pmAgentDir")) (pkg (join root "pkgs" "localpkg")) (r (pig:obj))
         (settings (pig:settings-create ctx cwd agent-dir))
         (pm (pig:make-package-manager ctx :cwd cwd :agent-dir agent-dir :settings-manager settings)))
    (setf (gethash "initial" r) (pig:obj "list" (length (pig:pkgmgr-list-configured-packages pm)) "installed" (pig:pkgmgr-get-installed-path pm pkg "user")))
    (let ((added (pig:pkgmgr-add-source-to-settings pm pkg)) (again (pig:pkgmgr-add-source-to-settings pm pkg)))
      (setf (gethash "added" r)
            (pig:obj "first" (jb added) "again" (jb again) "list" (pig:pkgmgr-list-configured-packages pm) "packages" (pig:settings-get-packages settings)
                     "installed" (pig:pkgmgr-get-installed-path pm pkg "user"))))
    (setf (gethash "resolved" r) (resolved-report (pig:pkgmgr-resolve pm)))
    (let ((events '()))
      (pig:pkgmgr-set-progress-callback pm (lambda (event) (push (format nil "~A:~A" (pig:jget event "type") (pig:jget event "action")) events)))
      (pig:pkgmgr-install-and-persist pm pkg t)
      (pig:pkgmgr-remove pm pkg t)
      (setf (gethash "removeOnly" r) (pig:obj "list" (length (pig:pkgmgr-list-configured-packages pm))))
      (setf (gethash "installed" r) (pig:obj "list" (pig:pkgmgr-list-configured-packages pm) "events" (vec (reverse events))))
      (setf (gethash "removed" r)
            (pig:obj "project" (jb (pig:pkgmgr-remove-and-persist pm pkg t)) "list" (length (pig:pkgmgr-list-configured-packages pm))
                     "settings" (jb (pig:pkgmgr-remove-source-from-settings pm pkg)) "settingsAgain" (jb (pig:pkgmgr-remove-source-from-settings pm pkg)))))
    (pig:pkgmgr-set-progress-callback pm nil)
    (setf (gethash "temporary" r) (resolved-report (pig:pkgmgr-resolve-extension-sources pm (list pkg) nil t)))
    (setf (gethash "updates" r) (length (pig:pkgmgr-check-for-available-updates pm)))
    (let ((missing '()))
      (pig:pkgmgr-add-source-to-settings pm "npm:not-installed-pkg")
      (let ((skipped (pig:pkgmgr-resolve pm (lambda (source) (push source missing) "skip"))))
        (setf (gethash "missing" r) (pig:obj "calls" (vec (reverse missing)) "skills" (length (pig:jget skipped "skills"))))))
    r))
