(in-package "session-graph")
;;; session_manager, settings_manager, project_trust_store, resource_loader, package_manager (lane S2): the scripts of session_graph_python.py.

(defun jb (x) (if x t :false))

(defun arg (args key) (pig:jget args key))

(defun join (&rest parts) (format nil "~{~A~^/~}" parts))

(defun dirname (path) (subseq path 0 (or (position #\/ path :from-end t) 0)))

(defun basename (path) (subseq path (let ((p (position #\/ path :from-end t))) (if p (1+ p) 0))))

(defun ends-with (text suffix) (let ((n (length suffix))) (and (>= (length text) n) (string= suffix text :start2 (- (length text) n)))))

(defun contains (text part) (and (search part text) t))

(defun vec (sequence) (coerce sequence 'simple-vector))

(defun failure (fn contains)
  (handler-case (progn (funcall fn) "no error")
    (error (e) (let ((message (princ-to-string e)))
                 (if (contains message contains) (format nil "error: ~A" contains) (format nil "error: ~A" message))))))

(defun shape (entries)
  (let ((index (make-hash-table :test 'equal)))
    (loop for entry across entries for i from 0 do (setf (gethash (pig:jget entry "id") index) i))
    (vec (loop for entry across entries
               collect (let ((parent (pig:jget entry "parentId")))
                         (format nil "~A<~D" (pig:jget entry "type") (if (stringp parent) (gethash parent index -1) -1)))))))

(defun infos (listing)
  (vec (sort (loop for info across listing
                   collect (pig:obj "id" (pig:jget info "id") "messageCount" (pig:jget info "messageCount") "name" (pig:jget info "name")
                                    "firstMessage" (pig:jget info "firstMessage") "cwd" (pig:jget info "cwd")
                                    "createdRecent" (jb (> (pig:jget info "created") 1767225600000)) "modifiedMs" (pig:jget info "modified")
                                    "fileInDir" (jb (not (equal (pig:jget info "path") "")))))
             #'string< :key (lambda (info) (pig:jget info "id")))))

(defun read-json-file (path)
  (pig:from-json (with-open-file (in path :external-format :utf-8)
                   (let* ((text (make-string (file-length in))) (n (read-sequence text in))) (subseq text 0 n)))))

(defparameter *assistant*
  (pig:obj "role" "assistant" "content" (pig:arr (pig:obj "type" "text" "text" "hi")) "api" "test" "provider" "p" "model" "m"
           "usage" (pig:obj "input" 1 "output" 1 "cacheRead" 0 "cacheWrite" 0 "totalTokens" 2
                            "cost" (pig:obj "input" 0 "output" 0 "cacheRead" 0 "cacheWrite" 0 "total" 0))
           "stopReason" "stop" "timestamp" 2))

(defun user-message (text timestamp) (pig:obj "role" "user" "content" text "timestamp" timestamp))

(def-script "session_manager" (ctx args)
  (let* ((cwd (arg args "cwd")) (directory (arg args "dir")) (other-dir (arg args "otherDir")) (junk (arg args "junk"))
         (r (pig:obj)) (fixed "fixed-session-1")
         (m (pig:sm-create ctx cwd directory (pig:obj "id" fixed)))
         (file (pig:sm-get-session-file m)))
    (setf (gethash "created" r)
          (pig:obj "id" (pig:sm-get-session-id m) "persisted" (jb (pig:sm-is-persisted m)) "dir" (pig:sm-get-session-dir m)
                   "fileSuffix" (jb (ends-with file "_fixed-session-1.jsonl")) "fileInDir" (jb (equal (dirname file) directory))
                   "cwd" (pig:sm-get-cwd m) "defaultDir" (jb (pig:sm-uses-default-session-dir m)) "entries" (pig:sm-get-entry-count m)
                   "leaf" (pig:sm-get-leaf-id m)))
    (let ((first (pig:sm-append-message m (user-message "hello" 1))) (last nil))
      (pig:sm-append-message m *assistant*)
      (pig:sm-append-session-info m "graph")
      (pig:sm-append-label-change m first "start")
      (pig:sm-append-custom-entry m "note" (pig:obj "a" 1 "b" 2))
      (pig:sm-append-thinking-level-change m "high")
      (setf last (pig:sm-append-model-change m "p" "m"))
      (let* ((entries (pig:sm-get-entries m)) (header (pig:sm-get-header m))
             (custom (find "custom" entries :key (lambda (e) (pig:jget e "type")) :test #'equal)))
        (setf (gethash "log" r)
              (pig:obj "name" (pig:sm-get-session-name m) "label" (pig:sm-get-label m first) "count" (pig:sm-get-entry-count m)
                       "shape" (shape entries) "leafIsLast" (jb (equal (pig:sm-get-leaf-id m) last))
                       "entryType" (pig:jget (pig:sm-get-entry m first) "type") "missing" (jb (null (pig:sm-get-entry m "nope")))
                       "headerType" (pig:jget header "type") "headerVersion" (pig:jget header "version") "headerId" (pig:jget header "id")
                       "headerCwd" (pig:jget header "cwd") "customType" (pig:jget custom "customType") "customData" (pig:jget custom "data"))))
      (let ((built (pig:sm-build-session-context m)))
        (setf (gethash "context" r) (pig:obj "messages" (length (pig:jget built "messages")) "thinkingLevel" (pig:jget built "thinkingLevel")
                                             "model" (pig:jget built "model"))))
      (let ((tree (pig:sm-get-tree m)))
        (setf (gethash "tree" r) (pig:obj "roots" (length tree) "firstChildren" (length (pig:jref tree 0 "children")))))
      (let* ((msg-id (pig:sm-append-custom-message-entry m "note-msg" "body" t (pig:obj "k" 1)))
             (usage (pig:sm-append-usage m "test" "p" "m" (pig:obj "input" 1 "output" 2 "cacheRead" 0 "cacheWrite" 0 "totalTokens" 3
                                                                    "cost" (pig:obj "input" 0 "output" 0 "cacheRead" 0 "cacheWrite" 0 "total" 0)))))
        (setf (gethash "extra" r)
              (pig:obj "msgType" (pig:jget (pig:sm-get-entry m msg-id) "type") "msgCustomType" (pig:jget (pig:sm-get-entry m msg-id) "customType")
                       "usageType" (pig:jget usage "type") "usageKind" (pig:jget usage "kind"))))
      (pig:sm-branch m first)
      (let ((alt (pig:sm-append-message m (user-message "alt" 3))))
        (setf (gethash "branch" r)
              (pig:obj "shape" (shape (pig:sm-get-branch m)) "children" (length (pig:sm-get-children m first))
                       "leafIsAlt" (jb (equal (pig:sm-get-leaf-id m) alt)))))
      (pig:sm-reset-leaf m)
      (setf (gethash "reset" r) (pig:obj "leaf" (pig:sm-get-leaf-id m)))
      (let* ((summary (pig:sm-branch-with-summary m first "summary text")) (entry (pig:sm-get-entry m summary)))
        (setf (gethash "summary" r)
              (pig:obj "type" (pig:jget entry "type") "parentIsFirst" (jb (equal (pig:jget entry "parentId") first))
                       "text" (pig:jget entry "summary") "fromId" (jb (equal (pig:jget entry "fromId") first))))
        (let ((branched (pig:sm-create-branched-session m summary)))
          (setf (gethash "branched" r)
                (pig:obj "isFile" (jb (and branched (ends-with branched ".jsonl"))) "inDir" (jb (and branched (equal (dirname branched) directory)))
                         "newFile" (jb (and branched (not (equal branched file)))) "idChanged" (jb (not (equal (pig:sm-get-session-id m) fixed)))
                         "count" (pig:sm-get-entry-count m) "shape" (shape (pig:sm-get-entries m))))))
      (let ((opened (pig:sm-open ctx file)))
        (setf (gethash "opened" r)
              (pig:obj "id" (pig:sm-get-session-id opened) "count" (pig:sm-get-entry-count opened) "cwd" (pig:sm-get-cwd opened)
                       "headerCwd" (pig:jget (pig:sm-get-header opened) "cwd") "dirIsFileDir" (jb (equal (pig:sm-get-session-dir opened) directory))
                       "file" (jb (equal (pig:sm-get-session-file opened) file)) "name" (pig:sm-get-session-name opened))))
      (let ((overridden (pig:sm-open ctx file nil other-dir)))
        (setf (gethash "override" r) (pig:obj "cwd" (pig:sm-get-cwd overridden) "id" (pig:sm-get-session-id overridden))))
      (let* ((recent (pig:sm-continue-recent ctx cwd directory)) (recent-file (pig:sm-get-session-file recent)))
        (setf (gethash "recent" r)
              (pig:obj "inDir" (jb (and recent-file (equal (dirname recent-file) directory))) "hasEntries" (jb (> (pig:sm-get-entry-count recent) 0))
                       "cwd" (pig:sm-get-cwd recent))))
      (let* ((mem (pig:sm-in-memory ctx cwd (pig:obj "id" "mem-1"))) (before (pig:sm-get-leaf-id mem)))
        (pig:sm-append-message mem (user-message "x" 1))
        (setf (gethash "memory" r)
              (pig:obj "id" (pig:sm-get-session-id mem) "persisted" (jb (pig:sm-is-persisted mem)) "file" (pig:sm-get-session-file mem)
                       "dir" (pig:sm-get-session-dir mem) "defaultDir" (jb (pig:sm-uses-default-session-dir mem)) "leafBefore" before
                       "count" (pig:sm-get-entry-count mem) "cwd" (pig:sm-get-cwd mem))))
      (let ((seeded (pig:sm-in-memory ctx cwd nil (pig:arr (pig:obj "type" "message" "id" "e1" "parentId" nil "timestamp" "2026-01-01T00:00:00.000Z"
                                                                    "message" (user-message "seed" 1))))))
        (setf (gethash "seeded" r)
              (pig:obj "count" (pig:sm-get-entry-count seeded) "leaf" (pig:sm-get-leaf-id seeded)
                       "hasId" (jb (not (equal (pig:sm-get-session-id seeded) ""))))))
      (let* ((fork-dir (join other-dir "sessions")) (forked (pig:sm-fork-from ctx file other-dir fork-dir (pig:obj "id" "forked-1"))))
        (setf (gethash "fork" r)
              (pig:obj "id" (pig:sm-get-session-id forked) "count" (pig:sm-get-entry-count forked)
                       "parent" (jb (equal (pig:jget (pig:sm-get-header forked) "parentSession") file)) "cwd" (jb (equal (pig:sm-get-cwd forked) other-dir))
                       "inDir" (jb (equal (dirname (pig:sm-get-session-file forked)) fork-dir)) "shape" (shape (pig:sm-get-entries forked))))
        (setf (gethash "list" r) (infos (pig:sm-list ctx cwd directory)))
        (let ((list-progress '()) (list-all-progress '()))
          (setf (gethash "listAll" r)
                (infos (pig:sm-list-all ctx directory (lambda (loaded total partial) (declare (ignore partial)) (push (pig:arr loaded total) list-all-progress)))))
          (infos (pig:sm-list ctx cwd directory (lambda (loaded total partial) (declare (ignore partial)) (push (pig:arr loaded total) list-progress))))
          (setf (gethash "progress" r)
                (pig:obj "list" (pig:obj "calls" (jb list-progress) "last" (car list-progress))
                         "listAll" (pig:obj "calls" (jb list-all-progress) "last" (car list-all-progress)))))
        (setf (gethash "listFork" r) (infos (pig:sm-list ctx other-dir fork-dir)))
        (setf (gethash "find" r)
              (pig:obj "found" (jb (equal (pig:sm-find-by-id ctx cwd fixed directory) file))
                       "missing" (jb (null (pig:sm-find-by-id ctx cwd "nope" directory)))))
        (let* ((compaction-id (pig:sm-append-compaction m "sum" first 100 (pig:obj "k" 1)))
               (compaction (pig:sm-get-entry m compaction-id))
               (edit-id (pig:sm-append-context-edit m first (pig:obj "content" "edited")))
               (edit (pig:sm-get-entry m edit-id))
               (clear-id (pig:sm-append-context-edit m first nil))
               (switched (pig:sm-create ctx cwd directory (pig:obj "id" "reopen-1"))))
          (pig:sm-set-session-file switched file)
          (setf (gethash "compaction" r)
                (pig:obj "type" (pig:jget compaction "type") "summary" (pig:jget compaction "summary")
                         "firstKept" (jb (equal (pig:jget compaction "firstKeptEntryId") first)) "tokensBefore" (pig:jget compaction "tokensBefore")
                         "details" (pig:jget compaction "details") "fromHook" (pig:jget compaction "fromHook")
                         "editType" (pig:jget edit "type") "replacement" (pig:jget edit "replacement") "target" (jb (equal (pig:jget edit "targetId") first))
                         "cleared" (pig:jget (pig:sm-get-entry m clear-id) "replacement") "leaf" (jb (equal (pig:sm-get-leaf-id m) clear-id))
                         "badTarget" (failure (lambda () (pig:sm-append-context-edit m "nope" nil)) "not found")
                         "badReplacement" (failure (lambda () (pig:sm-append-context-edit m first (pig:obj "content" 5))) "must be null or contain")
                         "switched" (pig:obj "id" (jb (equal (pig:sm-get-session-id switched) (pig:sm-get-session-id m)))
                                             "file" (jb (equal (pig:sm-get-session-file switched) file))
                                             "shape" (jb (equalp (shape (pig:sm-get-entries switched)) (shape (pig:sm-get-entries m))))
                                             "count" (length (pig:sm-get-entries switched)))
                         "badSwitch" (failure (lambda () (pig:sm-set-session-file switched junk)) "not a valid")))
          (setf (gethash "errors" r)
                (pig:obj "badId" (failure (lambda () (pig:sm-create ctx cwd directory (pig:obj "id" "bad id!"))) "Session id must be")
                         "notSession" (failure (lambda () (pig:sm-open ctx junk)) "not a valid")
                         "noFork" (failure (lambda () (pig:sm-fork-from ctx (join directory "missing.jsonl") cwd fork-dir)) "Cannot fork"))))))
    r))

