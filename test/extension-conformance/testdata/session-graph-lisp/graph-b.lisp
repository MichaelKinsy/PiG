(in-package "session-graph")
;;; model_runtime, model_registry, create_provider, extension_refs, mcp_options, extension_runner, services (lane S3)

(defun b-yes (x) (if x t :false))
(defun b-vec (list) (coerce list 'simple-vector))
(defun b-list (v) (if (listp v) v (coerce v 'list)))
(defun b-null (x) (or (null x) (eq x :null)))
(defun b-ids (models) (mapcar (lambda (m) (pig:jget m "id")) (b-list models)))

(defun b-pick-model (m)
  (and m (pig:obj "id" (pig:jget m "id") "provider" (pig:jget m "provider") "api" (pig:jget m "api") "name" (pig:jget m "name")
                  "reasoning" (b-yes (eq (pig:jget m "reasoning") t)) "contextWindow" (pig:jget m "contextWindow") "maxTokens" (pig:jget m "maxTokens"))))

(defun b-error-text (fn)
  (handler-case (progn (funcall fn) "no error") (error (e) (format nil "error: ~A" e))))

(defun b-message-text (message)
  (apply #'concatenate 'string (map 'list (lambda (block) (let ((text (pig:jget block "text"))) (if (stringp text) text ""))) (pig:jget message "content"))))

(defun b-with (hash &rest members)
  "A copy of HASH with the alternating key/value MEMBERS set."
  (let ((copy (pig:obj)))
    (maphash (lambda (k v) (setf (gethash k copy) v)) hash)
    (loop for (key value) on members by #'cddr do (setf (gethash key copy) value))
    copy))

(defun b-read-json (path)
  (with-open-file (in path :external-format :utf-8)
    (let* ((text (make-string (file-length in))) (n (read-sequence text in))) (pig:from-json (subseq text 0 n)))))

(defun b-model (id name &key (provider nil))
  (declare (ignore provider))
  (pig:obj "id" id "name" name "reasoning" :false "input" (vector "text")
           "cost" (pig:obj "input" 0 "output" 0 "cacheRead" 0 "cacheWrite" 0) "contextWindow" 4000 "maxTokens" 500))

(defun b-assistant-message (model text)
  (pig:obj "role" "assistant" "content" (vector (pig:obj "type" "text" "text" text)) "api" (pig:jget model "api") "provider" (pig:jget model "provider")
           "model" (pig:jget model "id")
           "usage" (pig:obj "input" 0 "output" 0 "cacheRead" 0 "cacheWrite" 0 "totalTokens" 0 "cost" (pig:obj "input" 0 "output" 0 "cacheRead" 0 "cacheWrite" 0 "total" 0))
           "stopReason" "stop" "timestamp" 1))

(defun b-scripted (tag)
  (lambda (model context options)
    (declare (ignore context options))
    (let ((stream (pig:create-assistant-message-event-stream)))
      (pig:model-stream-push stream (pig:obj "type" "done" "reason" "stop" "message" (b-assistant-message model (concatenate 'string tag ":" (pig:jget model "id")))))
      stream)))

(defun b-types (stream) (mapcar (lambda (event) (pig:jget event "type")) (pig:model-stream-events stream)))

(defun b-conversation () (pig:obj "systemPrompt" "Be brief." "messages" (vector (pig:obj "role" "user" "content" "say hello" "timestamp" 1))))

(defun b-cost-zero () (pig:obj "input" 0 "output" 0 "cacheRead" 0 "cacheWrite" 0))


;;; ---------------------------------------------------------------- model_runtime

(defun b-registered-provider-config ()
  (pig:obj "baseUrl" nil "apiKey" "regkey" "api" "openai-completions" "headers" (pig:obj "x-reg" "1")
           "models" (vector (pig:obj "id" "r1" "name" "Reg One" "reasoning" :false "input" (vector "text") "cost" (b-cost-zero) "contextWindow" 4000 "maxTokens" 500))))

(def-script "model_runtime" (ctx args)
  (let* ((auth (pig:jget args "mrAuth")) (server (pig:jget args "mrServer"))
         (rt (pig:runtime-create ctx :auth-path auth :models-path (pig:jget args "mrModels") :models-store-path (pig:jget args "mrStore")))
         (local (pig:runtime-get-model rt "mr-local" "m1"))
         (r (pig:obj)))
    (setf (gethash "catalog" r)
          (pig:obj "error" (pig:runtime-get-error rt) "models" (b-vec (mapcar #'b-pick-model (b-list (pig:runtime-get-models rt "mr-local"))))
                   "all" (length (pig:runtime-get-all-models rt "mr-local")) "one" (b-pick-model local)
                   "missing" (b-yes (null (pig:runtime-get-model rt "mr-local" "nope")))
                   "builtinListed" (b-yes (some (lambda (m) (equal (pig:jget m "provider") "anthropic")) (pig:runtime-get-models rt)))
                   "ofType" (b-vec (b-ids (pig:runtime-get-models-of-type rt "chat" "mr-local")))
                   "oneOfType" (b-pick-model (pig:runtime-get-model-of-type rt "chat" "mr-local" "m1"))
                   "imagesOfType" (length (pig:runtime-get-models-of-type rt "image" "mr-local"))
                   "physical" (b-pick-model (pig:runtime-get-physical-model rt "mr-local" "m1"))
                   "physicalMissing" (b-yes (null (pig:runtime-get-physical-model rt "mr-local" "nope")))))
    (setf (gethash "auth" r)
          (pig:obj "configured" (b-yes (pig:runtime-has-configured-auth-p rt "mr-local")) "unconfigured" (b-yes (pig:runtime-has-configured-auth-p rt "nope-prov"))
                   "oauth" (b-yes (pig:runtime-is-using-oauth-p rt "mr-local")) "subscription" (b-yes (pig:runtime-is-using-subscription-p rt "mr-local"))
                   "status" (pig:runtime-get-provider-auth-status rt "mr-local") "storedStatus" (pig:runtime-get-provider-auth-status rt "stored-prov")
                   "unknownStatus" (pig:runtime-get-provider-auth-status rt "nope-prov")
                   "byProvider" (pig:runtime-get-auth rt "mr-local") "byModel" (pig:runtime-get-auth rt local) "unconfiguredAuth" (pig:runtime-get-auth rt "nope-prov")
                   "overridden" (pig:runtime-get-auth rt "mr-local" (pig:obj "apiKey" "override"))
                   "check" (pig:runtime-check-auth rt "mr-local") "uncheckedProvider" (pig:runtime-check-auth rt "nope-prov")
                   "compat" (pig:runtime-get-compatibility-request-config rt local)))
    (pig:runtime-set-runtime-api-key rt "rt-prov" "rk")
    (let ((with-key (pig:obj "status" (pig:runtime-get-provider-auth-status rt "rt-prov") "configured" (b-yes (pig:runtime-has-configured-auth-p rt "rt-prov"))
                             "auth" (pig:runtime-get-auth rt "rt-prov"))))
      (pig:runtime-remove-runtime-api-key rt "rt-prov")
      (setf (gethash "runtimeKey" r)
            (pig:obj "withKey" with-key "removed" (pig:runtime-get-provider-auth-status rt "rt-prov")
                     "configuredAfter" (b-yes (pig:runtime-has-configured-auth-p rt "rt-prov")))))
    (setf (gethash "credentials" r)
          (b-vec (mapcar (lambda (c) (pig:obj "providerId" (pig:jget c "providerId") "type" (pig:jget c "type")))
                         (sort (copy-list (b-list (pig:runtime-list-credentials rt))) #'string< :key (lambda (c) (pig:jget c "providerId"))))))
    (let ((before (pig:runtime-get-registered-provider-ids rt)) config)
      (pig:runtime-register-provider rt "reg-prov" (let ((c (b-registered-provider-config))) (setf (gethash "baseUrl" c) server) c))
      (pig:runtime-register-provider rt "reg-prov" (pig:obj "baseUrl" (concatenate 'string server "/v2")))
      (setf config (pig:runtime-get-registered-provider-config rt "reg-prov"))
      (setf (gethash "registered" r)
            (pig:obj "before" before "ids" (pig:runtime-get-registered-provider-ids rt)
                     "models" (b-vec (mapcar #'b-pick-model (b-list (pig:runtime-get-models rt "reg-prov"))))
                     "baseUrl" (pig:jget config "baseUrl") "apiKey" (pig:jget config "apiKey") "api" (pig:jget config "api") "headers" (pig:jget config "headers")
                     "modelIds" (b-vec (b-ids (pig:jget config "models")))
                     "configured" (b-yes (pig:runtime-has-configured-auth-p rt "reg-prov"))
                     "unregisteredConfig" (b-yes (null (pig:runtime-get-registered-provider-config rt "nope-prov")))
                     "rejected" (b-error-text (lambda () (pig:runtime-register-provider rt "bad-prov" (pig:obj "models" (vector (pig:obj "id" "x"))))))))
      (pig:runtime-unregister-provider rt "reg-prov")
      (setf (gethash "after" (gethash "registered" r))
            (pig:obj "ids" (pig:runtime-get-registered-provider-ids rt) "models" (length (pig:runtime-get-models rt "reg-prov"))
                     "config" (b-yes (null (pig:runtime-get-registered-provider-config rt "reg-prov"))))))
    (let* ((requests '())
           (route (lambda (ctx request)
                    (declare (ignore ctx))
                    (push (pig:obj "model" (pig:jget (pig:jget request "model") "id") "thinkingLevel" (pig:jget request "thinkingLevel") "reason" (pig:jget request "reason")
                                   "messages" (length (pig:jget request "messages")) "state" (pig:jget request "state"))
                          requests)
                    (pig:obj "model" (pig:runtime-get-physical-model rt "mr-local" "m1") "thinkingLevel" "off" "state" (pig:obj "n" (length requests)))))
           virtual messages routed second)
      (pig:runtime-register-virtual-model
       rt (pig:make-virtual-model :provider "mr-virtual" :id "v1" :name "Virtual One" :route route :thinking-levels (list "off" "high")
                                  :context-window 1000 :max-tokens 100 :input (list "text")))
      (setf virtual (pig:runtime-get-model rt "mr-virtual" "v1")
            messages (vector (pig:obj "role" "user" "content" "hi" "timestamp" 1))
            routed (pig:runtime-resolve-model rt virtual messages (pig:obj "reason" "user" "thinkingLevel" "high"))
            second (pig:runtime-resolve-model rt virtual messages (pig:obj "reason" "continuation" "thinkingLevel" "off" "state" (pig:obj "n" 1))))
      (setf (gethash "virtual" r)
            (pig:obj "model" (b-pick-model virtual) "thinkingLevels" (pig:jget virtual "thinkingLevels")
                     "route" (pig:obj "model" (b-pick-model (pig:jget routed "model")) "thinkingLevel" (pig:jget routed "thinkingLevel") "state" (pig:jget routed "state"))
                     "second" (pig:jget second "state") "requests" (b-vec (reverse requests))
                     "physicalIsNull" (b-yes (null (pig:runtime-get-physical-model rt "mr-virtual" "v1")))
                     "unknown" (b-error-text (lambda () (pig:runtime-resolve-model rt local (vector) (pig:obj "reason" "user" "thinkingLevel" "off"))))))
      (pig:runtime-unregister-virtual-model rt "mr-virtual" "v1")
      (setf (gethash "after" (gethash "virtual" r)) (b-yes (null (pig:runtime-get-model rt "mr-virtual" "v1")))))
    (let ((refreshed (pig:runtime-refresh rt (pig:obj "allowNetwork" :false))))
      (setf (gethash "refresh" r) (pig:obj "aborted" (pig:jget refreshed "aborted") "errors" (pig:jget refreshed "errors"))))
    (flet ((of-local (models) (b-vec (b-ids (remove-if-not (lambda (m) (equal (pig:jget m "provider") "mr-local")) (b-list models))))))
      (setf (gethash "available" r)
            (pig:obj "ofProvider" (b-vec (b-ids (pig:runtime-get-available rt "mr-local"))) "all" (of-local (pig:runtime-get-available rt))
                     "snapshot" (of-local (pig:runtime-get-available-snapshot rt)) "allOfProvider" (b-vec (b-ids (pig:runtime-get-all-available rt "mr-local")))
                     "ofType" (b-vec (b-ids (pig:runtime-get-available-of-type rt "chat" "mr-local")))
                     "unavailableProvider" (length (pig:runtime-get-available rt "nope-prov")))))
    (let* ((conversation (b-conversation)) (options (pig:obj "maxTokens" 50))
           (stream (pig:runtime-stream-simple rt local conversation options))
           (events (b-types stream)) (message (pig:model-stream-result stream))
           (completed (pig:runtime-complete-simple rt local conversation options)) (full (pig:runtime-complete rt local conversation options)))
      (setf (gethash "stream" r)
            (pig:obj "events" (b-vec events) "stopReason" (pig:jget message "stopReason") "text" (b-message-text message) "provider" (pig:jget message "provider")
                     "model" (pig:jget message "model") "api" (pig:jget message "api") "completed" (b-message-text completed) "full" (pig:jget full "stopReason")
                     "unknownProvider" (pig:jget (pig:runtime-complete-simple rt (b-with local "provider" "nope-prov") conversation (pig:obj)) "stopReason"))))
    (let ((classified (pig:runtime-classify rt local (pig:obj "state" (pig:obj) "questions" (pig:obj))))
          (imaged (pig:runtime-generate-images rt local (pig:obj "input" (vector (pig:obj "type" "text" "text" "a cat"))))))
      (setf (gethash "typed" r)
            (pig:obj "classifyStop" (pig:jget classified "stopReason") "classifyError" (pig:jget classified "errorMessage")
                     "imagesStop" (pig:jget imaged "stopReason") "imagesError" (pig:jget imaged "errorMessage"))))
    (let* ((seen '()) (events '())
           (credential (pig:runtime-login rt "openai" "api_key" (lambda (p) (push (pig:jget p "type") seen) "sk-login")
                                          :notify (lambda (event) (push (pig:jget event "type") events)))))
      (flet ((sorted-ids () (b-vec (sort (mapcar (lambda (c) (pig:jget c "providerId")) (b-list (pig:runtime-list-credentials rt))) #'string<))))
        (setf (gethash "login" r)
              (pig:obj "credential" credential "prompts" (b-vec (reverse seen)) "events" (b-vec (reverse events)) "listed" (sorted-ids)
                       "status" (pig:runtime-get-provider-auth-status rt "openai")))
        (pig:runtime-logout rt "openai")
        (setf (gethash "afterLogout" (gethash "login" r)) (sorted-ids))))
    ;; not reported: the stream and native-provider forms of the runtime, which model_registry reports through the registry
    (pig:model-stream-result (pig:runtime-stream rt local (b-conversation) (pig:obj "maxTokens" 50)))
    (let ((model (b-with (b-native-model "rt-native") "provider" "rt-native")))
      (pig:runtime-register-native-provider rt (b-native-provider "rt-native" "Runtime Native" model "r" (lambda (input) (declare (ignore input)) nil) (lambda (input) (declare (ignore input)) nil)))
      (pig:runtime-unregister-provider rt "rt-native"))
    (setf (gethash "stored" r) (b-read-json auth))
    r))

;;; ---------------------------------------------------------------- model_registry

(defun b-native-model (provider)
  (pig:obj "id" "n1" "name" "N One" "api" "nat-api" "provider" provider "reasoning" :false "input" (vector "text") "cost" (b-cost-zero) "contextWindow" 4000 "maxTokens" 500))

(defun b-key-auth (check resolve)
  (pig:make-provider-auth :api-key (pig:make-api-key-auth :name "Key" :check check :resolve resolve)))

(defun b-native-provider (id name model tag check resolve)
  (pig:create-provider :id id :name name :auth (b-key-auth check resolve) :models (list model)
                       :api (pig:obj "nat-api" (pig:make-provider-streams :stream (b-scripted (concatenate 'string tag ".stream"))
                                                                          :stream-simple (b-scripted (concatenate 'string tag ".simple"))))))

(def-script "model_registry" (ctx args)
  (let* ((rt (pig:runtime-create ctx :auth-path (pig:jget args "mrAuth") :models-path (pig:jget args "mrModels") :models-store-path (pig:jget args "mrStore")))
         (registry (pig:make-runtime-registry rt)) (server (pig:jget args "mrServer"))
         (local (pig:runtime-registry-find registry "mr-local" "m1"))
         (unknown (b-with local "provider" "nope-prov")) (r (pig:obj)) (conversation (b-conversation)))
    (flet ((of (models provider) (remove-if-not (lambda (m) (equal (pig:jget m "provider") provider)) (b-list models)))
           (provider-id (found) (and found (pig:provider-id found))))
      (setf (gethash "catalog" r)
            (pig:obj "error" (pig:runtime-registry-get-error registry)
                     "all" (b-vec (mapcar #'b-pick-model (of (pig:runtime-registry-get-all registry) "mr-local")))
                     "builtinListed" (b-yes (plusp (length (of (pig:runtime-registry-get-all registry) "anthropic"))))
                     "available" (b-vec (b-ids (of (pig:runtime-registry-get-available registry) "mr-local")))
                     "one" (b-pick-model local) "missing" (b-yes (null (pig:runtime-registry-find registry "mr-local" "nope")))
                     "findOfType" (b-pick-model (pig:runtime-registry-find-of-type registry "chat" "mr-local" "m1"))
                     "ofType" (b-vec (b-ids (pig:runtime-registry-get-models-of-type registry "chat" "mr-local")))
                     "oneOfType" (b-pick-model (pig:runtime-registry-get-model-of-type registry "chat" "mr-local" "m1"))
                     "oneOfTypeMissing" (b-yes (null (pig:runtime-registry-get-model-of-type registry "image" "mr-local" "m1")))
                     "imagesOfType" (length (pig:runtime-registry-get-models-of-type registry "image" "mr-local"))
                     "availableOfType" (b-vec (b-ids (pig:runtime-registry-get-available-of-type registry "chat" "mr-local")))))
      (setf (gethash "auth" r)
            (pig:obj "configured" (b-yes (pig:runtime-registry-has-configured-auth-p registry local))
                     "unconfigured" (b-yes (pig:runtime-registry-has-configured-auth-p registry unknown))
                     "oauth" (b-yes (pig:runtime-registry-is-using-oauth-p registry local))
                     "status" (pig:runtime-registry-get-provider-auth-status registry "mr-local")
                     "storedStatus" (pig:runtime-registry-get-provider-auth-status registry "stored-prov")
                     "unknownStatus" (pig:runtime-registry-get-provider-auth-status registry "nope-prov")
                     "displayLocal" (pig:runtime-registry-get-provider-display-name registry "mr-local")
                     "displayBuiltin" (pig:runtime-registry-get-provider-display-name registry "anthropic")
                     "displayUnknown" (pig:runtime-registry-get-provider-display-name registry "nope-prov")
                     "providerAuth" (pig:runtime-registry-get-provider-auth registry "mr-local")
                     "providerAuthNone" (pig:runtime-registry-get-provider-auth registry "nope-prov")
                     "apiKey" (pig:runtime-registry-get-api-key-for-provider registry "mr-local")
                     "apiKeyNone" (pig:runtime-registry-get-api-key-for-provider registry "nope-prov")
                     "request" (pig:runtime-registry-get-api-key-and-headers registry local)
                     "requestUnconfigured" (pig:runtime-registry-get-api-key-and-headers registry unknown)))
      (let ((before (pig:runtime-registry-get-registered-provider-ids registry)) config)
        (pig:runtime-registry-register-provider registry "reg-prov" (let ((c (b-registered-provider-config))) (setf (gethash "baseUrl" c) server) c))
        (setf config (pig:runtime-registry-get-registered-provider-config registry "reg-prov"))
        (setf (gethash "registered" r)
              (pig:obj "before" before "ids" (pig:runtime-registry-get-registered-provider-ids registry)
                       "models" (b-vec (mapcar #'b-pick-model (of (pig:runtime-registry-get-all registry) "reg-prov")))
                       "baseUrl" (pig:jget config "baseUrl") "apiKey" (pig:jget config "apiKey") "api" (pig:jget config "api") "headers" (pig:jget config "headers")
                       "modelIds" (b-vec (b-ids (pig:jget config "models")))
                       "unregisteredConfig" (b-yes (null (pig:runtime-registry-get-registered-provider-config registry "nope-prov")))
                       "rejected" (b-error-text (lambda () (pig:runtime-registry-register-provider registry "bad-prov" (pig:obj "models" (vector (pig:obj "id" "x"))))))))
        (pig:runtime-registry-unregister-provider registry "reg-prov")
        (setf (gethash "after" (gethash "registered" r))
              (pig:obj "ids" (pig:runtime-registry-get-registered-provider-ids registry)
                       "models" (length (of (pig:runtime-registry-get-all registry) "reg-prov"))
                       "config" (b-yes (null (pig:runtime-registry-get-registered-provider-config registry "reg-prov"))))))
      (let* ((native-model (b-native-model "nreg"))
             (provider (b-native-provider "nreg" "Native Reg" native-model "n" (lambda (input) (declare (ignore input)) (pig:make-auth-check :type "api_key" :source "ext check"))
                                          (lambda (input) (declare (ignore input)) (pig:make-auth-result :auth (pig:obj "apiKey" "nk"))))))
        (pig:runtime-registry-register-provider registry provider)
        (let* ((native-stream (pig:runtime-registry-stream-simple registry native-model conversation (pig:obj)))
               (native-events (b-types native-stream)) (native-message (pig:model-stream-result native-stream)) registered)
          (pig:runtime-registry-refresh registry (pig:obj "allowNetwork" :false))
          (setf registered (pig:runtime-registry-get-registered-native-provider registry "nreg"))
          (setf (gethash "native" r)
                (pig:obj "registered" (provider-id registered) "same" (b-yes (eq registered provider))
                         "viaGetProvider" (provider-id (pig:runtime-registry-get-provider registry "nreg")) "viaRuntime" (provider-id (pig:runtime-get-provider rt "nreg"))
                         "viaRuntimeRegistered" (provider-id (pig:runtime-get-registered-native-provider rt "nreg"))
                         "none" (b-yes (null (pig:runtime-registry-get-registered-native-provider registry "nope-prov")))
                         "noneProvider" (b-yes (null (pig:runtime-registry-get-provider registry "nope-prov")))
                         "ids" (pig:runtime-registry-get-registered-provider-ids registry)
                         "displayName" (pig:runtime-registry-get-provider-display-name registry "nreg")
                         "models" (b-vec (b-ids (of (pig:runtime-registry-get-all registry) "nreg")))
                         "auth" (pig:runtime-registry-get-provider-auth registry "nreg") "request" (pig:runtime-registry-get-api-key-and-headers registry native-model)
                         "events" (b-vec native-events) "text" (b-message-text native-message) "stopReason" (pig:jget native-message "stopReason")
                         "completed" (pig:jget (pig:runtime-registry-complete registry native-model conversation (pig:obj)) "stopReason")
                         "configured" (b-yes (pig:runtime-registry-has-configured-auth-p registry native-model)))))
        (pig:runtime-registry-unregister-provider registry "nreg")
        (setf (gethash "after" (gethash "native" r))
              (pig:obj "registered" (b-yes (null (pig:runtime-registry-get-registered-native-provider registry "nreg")))
                       "provider" (b-yes (null (pig:runtime-registry-get-provider registry "nreg")))
                       "models" (length (of (pig:runtime-registry-get-all registry) "nreg")))))
      ;; a stored credential makes registration mark the provider configured at once; its auth check finds no key, so the settled state is unconfigured
      (let* ((stored-model (b-with (b-native-model "stored-prov") "provider" "stored-prov"))
             (stored-provider (b-native-provider "stored-prov" "Stored Native" stored-model "s" (lambda (input) (declare (ignore input)) nil) (lambda (input) (declare (ignore input)) nil))))
        (pig:runtime-registry-register-provider registry stored-provider)
        (pig:runtime-registry-refresh registry (pig:obj "allowNetwork" :false))
        (setf (gethash "storedSettled" (gethash "native" r))
              (pig:obj "configured" (b-yes (pig:runtime-registry-has-configured-auth-p registry stored-model))
                       "status" (pig:runtime-registry-get-provider-auth-status registry "stored-prov")
                       "available" (b-yes (some (lambda (m) (equal (pig:jget m "provider") "stored-prov")) (pig:runtime-registry-get-available registry)))))
        (pig:runtime-registry-unregister-provider registry "stored-prov")
        (pig:runtime-registry-refresh registry (pig:obj "allowNetwork" :false)))
      (setf (gethash "builtin" r)
            (pig:obj "provider" (handler-case (pig:provider-id (pig:runtime-registry-get-provider registry "anthropic")) (error (e) (format nil "error: ~A" e)))
                     "providers" (handler-case (if (some (lambda (candidate) (equal (pig:provider-id candidate) "anthropic")) (pig:runtime-get-providers rt)) "anthropic" "absent")
                                   (error (e) (format nil "error: ~A" e)))))
      (pig:runtime-registry-register-virtual-model
       registry (pig:make-virtual-model :provider "mr-virtual" :id "v1" :name "Virtual One" :thinking-levels (list "off" "high") :context-window 1000 :max-tokens 100
                                        :input (list "text")
                                        :route (lambda (ctx request) (declare (ignore ctx request))
                                                 (pig:obj "model" (pig:runtime-get-physical-model rt "mr-local" "m1") "thinkingLevel" "off"))))
      (let ((virtual (pig:runtime-registry-find registry "mr-virtual" "v1")))
        (setf (gethash "virtual" r) (pig:obj "model" (b-pick-model virtual) "thinkingLevels" (pig:jget virtual "thinkingLevels"))))
      (pig:runtime-registry-unregister-virtual-model registry "mr-virtual" "v1")
      (setf (gethash "after" (gethash "virtual" r)) (b-yes (null (pig:runtime-registry-find registry "mr-virtual" "v1"))))
      (let ((refreshed (pig:runtime-registry-refresh registry (pig:obj "allowNetwork" :false))))
        (setf (gethash "refresh" r) (pig:obj "aborted" (pig:jget refreshed "aborted") "errors" (pig:jget refreshed "errors"))))
      (let* ((options (pig:obj "maxTokens" 50)) (stream (pig:runtime-registry-stream-simple registry local conversation options))
             (events (b-types stream)) (result (pig:model-stream-result stream))
             (full (pig:runtime-registry-complete registry local conversation options))
             (classified (pig:runtime-registry-classify registry local (pig:obj "state" (pig:obj) "questions" (pig:obj))))
             (imaged (pig:runtime-registry-generate-images registry local (pig:obj "input" (vector (pig:obj "type" "text" "text" "a cat"))))))
        (setf (gethash "stream" r)
              (pig:obj "events" (b-vec events) "stopReason" (pig:jget result "stopReason") "text" (b-message-text result) "provider" (pig:jget result "provider")
                       "model" (pig:jget result "model") "api" (pig:jget result "api") "full" (pig:jget full "stopReason")
                       "classifyStop" (pig:jget classified "stopReason") "classifyError" (pig:jget classified "errorMessage")
                       "imagesStop" (pig:jget imaged "stopReason") "imagesError" (pig:jget imaged "errorMessage")))))
    r))

;;; ---------------------------------------------------------------- create_provider

(defun b-m (id api &rest extra)
  (let ((model (pig:obj "id" id "name" id "api" api "provider" "cp")))
    (loop for (key value) on extra by #'cddr do (setf (gethash key model) value))
    model))

(defun b-kind (value) (if value "function" "undefined"))
(defun b-thrown (fn) (handler-case (progn (funcall fn) "no error") (error (e) (princ-to-string e))))

(defun b-drain (stream)
  (let* ((types (b-types stream)) (result (pig:model-stream-result stream)))
    (pig:obj "types" (b-vec types) "text" (b-message-text result) "stopReason" (pig:jget result "stopReason") "error" (pig:jget result "errorMessage") "api" (pig:jget result "api")
             "provider" (pig:jget result "provider") "model" (pig:jget result "model") "usageZero" (b-yes (eql (pig:jref result "usage" "totalTokens") 0))
             "timestampIsNumber" (b-yes (realp (pig:jget result "timestamp"))))))

(defun b-pick-operation (result)
  (pig:obj "api" (pig:jget result "api") "provider" (pig:jget result "provider") "model" (pig:jget result "model") "stopReason" (pig:jget result "stopReason")
           "error" (pig:jget result "errorMessage") "output" (pig:jget result "output") "answers" (pig:jget result "answers")
           "timestampIsNumber" (b-yes (realp (pig:jget result "timestamp")))))

(def-script "create_provider" (ctx args)
  (let* ((r (pig:obj))
         (auth (pig:make-provider-auth :api-key (pig:make-api-key-auth :name "Key" :resolve (lambda (input) (declare (ignore input)) (pig:make-auth-result :auth (pig:obj "apiKey" "k"))))))
         (base (list (b-m "c1" "api-a") (b-m "c2" "api-b") (b-m "i1" "img-a" "type" "image") (b-m "k1" "cls-a" "type" "classifier")))
         (options (pig:make-provider-stream-options)))
    (labels ((impl (tag &rest extra)
               (apply #'pig:make-provider-streams :stream (b-scripted (concatenate 'string tag ".stream")) :stream-simple (b-scripted (concatenate 'string tag ".simple")) extra))
             (provider (&rest keys) (apply #'pig:create-provider :auth auth keys)))
      (let ((p (provider :id "cp" :models base :api (pig:obj "api-a" (impl "a") "api-b" (impl "b")) :base-url "http://x" :headers (pig:obj "h" "1")))
            (named (provider :id "cp2" :name "Named" :models '() :api (impl "s")))
            (sp (provider :id "sp" :models '() :api (impl "s"))))
        (setf (gethash "meta" r)
              (pig:obj "id" (pig:provider-id p) "name" (pig:provider-name p) "baseUrl" (pig:provider-base-url p) "headers" (pig:provider-headers p) "named" (pig:provider-name named)
                       "methods" (pig:obj "fetchDeferred" (b-kind (pig:provider-fetch-deferred p)) "cancelDeferred" (b-kind (pig:provider-cancel-deferred p))
                                          "generateImages" (b-kind (pig:provider-generate-images p)) "classify" (b-kind (pig:provider-classify p))
                                          "refreshModels" (b-kind (pig:provider-refresh-models p)) "filterModels" (b-kind (pig:provider-filter-models p))
                                          "filterAllModels" (b-kind (pig:provider-filter-all-models p)))))
        (setf (gethash "models" r)
              (pig:obj "chat" (b-vec (b-ids (funcall (pig:provider-get-models p)))) "all" (b-vec (b-ids (funcall (pig:provider-get-all-models p))))))
        (setf (gethash "dispatch" r)
              (pig:obj "a" (b-drain (funcall (pig:provider-stream p) (first base) (pig:obj) options))
                       "b" (b-drain (funcall (pig:provider-stream-simple p) (second base) (pig:obj) options))
                       "missing" (b-drain (funcall (pig:provider-stream p) (b-m "c9" "api-z") (pig:obj) options))
                       "noApi" (b-drain (funcall (pig:provider-stream-simple p) (pig:obj "id" "c8" "provider" "cp") (pig:obj) options))
                       "single" (b-drain (funcall (pig:provider-stream sp) (b-m "x" "anything") (pig:obj) options))))
        (setf (gethash "invalid" r)
              (pig:obj "none" (b-thrown (lambda () (provider :id "e1" :models '())))
                       "empty" (b-thrown (lambda () (provider :id "e2" :models '() :api (pig:obj) :images (pig:obj) :classifiers (pig:obj))))))
        (let* ((cancelled '())
               (d (provider :id "dp" :models '()
                            :api (pig:obj "api-a" (impl "a" :fetch-deferred (lambda (model handle o) (funcall (b-scripted (concatenate 'string "a.fetch." (pig:jget handle "id"))) model handle o))
                                                            :cancel-deferred (lambda (model handle o) (declare (ignore model o)) (push (pig:jget handle "id") cancelled)))
                                          "api-b" (impl "b"))))
               (broken (provider :id "bp" :models '()
                                 :api (pig:obj "api-a" (impl "a" :fetch-deferred (lambda (model handle o) (declare (ignore model handle o)) (error "fetch boom")))))))
          (setf (gethash "deferred" r)
                (pig:obj "fetched" (b-drain (funcall (pig:provider-fetch-deferred d) (b-m "c1" "api-a") (pig:obj "id" "h1") options))
                         "unsupported" (b-drain (funcall (pig:provider-fetch-deferred d) (b-m "c2" "api-b") (pig:obj "id" "h2") options))
                         "noApi" (b-drain (funcall (pig:provider-fetch-deferred d) (b-m "c3" "api-z") (pig:obj "id" "h3") options))
                         "thrown" (b-drain (funcall (pig:provider-fetch-deferred broken) (b-m "c1" "api-a") (pig:obj "id" "h4") options))
                         "cancelOk" (b-thrown (lambda () (funcall (pig:provider-cancel-deferred d) (b-m "c1" "api-a") (pig:obj "id" "h1") options)))
                         "cancelled" (b-vec (reverse cancelled))
                         "cancelUnsupported" (b-thrown (lambda () (funcall (pig:provider-cancel-deferred d) (b-m "c2" "api-b") (pig:obj "id" "h2") options)))
                         "cancelNoApi" (b-thrown (lambda () (funcall (pig:provider-cancel-deferred d) (b-m "c3" "api-z") (pig:obj "id" "h3") options))))))
        (let* ((o (provider :id "op" :models '()
                            :images (pig:obj "img-a" (lambda (model request options) (declare (ignore request options))
                                                       (pig:obj "api" (pig:jget model "api") "provider" (pig:jget model "provider") "model" (pig:jget model "id")
                                                                "output" (vector (pig:obj "type" "image" "data" "x")) "stopReason" "stop" "timestamp" 1)))
                            :classifiers (pig:obj "cls-a" (lambda (model request options) (declare (ignore request options))
                                                            (pig:obj "api" (pig:jget model "api") "provider" (pig:jget model "provider") "model" (pig:jget model "id")
                                                                     "answers" (pig:obj "q" "a") "stopReason" "stop" "timestamp" 1)))))
               (operation-options (pig:make-provider-operation-options)))
          (setf (gethash "operations" r)
                (pig:obj "methods" (pig:obj "stream" "function" "generateImages" (b-kind (pig:provider-generate-images o)) "classify" (b-kind (pig:provider-classify o)))
                         "image" (b-pick-operation (funcall (pig:provider-generate-images o) (b-m "i1" "img-a" "type" "image") (pig:obj) operation-options))
                         "imageMissing" (b-pick-operation (funcall (pig:provider-generate-images o) (b-m "i2" "img-z" "type" "image") (pig:obj) operation-options))
                         "classify" (b-pick-operation (funcall (pig:provider-classify o) (b-m "k1" "cls-a" "type" "classifier") (pig:obj) operation-options))
                         "classifyMissing" (b-pick-operation (funcall (pig:provider-classify o) (b-m "k2" "cls-z" "type" "classifier") (pig:obj) operation-options)))))
        (let* ((fetch-calls '()) (publications '())
               (f (provider :id "fp" :models (list (b-m "c1" "api-a" "name" "Base One") (b-m "c2" "api-a")) :api (impl "f")
                            :fetch-models (lambda (context)
                                            (push (b-yes (pig:refresh-models-context-allow-network context)) fetch-calls)
                                            (list (b-m "c1" "api-a" "name" "Fetched One") (b-m "c3" "api-a") (b-m "u1" "api-a" "type" "future") (b-m "i1" "img-a" "type" "image")))))
               (refresh (pig:obj)))
          (labels ((catalog ()
                     (b-vec (mapcar (lambda (model) (format nil "~A:~A:~A" (pig:jget model "id") (pig:jget model "name") (let ((type (pig:jget model "type"))) (if (stringp type) type "chat"))))
                                    (funcall (pig:provider-get-all-models f)))))
                   (publish (publication)
                     (let ((persist (pig:models-publication-persist publication)))
                       (push (pig:obj "persist" (if (eq persist :omitted)
                                                    "omitted"
                                                    (pig:obj "models" (b-vec (b-ids (pig:jget persist "models"))) "checkedAt" (if (realp (pig:jget persist "checkedAt")) "number" "other")))
                                      "update" (b-kind (pig:models-publication-update publication)))
                             publications))
                     (when (pig:models-publication-update publication) (funcall (pig:models-publication-update publication)))
                     t)
                   (context (&key (allow-network t) signal stored (publisher #'publish))
                     (pig:make-refresh-models-context :publish publisher :stored stored :allow-network allow-network :signal (or signal (pig::make-abort-signal))))
                   (calls () (b-vec (reverse fetch-calls)))
                   (published () (b-vec (reverse publications))))
            (let ((stored (pig:obj "models" (vector (b-m "c1" "api-a" "name" "Stored One" "provider" "fp") (b-m "z9" "api-a" "provider" "other"))))
                  (aborted (pig::make-abort-signal)))
              (setf (gethash "present" refresh) (b-kind (pig:provider-refresh-models f)) (gethash "absent" refresh) (b-kind (pig:provider-refresh-models p))
                    (gethash "initial" refresh) (catalog))
              (funcall (pig:provider-refresh-models f) (context :allow-network nil :stored stored))
              (setf (gethash "restoredOffline" refresh) (pig:obj "catalog" (catalog) "fetchCalls" (calls) "publications" (published)))
              (setf publications '())
              (pig::signal-abort aborted)
              (funcall (pig:provider-refresh-models f) (context :signal aborted :stored stored))
              (setf (gethash "aborted" refresh) (pig:obj "fetchCalls" (calls) "publications" (published)))
              (setf publications '())
              (funcall (pig:provider-refresh-models f) (context :stored stored :publisher (lambda (publication) (declare (ignore publication)) nil)))
              (setf (gethash "refused" refresh) (pig:obj "catalog" (catalog) "fetchCalls" (calls)))
              (funcall (pig:provider-refresh-models f) (context))
              (setf (gethash "fetched" refresh)
                    (pig:obj "catalog" (catalog) "fetchCalls" (calls) "publications" (published) "chat" (b-vec (b-ids (funcall (pig:provider-get-models f))))))
              (setf (gethash "refresh" r) refresh))))))
    r))

