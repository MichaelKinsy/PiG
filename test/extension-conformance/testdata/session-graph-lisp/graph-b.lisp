(defun b-quiet-loader (ctx cwd agent-dir settings &rest more)
  (apply #'pig:make-resource-loader ctx :cwd cwd :agent-dir agent-dir :settings-manager settings :no-extensions t :no-skills t :no-prompt-templates t :no-themes t
                                        :no-context-files t more))

(defun b-settings (ctx provider model)
  (pig:settings-in-memory ctx (pig:obj "compaction" (pig:obj "enabled" :false) "retry" (pig:obj "enabled" :false) "defaultProvider" provider "defaultModel" model)))

(defun b-custom-data (manager custom-type)
  (b-vec (loop for entry across (pig:sm-get-entries manager)
               when (and (equal (pig:jget entry "type") "custom") (equal (pig:jget entry "customType") custom-type)) collect (pig:jget entry "data"))))

(def-script "extension_refs" (ctx args)
  (let* ((cwd (pig:jget args "cwd")) (agent-dir (pig:jget args "agentDir"))
         (rt (pig:runtime-create ctx :auth-path (pig:jget args "mrAuth") :models-path (pig:jget args "mrModels") :models-store-path (pig:jget args "mrStore")))
         (settings (b-settings ctx "mr-local" "m1")) (r (pig:obj)))
    (flet ((observe (factories tools)
             (let ((loader (b-quiet-loader ctx cwd agent-dir settings :extension-factories factories :additional-extension-paths (list (pig:jget args "refsProbe"))))
                   (manager (pig:sm-in-memory ctx cwd)))
               (pig:loader-reload loader)
               (let ((session (pig:ctx-create-agent-session ctx :session-manager manager :settings-manager settings :model-runtime rt :resource-loader loader :tools tools)))
                 (pig:agent-session-bind-extensions session)
                 (prog1 (b-custom-data manager "refs_seen") (pig:agent-session-dispose session)))))
           (factories ()
             (list (pig:create-codemode-extension :mode "only" :inline-budget 123 :models :false) (pig:create-tool-search-extension)
                   (pig:create-mcp-extension :log-path (concatenate 'string (pig:jget args "dir") "/mcp.log") :startup-wait-ms 0))))
      (let ((both (list "codemode" "tool_search")))
        (setf (gethash "inactive" r) (observe (factories) nil)
              (gethash "active" r) (observe (factories) both)
              (gethash "defaults" r) (observe (list (pig:create-codemode-extension) (pig:create-tool-search-extension)) both)
              (gethash "none" r) (observe nil both))))
    r))

;;; ---------------------------------------------------------------- mcp_options

(defun b-log-add (log key entry)
  (sb-thread:with-mutex ((car log)) (push entry (getf (cdr log) key)) nil))

(defun b-log-all (log key) (b-vec (reverse (getf (cdr log) key))))

(defun b-mcp-reply (message)
  (when (nth-value 1 (gethash "id" message))
    (flet ((reply (result) (pig:obj "jsonrpc" "2.0" "id" (pig:jget message "id") "result" result))
           (method () (pig:jget message "method")))
      (cond ((equal (method) "initialize")
             (reply (pig:obj "protocolVersion" (pig:jref message "params" "protocolVersion") "capabilities" (pig:obj "tools" (pig:obj))
                             "serverInfo" (pig:obj "name" "fake" "version" "1"))))
            ((equal (method) "tools/list")
             (reply (pig:obj "tools" (vector (pig:obj "name" "echo" "description" "Echo text"
                                                      "inputSchema" (pig:obj "type" "object" "properties" (pig:obj "text" (pig:obj "type" "string")) "required" (vector "text")))))))
            ((equal (method) "tools/call")
             (reply (pig:obj "content" (vector (pig:obj "type" "text" "text" (concatenate 'string "echo:" (pig:jref message "params" "arguments" "text")))))))
            ((equal (method) "ping") (reply (pig:obj)))
            (t (pig:obj "jsonrpc" "2.0" "id" (pig:jget message "id") "error" (pig:obj "code" -32601 "message" "method not found")))))))

(defun b-mcp-transport (log key auth)
  (let (transport)
    (setf transport
          (pig:make-mcp-transport
           :start (lambda ()
                    (b-log-add log key "start")
                    (when auth
                      (let ((token (pig:mcp-auth-token auth))) (b-log-add log key (if token (format nil "token ~A" token) "token undefined")))))
           :send (lambda (message signal)
                   (declare (ignore signal))
                   (b-log-add log key (format nil "send ~A" (or (pig:jget message "method") "response")))
                   (let ((reply (b-mcp-reply message))) (when reply (pig:mcp-transport-emit-message transport reply))))
           :close (lambda () (b-log-add log key "close") (pig:mcp-transport-emit-close transport))))
    transport))

(defun b-mcp-server-store (log name state)
  (pig:make-mcp-server-store
   :load (lambda () (b-log-add log :credentials (format nil "load ~A" name)) state)
   :save (lambda (state) (declare (ignore state)) (b-log-add log :credentials (format nil "save ~A" name)) nil)
   :with-refresh-lock (lambda (fn) (b-log-add log :credentials (format nil "lock ~A" name)) (funcall fn))))

(def-script "mcp_options" (ctx args)
  (let* ((cwd (pig:jget args "cwd")) (agent-dir (pig:jget args "agentDir")) (log (cons (sb-thread:make-mutex) '()))
         (rt (pig:runtime-create ctx :auth-path (pig:jget args "mrAuth") :models-path (pig:jget args "mrToolModels") :models-store-path (pig:jget args "mrStore")))
         (settings (b-settings ctx "mr-tool" "m1"))
         (state (pig:obj "serverUrl" "http://127.0.0.1:9/mcp" "tokens" (pig:obj "access_token" "tok-1" "token_type" "Bearer")))
         (factory (pig:create-mcp-extension
                   :load-config (lambda (c)
                                  (b-log-add log :load-config (pig:obj "cwd" (pig:jget c "cwd") "isProjectTrusted" (pig:jget c "isProjectTrusted")))
                                  (pig:obj "servers" (vector (pig:obj "name" "demo" "config" (pig:obj "command" "unused" "exposure" "direct") "source" "<config>" "scope" "global")
                                                             (pig:obj "name" "remote" "config" (pig:obj "url" "http://127.0.0.1:9/mcp" "exposure" "direct") "source" "<config>" "scope" "global"))
                                           "errors" (vector)))
                   :create-transport (lambda (entry transport-cwd auth)
                                       (let ((key (if (equal (pig:jget entry "name") "remote") :remote :demo)))
                                         (b-log-add log key (format nil "create ~A cwd=~A auth=~A" (pig:jget entry "name") transport-cwd (if auth "true" "false")))
                                         (b-mcp-transport log key auth)))
                   :credentials (pig:make-mcp-credential-store
                                 :for-server (lambda (name url) (b-log-add log :credentials (format nil "forServer ~A ~A" name url)) (b-mcp-server-store log name state))
                                 :tokens (lambda (name url) (b-log-add log :credentials (format nil "tokens ~A ~A" name url))
                                           (pig:obj "access_token" "tok-1" "token_type" "Bearer"))
                                 :remove (lambda (name url) (b-log-add log :credentials (format nil "remove ~A ~A" name url)) t))
                   :open-url (lambda (url) (declare (ignore url)) nil) :update-config (lambda (entry patch) (declare (ignore entry patch)) nil)
                   :log-path (concatenate 'string agent-dir "/mcp.log")))
         (loader (b-quiet-loader ctx cwd agent-dir settings :additional-extension-paths (list (pig:jget args "mcpProbe")) :extension-factories (list factory)))
         (manager (pig:sm-in-memory ctx cwd)))
    (pig:loader-reload loader)
    (let ((session (pig:ctx-create-agent-session ctx :session-manager manager :settings-manager settings :model-runtime rt :resource-loader loader)))
      (pig:agent-session-bind-extensions session)
      (dolist (prompt '("call the tool" "/mcp reconnect demo" "/mcp logout remote")) (pig:agent-session-prompt session prompt))
      (let ((messages (b-vec (loop for message across (pig:agent-session-messages session)
                                   when (equal (pig:jget message "role") "toolResult") collect (b-message-text message))))
            (seen (b-custom-data manager "mcp_seen")))
        (prog1 (sb-thread:with-mutex ((car log))
                 (pig:obj "messages" messages "seen" seen
                          "log" (pig:obj "demo" (b-log-all log :demo) "remote" (b-log-all log :remote) "credentials" (b-log-all log :credentials)
                                         "loadConfig" (b-log-all log :load-config))))
          (pig:agent-session-dispose session))))))

