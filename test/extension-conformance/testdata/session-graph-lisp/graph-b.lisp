(defun b-view (found) (if found "function" "undefined"))

(defun b-runtime-view (runtime)
  (pig:obj "flagValues" (pig:extension-runtime-get-flag-values runtime) "providers" (length (pig:extension-runtime-pending-provider-registrations runtime))
           "nativeProviders" (length (pig:extension-runtime-pending-native-provider-registrations runtime))
           "virtualModels" (length (pig:extension-runtime-pending-virtual-model-registrations runtime)) "mcpServers" (length (pig:extension-runtime-mcp-servers runtime))))

(defun b-renderers-view (found)
  (and found (pig:obj "renderShell" (pig:jget found "renderShell") "renderCall" (b-view (eq (pig:jget found "renderCall") t))
                      "renderResult" (b-view (eq (pig:jget found "renderResult") t)))))

(defun b-starts-with (prefix text) (and (>= (length text) (length prefix)) (string= prefix text :end2 (length prefix))))
(defun b-ends-with (suffix text) (and (>= (length text) (length suffix)) (string= suffix text :start2 (- (length text) (length suffix)))))
(defun b-or-empty (value) (if (stringp value) value ""))

(defun b-runner-reads (ctx args runner rt manager keybindings)
  (declare (ignore ctx args))
  (let* ((noop (pig:runner-get-ui-context runner))
         (tool-views (b-vec (map 'list (lambda (tool) (pig:obj "name" (pig:jref tool "definition" "name") "description" (pig:jref tool "definition" "description")
                                                               "scope" (pig:jref tool "sourceInfo" "scope") "origin" (pig:jref tool "sourceInfo" "origin")
                                                               "path" (pig:jref tool "sourceInfo" "path")))
                                 (pig:runner-get-all-registered-tools runner))))
         (shared (pig:runner-get-tool-definition runner "shared"))
         (shortcuts (b-vec (map 'list (lambda (entry) (pig:obj "key" (aref entry 0) "description" (pig:jget (aref entry 1) "description") "extensionPath" (pig:jget (aref entry 1) "extensionPath")))
                                (pig:runner-get-shortcuts runner keybindings))))
         (commands (b-vec (map 'list (lambda (c) (pig:obj "name" (pig:jget c "name") "invocationName" (pig:jget c "invocationName") "description" (pig:jget c "description")
                                                          "path" (pig:jref c "sourceInfo" "path")))
                               (pig:runner-get-registered-commands runner))))
         (alpha nil))
    (flet ((invocation (name) (let ((found (pig:runner-get-command runner name))) (and found (pig:jget found "invocationName")))))
      ;; an extension process answers a tool renderer resolution on a later turn: ask until the answer is the extension's
      (dotimes (i 100)
        (setf alpha (pig:runner-resolve-tool-renderers runner "alpha" (lambda () nil)))
        (when alpha (return))
        (sleep 0.05))
      (let* ((context-of (pig:runner-create-context runner))
             (command-before (pig:runner-create-command-context runner)))
        (pig:runner-context-wait-for-idle command-before)
        (let* ((new-before (pig:runner-context-new-session command-before))
               (nested-before (progn (pig:runner-context-reload command-before)
                                     (pig:runner-context-execute-tool (pig:runner-create-tool-context runner "call-0") "alpha" (pig:obj))))
               (twin2 (pig:runner-get-command runner "twin:2"))
               (reads (pig:obj
                       "extensionPaths" (pig:runner-get-extension-paths runner) "tools" tool-views "toolDefinition" (pig:jget shared "description")
                       "missingTool" (pig:runner-get-tool-definition runner "nope") "flags" (pig:runner-get-flags runner) "flagValues" (pig:runner-get-flag-values runner)
                       "shortcuts" shortcuts "shortcutDiagnostics" (pig:runner-get-shortcut-diagnostics runner)
                       "commands" commands "commandDiagnostics" (pig:runner-get-command-diagnostics runner)
                       "commandByName" (pig:obj "hello" (invocation "hello") "twin" (invocation "twin") "twin:2" (and twin2 (pig:jget twin2 "description")) "nope" (invocation "nope"))
                       "hasHandlers" (pig:obj "tool_call" (b-yes (pig:runner-has-handlers-p runner "tool_call")) "session_shutdown" (b-yes (pig:runner-has-handlers-p runner "session_shutdown")))
                       "renderers" (pig:obj "message" (b-view (pig:runner-get-message-renderer-p runner "probe-message"))
                                            "missingMessage" (b-view (pig:runner-get-message-renderer-p runner "nope"))
                                            "entry" (b-view (pig:runner-get-entry-renderer-p runner "probe-entry"))
                                            "missingEntry" (b-view (pig:runner-get-entry-renderer-p runner "nope"))
                                            "markdownTransformers" (pig:runner-get-markdown-transformers runner))
                       "toolRenderers" (pig:obj "alpha" (b-renderers-view alpha)
                                                "other" (b-renderers-view (pig:runner-resolve-tool-renderers runner "other" (lambda () (pig:obj "renderResult" t))))
                                                "none" (b-renderers-view (pig:runner-resolve-tool-renderers runner "other" (lambda () nil))))
                       "hasUI" (b-yes (pig:runner-has-ui-p runner))
                       "noUI" (pig:obj "select" (pig:runner-ui-select noop "t" (list "a")) "confirm" (b-yes (pig:runner-ui-confirm noop "t" "m"))
                                       "input" (pig:runner-ui-input noop "t") "editorText" (pig:runner-ui-get-editor-text noop))
                       "registryIsSame" (b-yes (eq (pig:runner-get-model-registry runner) rt))
                       "activeTools" (b-error-text (lambda () (pig:runner-get-active-tools runner))) "mode" (pig:runner-context-mode context-of)
                       "cwd" (pig:runner-context-cwd context-of)
                       "sessionManagerIsSame" (b-yes (eq (pig:runner-context-session-manager context-of) manager))
                       "modelRegistryIsSame" (b-yes (eq (pig:runner-context-model-registry context-of) rt))
                       "commandContextBeforeBind" (pig:obj "newSession" new-before)
                       "toolContextBeforeBind" (pig:jref nested-before "result" "content" 0 "text"))))
          (pig:runner-set-flag-value runner "probe-flag" "changed")
          (setf (gethash "flagValuesAfterSet" reads) (pig:runner-get-flag-values runner))
          (pig:runner-set-flag-value runner "probe-bool" t)
          (setf (gethash "flagValuesAfterBool" reads) (pig:runner-get-flag-values runner))
          reads)))))

(def-script "extension_runner" (ctx args)
  (let* ((cwd (pig:jget args "cwd")) (agent-dir (pig:jget args "agentDir")) (r (pig:obj))
         (fresh (pig:create-extension-runtime ctx)) (runtime-report (pig:obj "initial" (b-runtime-view fresh) "active" (b-error-text (lambda () (pig:extension-runtime-assert-active fresh))))))
    (pig:extension-runtime-set-flag-value fresh "x" t)
    (pig:extension-runtime-set-flag-value fresh "a" "b")
    (setf (gethash "afterSet" runtime-report) (b-runtime-view fresh))
    (pig:extension-runtime-invalidate fresh "runtime is stale")
    (pig:extension-runtime-invalidate fresh "a second message is ignored")
    (setf (gethash "stale" runtime-report) (b-error-text (lambda () (pig:extension-runtime-assert-active fresh)))
          (gethash "runtime" r) runtime-report)
    (let* ((rt (pig:runtime-create ctx :auth-path (pig:jget args "mrAuth") :models-path (pig:jget args "mrModels") :models-store-path (pig:jget args "mrStore")))
           (settings (b-settings ctx "mr-local" "m1")) (loader-runtime (pig:create-extension-runtime ctx))
           (loader (b-quiet-loader ctx cwd agent-dir settings :runtime loader-runtime
                                                              :additional-extension-paths (list (pig:jget args "runnerProbeA") (pig:jget args "runnerProbeB"))))
           (log '()) (log-lock (sb-thread:make-mutex :name "runner log")))
      (flet ((record (name &rest call-args) (sb-thread:with-mutex (log-lock) (push (coerce (cons name call-args) 'simple-vector) log)) nil))
        (pig:loader-reload loader)
        (let* ((loaded (pig:loader-get-extensions loader)) (extensions (pig:jget loaded "extensions"))
               (loaded-runtime (pig:loaded-extensions-runtime ctx loaded))
               (manager (pig:sm-in-memory ctx cwd))
               (runner (pig:make-extension-runner ctx extensions :runtime loaded-runtime :cwd cwd :session-manager manager :model-registry rt))
               (keybindings (pig:obj "app.interrupt" (vector "ctrl+c") "app.other" (vector "ctrl+k") "app.exit" (vector "ctrl+d"))))
          (setf (gethash "loaded" r)
                (pig:obj "paths" (b-vec (map 'list (lambda (e) (pig:jget e "path")) extensions)) "tools" (b-vec (map 'list (lambda (e) (pig:jget e "tools")) extensions))
                         "errors" (pig:jget loaded "errors") "sources" (b-vec (map 'list (lambda (e) (pig:jref e "sourceInfo" "source")) extensions))
                         "runtime" (b-runtime-view loaded-runtime)))
          (setf (gethash "reads" r) (b-runner-reads ctx args runner rt manager keybindings))
          (let* ((model (pig:runtime-get-model rt "mr-local" "m1"))
                 (source-info (pig:obj "path" "p" "source" "local" "scope" "temporary" "origin" "top-level")))
            (pig:runner-bind-core
             runner
             (list :send-message (lambda (message &optional options) (record "sendMessage" message options))
                   :send-user-message (lambda (content &optional options) (record "sendUserMessage" content options))
                   :append-entry (lambda (custom-type &optional data) (record "appendEntry" custom-type data))
                   :set-session-name (lambda (name) (record "setSessionName" name))
                   :get-session-name (lambda () "session-name")
                   :set-label (lambda (entry-id &optional label) (record "setLabel" entry-id label))
                   :get-active-tools (lambda () (vector "alpha" "beta"))
                   :get-all-tools (lambda () (vector (pig:obj "name" "alpha" "description" "Alpha tool" "parameters" (pig:obj "type" "object") "sourceInfo" source-info)))
                   :get-settings (lambda () (pig:obj "theme" "dark"))
                   :set-active-tools (lambda (names) (record "setActiveTools" names))
                   :refresh-tools (lambda () (record "refreshTools"))
                   :get-commands (lambda () (vector (pig:obj "name" "hello" "description" "d" "source" "extension" "sourceInfo" source-info)))
                   :set-model (lambda (m) (record "setModel" (pig:jget m "id")) t)
                   :get-thinking-level (lambda () "medium")
                   :set-thinking-level (lambda (level) (record "setThinkingLevel" level)))
             (list :get-model (lambda () model)
                   :get-scoped-models (lambda () (vector (pig:obj "model" model "thinkingLevel" "low")))
                   :is-idle (lambda () :false) :is-project-trusted (lambda () t) :get-signal (lambda () nil)
                   :abort (lambda () (record "abort")) :has-pending-messages (lambda () t) :shutdown (lambda () (record "shutdown"))
                   :get-context-usage (lambda () (pig:obj "tokens" 10 "contextWindow" 100 "percent" 10.0d0))
                   :compact (lambda (&optional options) (record "compact" (pig:jget options "customInstructions")))
                   :get-system-prompt (lambda () "bound system prompt")
                   :get-system-prompt-options (lambda () (pig:obj "cwd" cwd "customPrompt" "custom"))
                   :execute-tool (lambda (caller-id name params &optional options)
                                   (declare (ignore options))
                                   (pig:obj "toolCall" (pig:obj "type" "toolCall" "id" (format nil "~A/1" caller-id) "name" name "arguments" params)
                                            "result" (pig:obj "content" (vector (pig:obj "type" "text" "text" (format nil "ran ~A" name))) "details" (pig:obj)) "isError" :false))
                   :get-callable-tools (lambda () (vector (pig:obj "name" "alpha" "label" "Alpha" "description" "Alpha tool" "parameters" (pig:obj "type" "object"))))))
            (setf (gethash "bound" r) (pig:obj "activeTools" (pig:runner-get-active-tools runner) "errors" (vector)))
            (let* ((reported '())
                   (off (pig:runner-on-error runner (lambda (report)
                                                      (push (pig:obj "extensionPath" (pig:jget report "extensionPath") "event" (pig:jget report "event") "error" (pig:jget report "error")) reported))))
                   (emits (pig:obj)))
              (pig:runner-report-unhandled-mcp-servers runner)
              (flet ((put (key value) (when value (setf (gethash key emits) value))))
                (pig:runner-emit runner (pig:obj "type" "session_start" "reason" "startup"))
                (setf (gethash "sessionBeforeSwitch" emits) (pig:runner-emit runner (pig:obj "type" "session_before_switch" "reason" "new")))
                (pig:runner-emit runner (pig:obj "type" "agent_start"))
                (put "toolCall" (pig:runner-emit-tool-call runner (pig:obj "type" "tool_call" "toolCallId" "t1" "toolName" "bash" "input" (pig:obj "command" "ls"))))
                (put "toolCallBlocked" (pig:runner-emit-tool-call runner (pig:obj "type" "tool_call" "toolCallId" "t2" "toolName" "bash" "input" (pig:obj "command" "forbidden"))))
                (put "toolResult" (pig:runner-emit-tool-result runner (pig:obj "type" "tool_result" "toolCallId" "t1" "toolName" "bash" "input" (pig:obj "command" "ls")
                                                                               "content" (vector (pig:obj "type" "text" "text" "out")) "isError" :false)))
                (setf (gethash "inputTransform" emits) (pig:runner-emit-input runner "t:x" nil "interactive")
                      (gethash "inputHandled" emits) (pig:runner-emit-input runner "handled-me" nil "interactive")
                      (gethash "inputContinue" emits) (pig:runner-emit-input runner "plain" nil "rpc")
                      (gethash "context" emits) (pig:runner-emit-context runner (vector (pig:obj "role" "user" "content" "keep" "timestamp" 1)
                                                                                        (pig:obj "role" "user" "content" "drop-me" "timestamp" 2))))
                (let* ((started (pig:runner-emit-before-agent-start runner (pig:obj "messageType" "user" "prompt" "do it") (pig:obj "cwd" cwd "customPrompt" "base")))
                       (options (pig:jget started "systemPromptOptions")) (forced (b-or-empty (pig:jget options "forceSystemPrompt"))))
                  (setf (gethash "beforeAgentStart" emits)
                        (pig:obj "messages" (pig:jget started "messages")
                                 "forced" (pig:obj "startsWithBase" (b-yes (b-starts-with "base" forced)) "endsWithA" (b-yes (b-ends-with "[A]" forced)))
                                 "customPrompt" (pig:jget options "customPrompt"))))
                (put "messageEnd" (pig:runner-emit-message-end runner (pig:obj "type" "message_end" "message" (pig:obj "role" "user" "content" "hi" "timestamp" 1))))
                (setf (gethash "providerRequest" emits) (pig:runner-emit-before-provider-request runner (pig:obj "model" "m"))
                      (gethash "providerHeaders" emits) (pig:runner-emit-before-provider-headers runner (pig:obj "x-del" "d" "x-keep" "k")))
                (put "userBash" (pig:runner-emit-user-bash runner (pig:obj "type" "user_bash" "command" "ls" "excludeFromContext" :false "cwd" cwd)))
                (setf (gethash "resourcesDiscover" emits) (pig:runner-emit-resources-discover runner cwd "startup")
                      (gethash "cacheWarming" emits) (pig:runner-emit-cache-warming-decision
                                                      runner (pig:obj "type" "cache_warming_decision" "warmCost" 1 "missCost" 2 "continuationProbability" 0.5d0 "action" "warm")))
                (let ((built '()))
                  (setf (gethash "boundary" emits)
                        (pig:runner-emit-boundary
                         runner (pig:obj "type" "turn_end" "turnIndex" 0 "message" (pig:obj "role" "user" "content" "x" "timestamp" 1) "toolResults" (vector)
                                         "messageEntryId" "m1" "toolResultEntryIds" (vector) "outcome" "completed")
                         (lambda (entries)
                           (push (if (vectorp entries) (length entries) 0) built)
                           (pig:obj "contextEntries" (vector) "contextMessages" (vector) "llmMessages" (vector) "pendingMessages" (vector) "canContinue" t)))
                      (gethash "boundaryBuilt" emits) (b-vec (reverse built)))))
              (pig:runner-emit-error runner (pig:obj "extensionPath" "/x/ext.mjs" "event" "manual" "error" "reported by hand"))
              (setf (gethash "emits" r) emits (gethash "errors" r) (b-vec (reverse reported)))
              (let* ((live (pig:runner-create-context runner)) (signal (pig:runner-context-signal live))
                     (contexts (pig:obj "mode" (pig:runner-context-mode live) "hasUI" (b-yes (pig:runner-context-has-ui-p live)) "cwd" (pig:runner-context-cwd live)
                                        "model" (pig:jget (pig:runner-context-model live) "id")
                                        "scopedModels" (b-vec (map 'list (lambda (e) (vector (pig:jref e "model" "id") (pig:jget e "thinkingLevel"))) (pig:runner-context-scoped-models live)))
                                        "thinkingLevel" (pig:runner-context-thinking-level live) "isIdle" (b-yes (pig:runner-context-is-idle-p live))
                                        "isProjectTrusted" (b-yes (pig:runner-context-is-project-trusted-p live))
                                        "signal" (and signal (pig:obj "aborted" (b-yes (pig::abort-signal-set-p signal))))
                                        "hasPendingMessages" (b-yes (pig:runner-context-has-pending-messages-p live))
                                        "contextUsage" (pig:runner-context-get-context-usage live) "systemPrompt" (pig:runner-context-get-system-prompt live))))
                (pig:runner-context-abort live)
                (pig:runner-context-shutdown live)
                (pig:runner-context-compact live (pig:obj "customInstructions" "short"))
                (pig:runner-shutdown runner)
                (let ((command (pig:runner-create-command-context runner)))
                  (pig:runner-bind-command-context
                   runner (list :wait-for-idle (lambda () (record "waitForIdle"))
                                :new-session (lambda (&optional options) (record "newSession" (pig:jget options "parentSession")) (pig:obj "cancelled" :false))
                                :fork (lambda (entry-id &optional options) (record "fork" entry-id (pig:jget options "position")) (pig:obj "cancelled" t))
                                :navigate-tree (lambda (target &optional options) (record "navigateTree" target (pig:jget options "label")) (pig:obj "cancelled" :false))
                                :switch-session (lambda (path &optional options) (declare (ignore options)) (record "switchSession" path) (pig:obj "cancelled" :false))
                                :reload (lambda () (record "reload"))))
                  (let ((command-report (pig:obj "systemPromptOptions" (pig:runner-context-get-system-prompt-options command))))
                    (pig:runner-context-wait-for-idle command)
                    (setf (gethash "waitForIdle" command-report) nil
                          (gethash "newSession" command-report) (pig:runner-context-new-session command (pig:obj "parentSession" "parent.jsonl"))
                          (gethash "fork" command-report) (pig:runner-context-fork command "e1" (pig:obj "position" "at"))
                          (gethash "navigateTree" command-report) (pig:runner-context-navigate-tree command "e2" (pig:obj "label" "l"))
                          (gethash "switchSession" command-report) (pig:runner-context-switch-session command "other.jsonl"))
                    (pig:runner-context-reload command)
                    (setf (gethash "reload" command-report) nil (gethash "command" contexts) command-report)))
                (let ((tool-context (pig:runner-create-tool-context runner "call-1")))
                  (setf (gethash "tool" contexts)
                        (pig:obj "tools" (b-vec (map 'list (lambda (tool) (pig:jget tool "name")) (pig:runner-context-tools tool-context)))
                                 "executeTool" (pig:runner-context-execute-tool tool-context "alpha" (pig:obj "text" "x")))))
                (setf (gethash "contexts" r) contexts))
              (let* ((ui-log '()) (ui-lock (sb-thread:make-mutex :name "ui log")))
                (flet ((note (&rest call) (sb-thread:with-mutex (ui-lock) (push (coerce call 'simple-vector) ui-log)) nil))
                  (pig:runner-set-ui-context
                   runner
                   (list :select (lambda (title options &optional opts) (declare (ignore opts)) (note "select" title options) (and (> (length options) 1) (elt options 1)))
                         :confirm (lambda (title message &optional opts) (declare (ignore opts)) (note "confirm" title message) t)
                         :input (lambda (title &optional placeholder opts) (declare (ignore opts)) (note "input" title placeholder) "typed")
                         :editor (lambda (title &optional prefill) (note "editor" title prefill) (concatenate 'string (b-or-empty prefill) "!"))
                         :notify (lambda (message &optional kind) (note "notify" message kind))
                         :set-status (lambda (key &optional text) (note "setStatus" key text))
                         :set-working-message (lambda (&optional message) (note "setWorkingMessage" message))
                         :set-working-visible (lambda (visible) (note "setWorkingVisible" visible))
                         :set-hidden-thinking-label (lambda (&optional label) (note "setHiddenThinkingLabel" label))
                         :set-widget (lambda (key content &optional options) (note "setWidget" key content (pig:jget options "placement")))
                         :set-title (lambda (title) (note "setTitle" title))
                         :paste-to-editor (lambda (text) (note "pasteToEditor" text))
                         :set-editor-text (lambda (text) (note "setEditorText" text))
                         :get-editor-text (lambda () "editor text")
                         :get-tools-expanded (lambda () t)
                         :set-tools-expanded (lambda (expanded) (note "setToolsExpanded" expanded)))
                   "tui")
                  (let* ((live-ui (pig:runner-get-ui-context runner))
                         (dialogs (pig:obj "select" (pig:runner-ui-select live-ui "Pick" (list "x" "y")) "confirm" (b-yes (pig:runner-ui-confirm live-ui "Sure?" "really"))
                                           "input" (pig:runner-ui-input live-ui "Name" "placeholder") "editor" (pig:runner-ui-editor live-ui "Edit" "pre"))))
                    (pig:runner-ui-notify live-ui "hello" "info")
                    (pig:runner-ui-set-status live-ui "k" "v")
                    (pig:runner-ui-set-working-message live-ui "working")
                    (pig:runner-ui-set-working-visible live-ui :false)
                    (pig:runner-ui-set-hidden-thinking-label live-ui "hidden")
                    (pig:runner-ui-set-widget live-ui "w" (list "line") (pig:obj "placement" "belowEditor"))
                    (pig:runner-ui-set-title live-ui "title")
                    (pig:runner-ui-paste-to-editor live-ui "pasted")
                    (pig:runner-ui-set-editor-text live-ui "set")
                    (pig:runner-ui-set-tools-expanded live-ui :false)
                    (let ((reads-ui (pig:obj "editorText" (pig:runner-ui-get-editor-text live-ui) "toolsExpanded" (b-yes (pig:runner-ui-get-tools-expanded-p live-ui)))))
                      ;; the prompt events are delivered on a later turn: wait for both of each dialog
                      (dotimes (i 100)
                        (when (>= (sb-thread:with-mutex (log-lock)
                                    (count-if (lambda (entry) (and (equal (aref entry 0) "appendEntry") (equal (aref entry 1) "a_ui"))) log))
                                  8)
                          (return))
                        (sleep 0.05))
                      (let* ((after (pig:runner-create-context runner))
                             (ui-report (pig:obj "mode" (pig:runner-context-mode after) "hasUI" (b-yes (pig:runner-has-ui-p runner))
                                                 "contextHasUI" (b-yes (pig:runner-context-has-ui-p after)) "dialogs" dialogs "reads" reads-ui
                                                 "calls" (sb-thread:with-mutex (ui-lock) (b-vec (reverse ui-log))))))
                        (pig:runner-set-ui-context runner nil "")
                        (let ((cleared (pig:runner-create-context runner)))
                          (setf (gethash "afterClear" ui-report) (pig:obj "hasUI" (b-yes (pig:runner-has-ui-p runner)) "mode" (pig:runner-context-mode cleared))))
                        (setf (gethash "ui" r) ui-report))))))
              (funcall off)
              (pig:runner-emit-error runner (pig:obj "extensionPath" "/x/ext.mjs" "event" "after-off" "error" "not delivered"))
              (setf (gethash "errors" r) (b-vec (reverse reported)))
              (pig:runner-invalidate runner "runner is stale")
              (pig:runner-invalidate runner "a second message is ignored")
              (let ((stale-context (pig:runner-create-context runner)))
                (setf (gethash "stale" r)
                      (pig:obj "cwd" (b-error-text (lambda () (pig:runner-context-cwd stale-context))) "isIdle" (b-error-text (lambda () (pig:runner-context-is-idle-p stale-context)))
                               "activeTools" (b-error-text (lambda () (pig:runner-get-active-tools runner)))
                               "commandContext" (b-error-text (lambda () (pig:runner-context-wait-for-idle (pig:runner-create-command-context runner))))
                               "toolContext" (b-error-text (lambda () (pig:runner-context-execute-tool (pig:runner-create-tool-context runner "c") "alpha" (pig:obj))))
                               "ui" (b-error-text (lambda () (pig:runner-context-ui stale-context)))
                               "emit" (b-error-text (lambda () (pig:runner-emit runner (pig:obj "type" "agent_start")))))))
              (setf (gethash "log" r) (sb-thread:with-mutex (log-lock) (b-vec (reverse log)))))))))
    r))

;;; ---------------------------------------------------------------- services

(defun b-event-label (event)
  (let ((type (pig:jget event "type")))
    (if (b-starts-with "message_" type) (format nil "~A:~A" type (pig:jref event "message" "role")) type)))

(defun b-last-text (messages)
  (let ((message (aref messages (1- (length messages)))))
    (apply #'concatenate 'string (loop for block across (pig:jget message "content") when (equal (pig:jget block "type") "text") collect (pig:jget block "text")))))

(def-script "services" (ctx args)
  (let* ((cwd (pig:jget args "cwd")) (agent-dir (pig:jget args "agentDir")) (r (pig:obj))
         (rt (pig:runtime-create ctx :auth-path (pig:jget args "mrAuth") :models-path (pig:jget args "mrModels") :models-store-path (pig:jget args "mrStore")))
         (settings (pig:settings-in-memory ctx (pig:obj "compaction" (pig:obj "enabled" :false) "retry" (pig:obj "enabled" :false) "defaultProvider" "mr-local"
                                                        "defaultModel" "m1" "defaultThinkingLevel" "high")))
         (quiet (list :no-extensions t :no-skills t :no-prompt-templates t :no-themes t :no-context-files t))
         (services (pig:create-agent-session-services
                    ctx :cwd (concatenate 'string cwd "/sub/..") :agent-dir agent-dir :settings-manager settings :model-runtime rt
                        :resource-loader-options (append quiet (list :additional-extension-paths (list (pig:jget args "servicesProbe")) :append-system-prompt (list "Services appendix")))
                        :extension-flag-values (list (cons "probe-flag" t) (cons "missing-flag" "x") (cons "probe-text" t) (cons "other" :false))))
         (loader (pig:agent-session-services-resource-loader services))
         (loaded (pig:loader-get-extensions loader)))
    (setf (gethash "services" r)
          (pig:obj "cwd" (pig:agent-session-services-cwd services) "agentDir" (pig:agent-session-services-agent-dir services)
                   "sameRuntime" (b-yes (eq (pig:agent-session-services-model-runtime services) rt))
                   "sameSettings" (b-yes (eq (pig:agent-session-services-settings-manager services) settings))
                   "diagnostics" (pig:agent-session-services-diagnostics services)
                   "extensions" (b-vec (map 'list (lambda (e) (pig:jget e "path")) (pig:jget loaded "extensions"))) "extensionErrors" (length (pig:jget loaded "errors"))
                   "appendix" (pig:loader-get-append-system-prompt loader)
                   "providers" (pig:obj "ids" (b-vec (sort (remove-if-not (lambda (id) (b-starts-with "svc-" id)) (b-list (pig:runtime-get-registered-provider-ids rt))) #'string<))
                                        "models" (b-vec (b-ids (pig:runtime-get-models rt "svc-prov"))))))
    (let ((own (pig:create-agent-session-services ctx :cwd cwd :agent-dir (pig:jget args "servicesAgentDir") :resource-loader-options quiet)))
      (setf (gethash "own" r)
            (pig:obj "cwd" (pig:agent-session-services-cwd own) "agentDir" (pig:agent-session-services-agent-dir own)
                     "diagnostics" (pig:agent-session-services-diagnostics own)
                     "models" (b-vec (b-ids (pig:runtime-get-models (pig:agent-session-services-model-runtime own) "svc-local")))
                     "defaultModel" (pig:settings-get-default-model (pig:agent-session-services-settings-manager own))
                     "project" (pig:settings-get-project-settings (pig:agent-session-services-settings-manager own))
                     "appendix" (pig:loader-get-append-system-prompt (pig:agent-session-services-resource-loader own))
                     "registered" (pig:runtime-get-registered-provider-ids (pig:agent-session-services-model-runtime own)))))
    (let ((defaulted (pig:create-agent-session-services ctx :cwd cwd :settings-manager settings :model-runtime rt :resource-loader-options quiet)))
      (setf (gethash "defaulted" r)
            (pig:obj "agentDir" (b-yes (equal (pig:agent-session-services-agent-dir defaulted) (pig::host-agent-dir))) "cwd" (pig:agent-session-services-cwd defaulted))))
    (let* ((memory (pig:sm-in-memory ctx cwd))
           (session (pig:create-agent-session-from-services
                     ctx services :session-manager memory :session-start-event (pig:make-session-start-event "fork" "/previous.jsonl")
                                  :scoped-models (list (pig:obj "model" (pig:runtime-get-model rt "mr-local" "m1") "thinkingLevel" "off"))))
           (events '()))
      (pig:agent-session-subscribe session (lambda (event) (push (b-event-label event) events)))
      (pig:agent-session-bind-extensions session)
      (let ((created (pig:obj "model" (pig:obj "provider" (pig:jget (pig:agent-session-model session) "provider") "id" (pig:jget (pig:agent-session-model session) "id"))
                              "thinkingLevel" (pig:agent-session-thinking-level session) "fallback" (pig:agent-session-model-fallback-message session)
                              "extensionErrors" (length (pig:agent-session-extension-errors session))
                              "appendix" (b-yes (search "Services appendix" (pig:agent-session-system-prompt session)))
                              "sessionId" (b-yes (equal (pig:agent-session-session-id session) (pig:sm-get-session-id memory))))))
        (pig:agent-session-prompt session "hello")
        (let ((messages (pig:agent-session-messages session)))
          (setf (gethash "session" r)
                (pig:obj "created" created "events" (b-vec (reverse events)) "roles" (b-vec (map 'list (lambda (m) (pig:jget m "role")) messages)) "text" (b-last-text messages)
                         "started" (b-vec (loop for entry across (pig:sm-get-entries memory)
                                                when (and (equal (pig:jget entry "type") "custom") (equal (pig:jget entry "customType") "probe_start")) collect (pig:jget entry "data")))))
          (pig:agent-session-dispose session))))
    r))
