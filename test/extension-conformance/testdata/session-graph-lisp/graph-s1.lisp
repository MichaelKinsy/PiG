(in-package "session-graph")
;;; child_handles, agent_session_runtime (lane S1): the scripts of session_graph_python.py.

(defun s1-error-text (fn)
  (handler-case (progn (funcall fn) "no error")
    (error (e) (format nil "error: ~A" e))))

(defun s1-blocks-text (content)
  (if (stringp content)
      content
      (format nil "~{~A~}" (loop for block across (if (vectorp content) content #())
                                 when (equal (pig:jget block "type") "text") collect (pig:jget block "text")))))

(defun s1-entry-kinds (manager)
  (vec (loop for entry across (pig:sm-get-entries manager)
             collect (if (equal (pig:jget entry "type") "message")
                         (format nil "message:~A" (pig:jref entry "message" "role"))
                         (pig:jget entry "type")))))

(defun s1-last-text (session)
  (let ((messages (pig:agent-session-messages session)))
    (s1-blocks-text (pig:jget (aref messages (1- (length messages))) "content"))))

(defun s1-event-name (event)
  (let ((type (pig:jget event "type")))
    (if (and (>= (length type) 8) (string= "message_" type :end2 8))
        (format nil "~A:~A" type (pig:jref event "message" "role"))
        type)))

(defun s1-quiet (&rest more)
  (append more (list :no-extensions t :no-skills t :no-prompt-templates t :no-themes t :no-context-files t)))

(defun s1-exists-p (path) (and path (probe-file path) t))

(defun s1-runtime (ctx args)
  (pig:runtime-create ctx :auth-path (arg args "mrAuth") :models-path (arg args "mrModels") :models-store-path (arg args "mrStore")))

(defun s1-settings (ctx &rest more)
  (pig:settings-in-memory
   ctx (apply #'pig:obj "compaction" (pig:obj "enabled" :false) "retry" (pig:obj "enabled" :false)
              "defaultProvider" "mr-local" "defaultModel" "m1" more)))

(def-script "child_handles" (ctx args)
  (let ((r (pig:obj)) (cwd (arg args "cwd")) (directory (arg args "dir")) (agent-dir (arg args "agentDir")))
    (labels ((observe (options manager settings bind)
               (let* ((session (apply #'pig:ctx-create-agent-session ctx :session-manager manager :settings-manager settings options))
                      (events '()))
                 (pig:agent-session-subscribe session (lambda (event) (push (s1-event-name event) events)))
                 (when bind (pig:agent-session-bind-extensions session))
                 (let ((created (pig:obj "model" (pig:obj "provider" (pig:jget (pig:agent-session-model session) "provider")
                                                          "id" (pig:jget (pig:agent-session-model session) "id"))
                                         "thinkingLevel" (pig:agent-session-thinking-level session)
                                         "activeTools" (pig:agent-session-active-tools session)
                                         "fallback" (pig:agent-session-model-fallback-message session)
                                         "extensionErrors" (length (pig:agent-session-extension-errors session))
                                         "appendix" (jb (search "Handle appendix" (pig:agent-session-system-prompt session)))
                                         "sessionId" (jb (equal (pig:agent-session-session-id session) (pig:sm-get-session-id manager)))
                                         "sessionFile" (jb (equal (pig:agent-session-session-file session) (pig:sm-get-session-file manager)))
                                         "persisted" (jb (pig:agent-session-session-file session)))))
                   (pig:agent-session-prompt session "hello")
                   (values session
                           (pig:obj "created" created "events" (vec (reverse events))
                                    "final" (or (pig:jget (pig:agent-session-state session) "lastAssistantText") :null)
                                    "roles" (map 'simple-vector (lambda (m) (pig:jget m "role")) (pig:agent-session-messages session))
                                    "entries" (s1-entry-kinds manager) "text" (s1-last-text session)))))))
      (multiple-value-bind (first second memory file)
          (let* ((rt (s1-runtime ctx args))
                 (settings (s1-settings ctx "defaultThinkingLevel" "high"))
                 (quiet (s1-quiet :cwd cwd :agent-dir agent-dir :settings-manager settings))
                 (loader (apply #'pig:make-resource-loader ctx :additional-extension-paths (list (arg args "probeExt"))
                                                               :append-system-prompt (list "Handle appendix") quiet))
                 (memory (progn (pig:loader-reload loader) (pig:sm-in-memory ctx cwd)))
                 (scoped (list (pig:obj "model" (pig:runtime-get-model rt "mr-local" "m1") "thinkingLevel" "off"))))
            (multiple-value-bind (first first-report)
                (observe (list :resource-loader loader :model-runtime rt :scoped-models scoped) memory settings t)
              (setf (gethash "settings" first-report)
                    (pig:obj "defaultModel" (pig:settings-get-default-model settings)
                             "compaction" (jb (pig:settings-get-compaction-enabled settings))))
              (setf (gethash "memory" r) first-report)
              (let* ((file (pig:sm-create ctx cwd directory))
                     (plain-loader (apply #'pig:make-resource-loader ctx quiet)))
                (pig:loader-reload plain-loader)
                (multiple-value-bind (second second-report)
                    (observe (list :resource-loader plain-loader :model-runtime rt) file settings nil)
                  (setf (gethash "onDisk" second-report) (jb (s1-exists-p (pig:sm-get-session-file file)))
                        (gethash "samePath" second-report) (jb (equal (pig:agent-session-session-file second) (pig:sm-get-session-file file)))
                        (gethash "file" r) second-report)
                  (values first second memory file)))))
        ;; the extension let go of every object it built; the sessions still run over them
        (dotimes (i 3) (sb-ext:gc :full t) (sleep 0.1))
        (pig:agent-session-prompt first "again")
        (setf (gethash "afterDrop" r) (pig:obj "text" (s1-last-text first) "entries" (length (pig:sm-get-entries memory))
                                               "fileEntries" (length (pig:sm-get-entries file))))
        (pig:agent-session-dispose first)
        (pig:agent-session-dispose second)))
    r))

(defun s1-copy-file (source destination)
  (with-open-file (in source :element-type '(unsigned-byte 8))
    (with-open-file (out destination :element-type '(unsigned-byte 8) :direction :output :if-exists :supersede)
      (let ((buffer (make-array 65536 :element-type '(unsigned-byte 8))))
        (loop for count = (read-sequence buffer in) while (plusp count) do (write-sequence buffer out :end count))))))

(defun s1-read-text (path)
  (with-open-file (in path :external-format :utf-8)
    (let ((text (make-string (file-length in)))) (subseq text 0 (read-sequence text in)))))

(defun s1-split-lines (text)
  (loop with start = 0 for end = (position #\Newline text :start start)
        collect (subseq text start end) while end do (setf start (1+ end))))

(def-script "agent_session_runtime" (ctx args)
  (let* ((cwd (arg args "cwd")) (agent-dir (arg args "agentDir")) (root (arg args "root")) (r (pig:obj))
         (rt (s1-runtime ctx args)) (settings (s1-settings ctx))
         (session-dir (join root "runtime-sessions"))
         (log-file (join cwd "runtime-events.log")) (cancel-file (join cwd "cancel-next"))
         (calls '()) (rebinds 0) (invalidations 0) (seen '()) runtime)
    (ensure-directories-exist (concatenate 'string cwd "/"))
    (labels ((factory (options)
               (let ((start (pig:session-runtime-options-session-start-event options)))
                 (push (pig:obj "cwd" (pig:session-runtime-options-cwd options)
                                "reason" (if start (pig:jget start "reason") :null)
                                "previous" (jb (and start (stringp (pig:jget start "previousSessionFile")) (plusp (length (pig:jget start "previousSessionFile")))))
                                "persisted" (jb (pig:sm-is-persisted (pig:session-runtime-options-session-manager options))))
                       calls)
                 (let* ((services (pig:create-agent-session-services
                                   ctx :cwd (pig:session-runtime-options-cwd options) :agent-dir (pig:session-runtime-options-agent-dir options)
                                       :settings-manager settings :model-runtime rt
                                       :resource-loader-options (s1-quiet :additional-extension-paths (list (arg args "runtimeProbe")))))
                        (session (pig:create-agent-session-from-services
                                  ctx services :session-manager (pig:session-runtime-options-session-manager options) :session-start-event start)))
                   (pig:make-session-runtime-result :session session :services services
                                                    :diagnostics (pig:agent-session-services-diagnostics services)
                                                    :model-fallback-message (pig:agent-session-model-fallback-message session)))))
             (current () (pig:agent-session-session-manager (pig:agent-session-runtime-session runtime)))
             (is-new ()
               (let* ((id (pig:sm-get-session-id (current))) (fresh (not (member id seen :test #'equal))))
                 (pushnew id seen :test #'equal)
                 fresh))
             (kinds () (s1-entry-kinds (current)))
             (roles () (map 'simple-vector (lambda (m) (pig:jget m "role")) (pig:agent-session-messages (pig:agent-session-runtime-session runtime))))
             (message-entry-p (entry role) (and (equal (pig:jget entry "type") "message") (equal (pig:jref entry "message" "role") role)))
             (user-entry (wanted)
               (find-if (lambda (entry) (and (message-entry-p entry "user") (equal (s1-blocks-text (pig:jref entry "message" "content")) wanted)))
                        (pig:sm-get-entries (current))))
             (assistant-id ()
               (pig:jget (find-if (lambda (entry) (message-entry-p entry "assistant")) (pig:sm-get-entries (current))) "id"))
             (cancelling (run)
               (with-open-file (out cancel-file :direction :output :if-exists :supersede))
               (unwind-protect (funcall run) (delete-file cancel-file)))
             (parent-is (file) (jb (equal (pig:jget (pig:sm-get-header (current)) "parentSession") file))))
      (let* ((manager (pig:sm-create ctx cwd session-dir)) (run-file (pig:sm-get-session-file manager)))
        (setf runtime (pig:create-agent-session-runtime
                       ctx #'factory (pig:make-session-runtime-options :cwd cwd :agent-dir agent-dir :session-manager manager)))
        (pig:agent-session-runtime-set-rebind-session
         runtime (lambda (session) (incf rebinds) (pig:agent-session-bind-extensions session)))
        (pig:agent-session-runtime-set-before-session-invalidate runtime (lambda () (incf invalidations)))
        (pig:agent-session-bind-extensions (pig:agent-session-runtime-session runtime))
        (push (pig:sm-get-session-id manager) seen)
        (setf (gethash "initial" r)
              (pig:obj "cwd" (pig:agent-session-runtime-cwd runtime) "diagnostics" (pig:agent-session-runtime-diagnostics runtime)
                       "fallback" (or (pig:agent-session-runtime-model-fallback-message runtime) :null)
                       "sameLog" (jb (equal (pig:sm-get-session-id (current)) (pig:sm-get-session-id manager)))
                       "servicesCwd" (pig:agent-session-services-cwd (pig:agent-session-runtime-services runtime))
                       "servicesAgentDir" (jb (equal (pig:agent-session-services-agent-dir (pig:agent-session-runtime-services runtime)) agent-dir))
                       "calls" (length calls)))
        (pig:agent-session-prompt (pig:agent-session-runtime-session runtime) "one")
        (setf (gethash "prompted" r) (pig:obj "kinds" (kinds) "persisted" (jb (s1-exists-p run-file))))
        (let ((cancelled-new (cancelling (lambda () (pig:agent-session-runtime-new-session runtime)))))
          (setf (gethash "newCancelled" r)
                (pig:obj "result" cancelled-new "sameSession" (jb (not (is-new))) "calls" (length calls) "rebinds" rebinds "invalidations" invalidations)))
        (let ((created (pig:agent-session-runtime-new-session
                        runtime :parent-session run-file
                                :setup (lambda (sm) (pig:sm-append-custom-message-entry sm "setup-note" "from setup" t)))))
          (setf (gethash "newSession" r)
                (pig:obj "result" created "fresh" (jb (is-new)) "parentIsFirst" (parent-is run-file) "kinds" (kinds) "roles" (roles)
                         "calls" (vec (cdr (reverse calls))) "rebinds" rebinds "invalidations" invalidations)))
        (pig:agent-session-prompt (pig:agent-session-runtime-session runtime) "two")
        (let* ((second-file (pig:sm-get-session-file (current))) (two-id (pig:jget (user-entry "two") "id")))
          (setf (gethash "forkCancelled" r)
                (pig:obj "result" (cancelling (lambda () (pig:agent-session-runtime-fork runtime two-id))) "sameSession" (jb (not (is-new)))))
          (let ((forked (pig:agent-session-runtime-fork runtime two-id)))
            (setf (gethash "fork" r)
                  (pig:obj "result" forked "fresh" (jb (is-new)) "parentIsNotSecond" (jb (not (equal (pig:sm-get-session-file (current)) second-file)))
                           "roles" (roles) "kinds" (kinds) "calls" (- (length calls) 2)))))
        (pig:agent-session-prompt (pig:agent-session-runtime-session runtime) "three")
        (let ((forked-at (pig:agent-session-runtime-fork runtime (assistant-id) :position "at")))
          (setf (gethash "forkAt" r) (pig:obj "result" forked-at "fresh" (jb (is-new)) "roles" (roles))))
        (setf (gethash "forkErrors" r)
              (pig:obj "missing" (s1-error-text (lambda () (pig:agent-session-runtime-fork runtime "no-such-entry")))
                       "notUser" (s1-error-text (lambda () (pig:agent-session-runtime-fork runtime (assistant-id))))))
        (setf (gethash "switchCancelled" r)
              (pig:obj "result" (cancelling (lambda () (pig:agent-session-runtime-switch-session runtime run-file))) "sameSession" (jb (not (is-new)))))
        (let ((switched (pig:agent-session-runtime-switch-session runtime run-file)))
          (setf (gethash "switch" r)
                (pig:obj "result" switched "backOnFirst" (jb (equal (pig:sm-get-session-id (current)) (pig:sm-get-session-id manager)))
                         "file" (jb (equal (basename (pig:sm-get-session-file (current))) (basename run-file))) "roles" (roles))))
        (let ((emptied (pig:agent-session-runtime-fork runtime (pig:jget (user-entry "one") "id"))))
          (setf (gethash "forkRoot" r) (pig:obj "result" emptied "fresh" (jb (is-new)) "parentIsFirst" (parent-is run-file) "kinds" (kinds))))
        (let* ((import-dir (join root "import")) (import-path (join import-dir "imported.jsonl")))
          (ensure-directories-exist (concatenate 'string import-dir "/"))
          (s1-copy-file run-file import-path)
          (let* ((imported (pig:agent-session-runtime-import-from-jsonl runtime import-path))
                 (imported-file (pig:sm-get-session-file (current))))
            (setf (gethash "import" r)
                  (pig:obj "result" imported "fresh" (jb (is-new)) "inSessionDir" (jb (eql 0 (search session-dir imported-file)))
                           "name" (basename imported-file) "roles" (roles) "sourceKept" (jb (s1-exists-p import-path))
                           "missing" (s1-error-text (lambda () (pig:agent-session-runtime-import-from-jsonl runtime (join import-dir "missing.jsonl"))))))))
        (pig:agent-session-runtime-dispose runtime)
        (setf (gethash "counts" r)
              (pig:obj "rebinds" rebinds "invalidations" invalidations "factoryCalls" (length calls)
                       "reasons" (vec (loop for call in (reverse calls)
                                            collect (format nil "~A~A" (let ((reason (pig:jget call "reason"))) (if (eq reason :null) "null" reason))
                                                            (if (eq (pig:jget call "previous") t) "+previous" ""))))))
        (setf (gethash "events" r) (vec (s1-split-lines (string-right-trim '(#\Newline) (s1-read-text log-file)))))
        r))))
