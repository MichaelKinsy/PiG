;;;; The extension_runner_signal script of the session graph rows: the two sequences of testdata/extension-runner-signal.mjs through the Lisp SDK's runner. :get-signal answers the signal of the client's current run (Pi: one AbortController per run, agent.ts:518-527).
(in-package "session-graph")

(defun signal-rig (ctx args current)
  "A runner over the signal probe with appendEntry logged and :get-signal answering what the function CURRENT returns. Returns (values runner report-function)."
  (let* ((cwd (pig:jget args "cwd")) (agent-dir (pig:jget args "agentDir"))
         (rt (pig:runtime-create ctx :auth-path (pig:jget args "mrAuth") :models-path (pig:jget args "mrModels") :models-store-path (pig:jget args "mrStore")))
         (settings (b-settings ctx "mr-local" "m1"))
         (loader (b-quiet-loader ctx cwd agent-dir settings :runtime (pig:create-extension-runtime ctx) :additional-extension-paths (list (pig:jget args "signalProbe"))))
         (entries '()) (errors '()) (lock (sb-thread:make-mutex :name "signal log")))
    (pig:loader-reload loader)
    (let* ((loaded (pig:loader-get-extensions loader)) (extensions (pig:jget loaded "extensions"))
           (runner (pig:make-extension-runner ctx extensions :runtime (pig:loaded-extensions-runtime ctx loaded) :cwd cwd :session-manager (pig:sm-in-memory ctx cwd) :model-registry rt)))
      (pig:runner-bind-core runner
                            (list :append-entry (lambda (custom-type &optional data) (sb-thread:with-mutex (lock) (push (vector custom-type data) entries)) nil))
                            (list :get-signal current))
      (pig:runner-on-error runner (lambda (report)
                                    (sb-thread:with-mutex (lock) (push (pig:obj "event" (pig:jget report "event") "error" (pig:jget report "error")) errors))))
      (values runner
              (lambda ()
                (sb-thread:with-mutex (lock)
                  (pig:obj "entries" (b-vec (reverse entries)) "errors" (b-vec (reverse errors)) "loadErrors" (pig:jget loaded "errors"))))))))

(def-script "extension_runner_signal" (ctx args)
  (let ((current nil)
        (turn (pig:obj "type" "turn_start" "turnIndex" 0 "timestamp" 1))
        (message (pig:obj "type" "message_start" "message" (pig:obj "role" "user" "content" "hi" "timestamp" 1)))
        (r (pig:obj)))
    ;; Sequence 1, two live runs.
    (setf current (pig::make-abort-signal))
    (multiple-value-bind (runner report) (signal-rig ctx args (lambda () current))
      (pig:runner-emit runner (pig:obj "type" "agent_start"))
      (let ((second (pig::make-abort-signal)))
        (setf current second)
        (pig:runner-emit runner turn)
        (pig::signal-abort second)
        (pig:runner-emit runner message))
      (setf (gethash "twoLiveRuns" r) (funcall report)))
    ;; Sequence 2, the own abort missed.
    (let ((first (pig::make-abort-signal)))
      (setf current first)
      (multiple-value-bind (runner report) (signal-rig ctx args (lambda () current))
        (pig:runner-emit runner (pig:obj "type" "agent_start"))
        (pig::signal-abort first)
        (let ((next (pig::make-abort-signal)))
          (setf current next)
          ;; The client drops its own reference to run 1's aborted signal and collects before run 2 is read: the wrapper must hold the signal itself, or it cannot say run 1 had aborted.
          (setf first nil)
          (sb-ext:gc :full t)
          (pig:runner-emit runner turn)
          (pig::signal-abort next)
          (pig:runner-emit runner message))
        (setf (gethash "abortedThenLive" r) (funcall report))))
    r))
