{
  "radius-dev": {
    "type": "oauth",
    "access": "fixture-access",
    "refresh": "fixture-refresh",
    "expires": 4102444800000,
    "gatewayConfig": {
      "baseUrl": "http://127.0.0.1:1/v1",
      "models": [
        {
          "id": "auto",
          "name": "Radius Metadata",
          "reasoning": false,
          "input": ["text", "image"],
          "inputLimits": {
            "maxRequestBytes": 4096,
            "images": {"resize": {"maxWidth": 800}}
          },
          "cost": {
            "input": 1,
            "output": 2,
            "cacheRead": 0.1,
            "cacheWrite": 0.2,
            "tiers": [
              {"inputTokensAbove": 1000, "input": 3, "output": 4, "cacheRead": 0.3, "cacheWrite": 0.4}
            ]
          },
          "promptCache": {"short": 120},
          "contextWindow": 128000,
          "maxTokens": 16384,
          "samplingParams": {"top_p": 0.75},
          "headers": {"X-Catalog": "catalog"},
          "compat": {"supportsStrictMode": false}
        }
      ]
    }
  }
}
