{"type":"message","id":"2fbb2f6d","parentId":"8f532e27","timestamp":"2025-01-01T00:00:02.000Z","message":{"role":"assistant","content":[{"type":"text","text":"Go is a statically typed, compiled programming language designed at Google. Key features include goroutines for concurrency, channels for communication, garbage collection, and a simple type system with interfaces."}],"usage":{"input":100,"output":80,"cacheRead":0,"cacheWrite":0,"totalTokens":180,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"stop"}}
