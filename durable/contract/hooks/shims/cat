#!/bin/bash
# cat with its diagnostics written in one piece (CONTRACT section 7.2, determinism). GNU cat writes "cat: ", the file name, ": " and the
# reason as separate write(2) calls to an unbuffered stderr, so a reader of the pipe sees a different split of the same message from run
# to run (Pi's bash tool commits whatever has arrived at each progress flush). The reference and the candidate both run this one.
exec 3>&1
err=$( { (exec -a cat /bin/cat "$@") 2>&1 1>&3; } )
status=$?
[ -n "$err" ] && printf '%s\n' "$err" >&2
exit $status
