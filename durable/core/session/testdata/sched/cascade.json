  "spawner": {
   "name": "t.spawner",
   "version": 1,
   "phases": {
    "start": [
     {
      "commit": {
       "ops": [
        {
         "op": "task",
         "task": "bg",
         "background": true,
         "conversationId": 2
        },
        {
         "op": "ownedConversation"
        },
        {
         "op": "childTask",
         "task": "slow"
        }
       ],
       "next": {
        "status": "waiting",
        "checkpoint": {
         "phase": "done"
        },
        "on": [
         "$c1"
        ],
        "policy": "allSettled"
       }
      }
     }
    ],
    "done": [
     {
      "commit": {
       "next": {
        "status": "terminal",
        "outcome": {
         "status": "completed"
        }
       }
      }
     }
    ]
   },
   "abort": [
    {
     "commit": {
      "next": {
       "status": "terminal",
       "outcome": {
        "status": "aborted",
        "reason": "handler"
       }
      }
     }
    }
   ]
  },
  "sub": {
