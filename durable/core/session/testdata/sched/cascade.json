{
 "tasks": {
  "ff": {
   "name": "t.ff",
   "version": 1,
   "phases": {
    "start": [
     {
      "commit": {
       "ops": [
        {
         "op": "childTask",
         "task": "slow"
        },
        {
         "op": "childTask",
         "task": "slow2"
        },
        {
         "op": "childTask",
         "task": "boom"
        }
       ],
       "next": {
        "status": "waiting",
        "checkpoint": {
         "phase": "join"
        },
        "on": [
         "$c0",
         "$c1",
         "$c2"
        ],
        "policy": "failFast"
       }
      }
     }
    ],
    "join": [
     {
      "commit": {
       "next": {
        "status": "terminal",
        "outcome": {
         "status": "completed",
         "result": "joined"
        }
       }
      }
     }
    ]
   },
   "abort": [
    {
     "commit": {
      "next": {
       "status": "terminal",
       "outcome": {
        "status": "aborted",
        "reason": "handler"
       }
      }
     }
    }
   ]
  },
  "slow": {
   "name": "t.slow",
   "version": 1,
   "phases": {
    "start": [
     {
      "await": "g1"
     },
     {
      "commit": {
       "next": {
        "status": "terminal",
        "outcome": {
         "status": "completed"
        }
       }
      }
     }
    ]
   },
   "abort": [
    {
     "commit": {
      "next": {
       "status": "terminal",
       "outcome": {
        "status": "aborted",
        "reason": "handler"
       }
      }
     }
    }
   ]
  },
