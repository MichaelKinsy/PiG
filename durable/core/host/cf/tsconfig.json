{
  "compilerOptions": {
    "target": "ES2024", "module": "ESNext", "moduleResolution": "Bundler", "strict": true, "noEmit": true,
    "allowImportingTsExtensions": true, "verbatimModuleSyntax": true, "erasableSyntaxOnly": true, "resolveJsonModule": true,
    "skipLibCheck": true, "noUncheckedIndexedAccess": true, "types": ["node", "@cloudflare/workers-types"], "lib": ["ES2024"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "tools/**/*.ts"]
}
