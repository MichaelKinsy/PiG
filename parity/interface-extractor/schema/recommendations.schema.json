{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/MichaelKinsy/PiG/main/parity/interface-extractor/schema/recommendations.schema.json",
  "title": "Non-authoritative Pig porting recommendations",
  "type": "object",
  "additionalProperties": false,
  "required": ["upstreamVersion", "generatedBy", "recommendations"],
  "properties": {
    "upstreamVersion": { "type": "string" },
    "generatedBy": { "type": "string" },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "upstreamShapeHash", "recommendedDisposition", "confidence", "basis", "alternatives", "pigCandidates", "missingClosure", "provenance"],
        "properties": {
          "id": { "type": "string" },
          "upstreamShapeHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "recommendedDisposition": { "enum": ["partial", "deferred", "designed-out", "divergence", "pending"] },
          "confidence": { "enum": ["low", "medium", "high"] },
          "basis": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "alternatives": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["ported", "partial", "deferred", "designed-out", "divergence", "pending"] } },
          "pigCandidates": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "missingClosure": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["pig-cli-shape", "pig-go-shape", "candidate-disambiguation", "shape-translation-review", "production-reachability", "required-layers", "behavioral-evidence", "async-contract", "wire-shape", "host-dispatch", "sdk-go", "sdk-rust", "sdk-python", "isolated-conformance", "packed-conformance"] } },
          "provenance": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
